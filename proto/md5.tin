package proto

// MD5 (RFC 1321), needed because PostgreSQL's md5 authentication uses it and no Tin
// standard-library package provides a digest with MD5's 32-bit little-endian layout.

// md5Shifts are the per-operation left-rotation amounts of RFC 1321 section 3.4.
let md5Shifts = [64]i64{7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21}

// md5Table is floor(abs(sin(i+1)) * 2^32), the RFC 1321 constant table.
let md5Table = [64]u32{0xd76aa478, 0xe8c7b756, 0x242070db, 0xc1bdceee, 0xf57c0faf, 0x4787c62a, 0xa8304613, 0xfd469501, 0x698098d8, 0x8b44f7af, 0xffff5bb1, 0x895cd7be, 0x6b901122, 0xfd987193, 0xa679438e, 0x49b40821, 0xf61e2562, 0xc040b340, 0x265e5a51, 0xe9b6c7aa, 0xd62f105d, 0x02441453, 0xd8a1e681, 0xe7d3fbc8, 0x21e1cde6, 0xc33707d6, 0xf4d50d87, 0x455a14ed, 0xa9e3e905, 0xfcefa3f8, 0x676f02d9, 0x8d2a4c8a, 0xfffa3942, 0x8771f681, 0x6d9d6122, 0xfde5380c, 0xa4beea44, 0x4bdecfa9, 0xf6bb4b60, 0xbebfbc70, 0x289b7ec6, 0xeaa127fa, 0xd4ef3085, 0x04881d05, 0xd9d4d039, 0xe6db99e5, 0x1fa27cf8, 0xc4ac5665, 0xf4292244, 0x432aff97, 0xab9423a7, 0xfc93a039, 0x655b59c3, 0x8f0ccc92, 0xffeff47d, 0x85845dd1, 0x6fa87e4f, 0xfe2ce6e0, 0xa3014314, 0x4e0811a1, 0xf7537e82, 0xbd3af235, 0x2ad7d2bb, 0xeb86d391}

@wrap fn md5_f(x u32, y u32, z u32) u32 { return (x & y) | (~x & z) }
@wrap fn md5_g(x u32, y u32, z u32) u32 { return (x & z) | (y & ~z) }
@wrap fn md5_h(x u32, y u32, z u32) u32 { return x ^ y ^ z }
@wrap fn md5_i(x u32, y u32, z u32) u32 { return y ^ (x | ~z) }

// md5_rotl rotates a 32-bit word left; n is never 0 or 32 in MD5.
@wrap fn md5_rotl(x u32, n i64) u32 { return (x << n) | (x >> (32 - n)) }

@wrap fn md5_block(state mut [4]u32, block []u8) {
	mut m = make([]u32, 16)
	for i in 0..16 {
		m[i] = u32(u64(block[i*4]) | u64(block[i*4+1]) << 8 | u64(block[i*4+2]) << 16 | u64(block[i*4+3]) << 24)
	}
	mut a = state[0]
	mut b = state[1]
	mut c = state[2]
	mut d = state[3]
	for i in 0..64 {
		mut f = u32(0)
		mut g = i64(0)
		if i < 16 {
			f = md5_f(b, c, d)
			g = i
		} else if i < 32 {
			f = md5_g(b, c, d)
			g = (5*i + 1) % 16
		} else if i < 48 {
			f = md5_h(b, c, d)
			g = (3*i + 5) % 16
		} else {
			f = md5_i(b, c, d)
			g = (7*i) % 16
		}
		let saved = d
		d = c
		c = b
		b = b +% md5_rotl(a +% f +% md5Table[i] +% m[g], md5Shifts[i])
		a = saved
	}
	state[0] = state[0] +% a
	state[1] = state[1] +% b
	state[2] = state[2] +% c
	state[3] = state[3] +% d
}

// Md5 returns the 16-byte MD5 digest of data.
fn Md5(data []u8) []u8 {
	mut state = [4]u32{0x67452301, 0xefcdab89, 0x98badcfe, 0x10325476}
	let length = len(data)
	mut padded = make([]u8, 0, length + 72)
	padded = append(padded, data...)
	padded = append(padded, 0x80)
	for len(padded) % 64 != 56 { padded = append(padded, 0) }
	let bits = u64(length) * 8
	for i in 0..8 { padded = append(padded, u8(bits >> (i*8))) }
	mut at = i64(0)
	for at < len(padded) {
		md5_block(mut state, padded[at:at+64])
		at += 64
	}
	mut out = make([]u8, 0, 16)
	for i in 0..4 { for j in 0..4 { out = append(out, u8(state[i] >> (j*8))) } }
	return out
}

// Md5Hex returns the lowercase hex form of Md5(data), the form PostgreSQL's md5
// authentication concatenates with the salt before hashing again.
fn Md5Hex(data []u8) str {
	return hex_text(Md5(data))
}

// hex_text renders bytes as lowercase hex.
fn hex_text(b []u8) str {
	let digits = "0123456789abcdef"
	mut out = make([]u8, 0, len(b)*2)
	for x in b {
		out = append(out, digits[i64(x) >> 4])
		out = append(out, digits[i64(x) & 15])
	}
	return str(out)
}
