// Package proto implements the PostgreSQL v3 server wire protocol: framing, startup and
// TLS negotiation, authentication, the simple and extended query protocols, the COPY
// sub-protocol, cancel requests and error/notice messages. It knows nothing about SQL.
package proto

import "fault"
import "say"
import "mint"
import "seal"
import "tide"
import "tls"
import "../types"
import "twine"
import "wire"

const maxMessage = 16777216
const maxStartupPacket = 10000
const protocol30 = 196608
const protocol32 = 196610
const sslRequest = 80877103
const cancelRequest = 80877102
const gssRequest = 80877104

// Config controls startup negotiation and authentication.
type Config struct {
	User str
	Database str
	Auth str // trust, password (cleartext), md5, scram-sha-256
	Password str
	MaxConnections i64 // 0 selects the server default
	Hba []HbaLine // rule list; when non-empty it decides the method, not Auth
	TlsCert str // PEM certificate chain; empty disables TLS
	TlsKey str // PEM private key
	PeerAddress str // the client address used for pg_hba matching
	ServerVersion str
	Pid u32 // BackendKeyData pid to use; 0 picks one at random
}

// Startup contains the negotiated protocol and startup parameters.
type Startup struct {
	Version i64
	User str
	Database str
	Parameters map[str]str
}

// Message is a frontend protocol message.
type Message enum {
	Query(sql str)
	Parse(name str, sql str, paramOids []u32)
	Bind(portal str, statement str, paramFormats []i16, params [][]u8, resultFormats []i16)
	Describe(kind u8, name str)
	Execute(portal str, maxRows i64)
	Close(kind u8, name str)
	Sync
	Flush
	Terminate
	CopyData(data []u8)
	CopyDone
	CopyFail(message str)
	Password(data str)
	Unknown(kind u8)
}

// ErrorFields carries fields encoded in ErrorResponse and NoticeResponse.
type ErrorFields struct {
	Severity str
	Code str
	Message str
	Detail str
	Hint str
	Position i32
	Where str
	File str
	Line str
	Routine str
}

// Column describes a field in RowDescription.
type Column struct {
	Name str
	TableOid u32
	Attribute i16
	TypeOid u32
	TypeSize i16
	TypeMod i32
	Format i16
}

// Cell is one DataRow value: NULL, text in Value, or binary in Bytes when Binary is set.
type Cell struct {
	Null bool
	Value str
	Binary bool
	Bytes []u8
}

type Cursor struct { at i64 }

// Accepted is the outcome of a startup negotiation: a ready connection, a cancel request
// (which the server routes to the session named by pid and key), or nothing.
type Accepted enum {
	Ready(Conn)
	Canceled(pid u32, secretKey u32)
}

// stream is the byte transport of one connection: plain TCP or TLS over it. The write
// methods return the byte count because a Tin shape member with a fault-only result is
// only accepted as the last member of the shape (see BUGS.md).
shape stream {
	mut Read(buf mut []u8, max i64) !i64
	mut ReadFull(n i64) !str
	mut Write(s str) !i64
	mut WriteBytes(b []u8) !i64
	mut SetTimeout(ns i64)
	mut Close()
}

type plainStream struct { conn wire.Conn }

fn (s mut plainStream) Read(buf mut []u8, max i64) !i64 { return try s.conn.Read(mut buf, max) }
fn (s mut plainStream) ReadFull(n i64) !str { return try s.conn.ReadFull(n) }
fn (s mut plainStream) Write(text str) !i64 { try s.conn.Write(text)
	return i64(len(text)) }
fn (s mut plainStream) WriteBytes(b []u8) !i64 { try s.conn.WriteBytes(b)
	return i64(len(b)) }
fn (s mut plainStream) SetTimeout(ns i64) { s.conn.SetTimeout(ns) }
fn (s mut plainStream) Close() { s.conn.Close() }

type tlsStream struct { conn tls.Conn }

fn (s mut tlsStream) Read(buf mut []u8, max i64) !i64 { return try s.conn.Read(mut buf, max) }
fn (s mut tlsStream) ReadFull(n i64) !str { return try s.conn.ReadFull(n) }
fn (s mut tlsStream) Write(text str) !i64 { try s.conn.Write(text)
	return i64(len(text)) }
fn (s mut tlsStream) WriteBytes(b []u8) !i64 { try s.conn.WriteBytes(b)
	return i64(len(b)) }
fn (s mut tlsStream) SetTimeout(ns i64) { s.conn.SetTimeout(ns) }
fn (s mut tlsStream) Close() { s.conn.Close() }

// ErrIdle marks a read that timed out with no message in progress: the session loop may
// keep the connection and retry, which is how idle timeouts and shutdown wake-up work.
let ErrIdle = fault("connection idle: no message in progress")

// IsIdle reports whether a read timed out with no message in progress.
fn IsIdle(err fault) bool {
	return fault.Is(err, ErrIdle)
}

// Conn is an authenticated PostgreSQL frontend connection.
type Conn struct {
	sock dyn stream
	startup Startup
	pid u32
	secretKey u32
	closed bool
	secure bool
	out []u8
	in []u8
	messageTimeout i64
}

// IsProtocolError reports whether a fault is a frontend protocol violation, which the
// server answers with 08P01 and a closed connection, as PostgreSQL does.
fn IsProtocolError(err fault) bool {
	return twine.HasPrefix(fault.Message(err), "proto:")
}

fn be(b []u8, at i64, n i64) i64 {
	mut v = i64(0)
	for i in 0..n { v = (v << 8) | i64(b[at+i]) }
	return v
}

// be32 reads a signed big-endian 32-bit length.
fn be32(b []u8, at i64) i64 {
	mut v = i64(0)
	for i in 0..4 { v = (v << 8) | i64(b[at+i]) }
	if v >= 2147483648 { v -= 4294967296 }
	return v
}

fn putbe(b mut []u8, v i64, n i64) {
	for i in 0..n { b = append(b, u8(v >> ((n-i-1)*8))) }
}

fn cstr(b mut []u8, s str) {
	for i in 0..len(s) { b = append(b, u8(s[i])) }
	b = append(b, 0)
}

fn error_field(b mut []u8, tag u8, value str) {
	b = append(b, tag)
	cstr(mut b, value)
}

fn readc(b []u8, k mut Cursor) !str {
	let start = k.at
	for k.at < len(b) && b[k.at] != 0 { k.at += 1 }
	if k.at == len(b) { fail "proto: unterminated string" }
	let s = str(b[start:k.at])
	k.at += 1
	return s
}

fn packet(kind u8, payload []u8) []u8 {
	mut out = []u8{}
	if kind != 0 { out = append(out, kind) }
	putbe(mut out, len(payload)+4, 4)
	out = append(out, payload...)
	return out
}

// EncodeFrame encodes one frontend typed message or an untyped startup message when kind is 0.
fn EncodeFrame(kind u8, payload []u8) []u8 {
	return packet(kind, payload)
}

fn begin_frame(out mut []u8, kind u8) i64 {
	let start = len(out)
	out = append(out, kind, 0, 0, 0, 0)
	return start
}

fn end_frame(out mut []u8, start i64) {
	let n = len(out) - start - 1
	out[start+1] = u8(n >> 24)
	out[start+2] = u8(n >> 16)
	out[start+3] = u8(n >> 8)
	out[start+4] = u8(n)
}

fn (c mut Conn) send(kind u8, payload []u8) ! {
	let start = begin_frame(mut c.out, kind)
	c.out = append(c.out, payload...)
	end_frame(mut c.out, start)
}

fn (c mut Conn) flush() ! {
	if len(c.out) == 0 { return }
	_ = try c.sock.WriteBytes(c.out)
	c.out = c.out[:0]
}

fn (c mut Conn) auth_message(code i64, body []u8) ! {
	let start = begin_frame(mut c.out, 'R')
	putbe(mut c.out, code, 4)
	c.out = append(c.out, body...)
	end_frame(mut c.out, start)
	try c.flush()
}

fn (c mut Conn) auth_ok() ! {
	try c.auth_message(0, []u8{})
}

// SendParameter sends one ParameterStatus message; buffered until ReadyForQuery.
fn (c mut Conn) SendParameter(name str, value str) ! {
	try c.send('S', cstr_payload(name, value))
}

fn cstr_payload(a str, b str) []u8 {
	mut out = []u8{}
	cstr(mut out, a)
	cstr(mut out, b)
	return out
}

fn (c mut Conn) ready(status u8) ! {
	let start = begin_frame(mut c.out, 'Z')
	c.out = append(c.out, status)
	end_frame(mut c.out, start)
	try c.flush()
}

fn (c mut Conn) error(fields ErrorFields) ! {
	try c.send_error_fields(fields)
}

fn (c mut Conn) send_error_fields(fields ErrorFields) ! {
	let start = begin_frame(mut c.out, 'E')
	mut severity = fields.Severity
	if severity == "" { severity = "ERROR" }
	error_field(mut c.out, 'S', severity)
	error_field(mut c.out, 'V', severity)
	error_field(mut c.out, 'C', fields.Code)
	error_field(mut c.out, 'M', fields.Message)
	if fields.Detail != "" { error_field(mut c.out, 'D', fields.Detail) }
	if fields.Hint != "" { error_field(mut c.out, 'H', fields.Hint) }
	if fields.Position > 0 { error_field(mut c.out, 'P', mint.Itoa(i64(fields.Position))) }
	if fields.Where != "" { error_field(mut c.out, 'W', fields.Where) }
	if fields.File != "" { error_field(mut c.out, 'F', fields.File) }
	if fields.Line != "" { error_field(mut c.out, 'L', fields.Line) }
	if fields.Routine != "" { error_field(mut c.out, 'R', fields.Routine) }
	c.out = append(c.out, 0)
	end_frame(mut c.out, start)
}

fn bad_request(c mut Conn, code str, message str) ! {
	try c.send_error_fields(ErrorFields{Severity: "FATAL", Code: code, Message: message})
	try c.flush()
}

fn startup_packet(sock mut dyn stream) !(i64, []u8) {
	let head = try sock.ReadFull(4)
	let hb = []u8(head)
	let n = be(hb, 0, 4)
	if n < 8 || n > maxStartupPacket { fail "proto: invalid startup packet length" }
	let raw = try sock.ReadFull(n-4)
	let body = []u8(raw)
	if len(body) < 4 { fail "proto: truncated startup packet" }
	return be(body, 0, 4), body[4:]
}

fn parse_startup(version i64, body []u8) !Startup {
	if version != protocol30 && version != protocol32 {
		fail "proto: unsupported protocol version {version}"
	}
	let params = make(map[str]str)
	mut k = Cursor{at: 0}
	for k.at < len(body) && body[k.at] != 0 {
		let key = try readc(body, mut k)
		let value = try readc(body, mut k)
		if key == "" { fail "proto: empty startup parameter name" }
		params[key] = value
	}
	if k.at >= len(body) || body[k.at] != 0 { fail "proto: unterminated startup parameters" }
	k.at += 1
	if k.at != len(body) { fail "proto: trailing startup packet data" }
	let user = params["user"]
	if user == "" { fail "proto: startup packet has no user" }
	return Startup{Version: version, User: user, Database: params["database"], Parameters: params}
}

// ParseStartup decodes startup protocol fields while retaining unknown options.
fn ParseStartup(version i64, body []u8) !Startup {
	return try parse_startup(version, body)
}

// protocol_minor is the minor version a 3.x startup request carries.
fn protocol_minor(version i64) i64 {
	return version & 0xffff
}

// unsupported_startup_options lists the `_pq_.` options tingres does not implement; they
// are reported back in NegotiateProtocolVersion, as PostgreSQL does for its own.
fn unsupported_startup_options(params map[str]str) []str {
	let known = map[str]bool{"_pq_.protocol_version": true}
	mut out = []str{}
	for key, _ in params {
		if !twine.HasPrefix(key, "_pq_.") { continue }
		if known[key] { continue }
		out = append(out, key)
	}
	return out
}

fn (c mut Conn) send_negotiate(newestMinor i64, options []str) ! {
	let start = begin_frame(mut c.out, 'v')
	putbe(mut c.out, newestMinor, 4)
	putbe(mut c.out, len(options), 4)
	for option in options { cstr(mut c.out, option) }
	end_frame(mut c.out, start)
	try c.flush()
}

fn scram_attrs(s str) !map[u8]str {
	let attrs = make(map[u8]str)
	mut at = i64(0)
	for at < len(s) {
		if at+2 > len(s) || s[at+1] != '=' { fail "proto: malformed SCRAM attribute" }
		let key = u8(s[at])
		if key == 'm' { fail "proto: unsupported mandatory SCRAM extension" }
		let start = at+2
		mut end = start
		for end < len(s) && s[end] != ',' { end += 1 }
		let (_, repeated) = attrs[key]
		if repeated { fail "proto: repeated SCRAM attribute" }
		attrs[key] = s[start:end]
		at = end+1
	}
	return attrs
}

fn (c mut Conn) scram(password str) ! {
	mut offered = []u8{}
	for i in 0..len("SCRAM-SHA-256") { offered = append(offered, u8("SCRAM-SHA-256"[i])) }
	offered = append(offered, 0, 0)
	try c.auth_message(10, offered)
	let first = try c.read_frontend()
	match first {
		Password(data) => {
			let bytes = []u8(data)
			mut k = Cursor{at: 0}
			let mech = try readc(bytes, mut k)
			if mech != "SCRAM-SHA-256" || k.at+4 > len(bytes) { fail "proto: invalid SCRAM initial response" }
			let n = be(bytes, k.at, 4)
			k.at += 4
			if n < 0 || n > 8192 || k.at+n != len(bytes) { fail "proto: invalid SCRAM response length" }
			let clientFirst = str(bytes[k.at:k.at+n])
			if len(clientFirst) < 3 || clientFirst[:3] != "n,," { fail "proto: SCRAM channel binding mode not supported" }
			let bare = clientFirst[3:]
			let a = try scram_attrs(bare)
			if a['r'] == "" { fail "proto: SCRAM nonce is required" }
			let nonce = a['r']
			for i in 0..len(nonce) { if nonce[i] < 33 || nonce[i] > 126 || nonce[i] == ',' { fail "proto: invalid SCRAM nonce" } }
			let salt = seal.RandomBytes(16)
			let serverNonce = nonce + seal.B64(seal.RandomBytes(18))
			let iterationCount = 4096
			let serverFirst = "r={serverNonce},s={seal.B64(salt)},i={iterationCount}"
			let sf = []u8(serverFirst)
			try c.auth_message(11, sf)
			let second = try c.read_frontend()
			match second {
				Password(response) => {
					let attrs2 = try scram_attrs(response)
					if attrs2['r'] != serverNonce || attrs2['c'] != "biws" || attrs2['p'] == "" { fail "proto: invalid SCRAM client-final message" }
					say.Line("SCRAM: got response: {response}")
					let proof = try seal.B64Decode(attrs2['p'])
					if len(proof) != 32 { fail "proto: invalid SCRAM proof length" }
					let finalNoProof = "c=biws,r={serverNonce}"
					let authMessage = "{bare},{serverFirst},{finalNoProof}"
					let salted = try seal.Pbkdf2Sha256(password, str(salt), iterationCount, 32)
					let clientKey = seal.HmacSha256(str(salted), "Client Key")
					let storedKey = seal.Sha256(str(clientKey))
					let clientSignature = seal.HmacSha256(str(storedKey), authMessage)
					mut recovered = make([]u8, 32)
					for i in 0..32 { recovered[i] = proof[i]^clientSignature[i] }
					say.Line("SCRAM: checking proof")
					if !seal.ConstantTimeEq(seal.Sha256(str(recovered)), storedKey) {
						say.Line("SCRAM: PROOF MISMATCH!")
						fail "proto: SCRAM authentication failed"
					}
					say.Line("SCRAM: PROOF MATCHED!")
					let serverKey = seal.HmacSha256(str(salted), "Server Key")
					let signature = seal.HmacSha256(str(serverKey), authMessage)
					let sf2 = []u8("v={seal.B64(signature)}")
					try c.auth_message(12, sf2)
				}
				_ => { fail "proto: expected SCRAM response" }
			}
		}
		_ => { fail "proto: expected SASL initial response" }
	}
}

// (c mut Conn) cleartext asks for a plain password and compares it in constant time.
fn (c mut Conn) cleartext(password str) ! {
	try c.auth_message(3, []u8{})
	let response = try c.read_frontend()
	match response {
		Password(data) => {
			mut text = data
			if len(text) > 0 && text[len(text)-1] == 0 { text = text[:len(text)-1] }
			if !seal.ConstantTimeEq([]u8(text), []u8(password)) { fail "proto: password authentication failed" }
		}
		_ => { fail "proto: expected a password message" }
	}
}

// (c mut Conn) md5 asks for the PostgreSQL md5 challenge: md5(md5(password+user) + salt).
fn (c mut Conn) md5(password str, user str) ! {
	let salt = seal.RandomBytes(4)
	let body = []u8{}
	let start = begin_frame(mut c.out, 'R')
	putbe(mut c.out, 5, 4)
	c.out = append(c.out, salt...)
	end_frame(mut c.out, start)
	try c.flush()
	let response = try c.read_frontend()
	match response {
		Password(data) => {
			mut text = data
			if len(text) > 0 && text[len(text)-1] == 0 { text = text[:len(text)-1] }
			let inner = Md5Hex(pad2([]u8(password), []u8(user)))
			mut salted = []u8(inner)
			salted = append(salted, salt...)
			let expected = "md5" + Md5Hex(salted)
			if !seal.ConstantTimeEq([]u8(text), []u8(expected)) { fail "proto: password authentication failed" }
		}
		_ => { fail "proto: expected a password message" }
	}
}

// pad2 concatenates two byte slices.
fn pad2(a []u8, b []u8) []u8 {
	mut out = make([]u8, 0, len(a)+len(b))
	out = append(out, a...)
	out = append(out, b...)
	return out
}

// AuthMethod is the method a pg_hba.conf rule or --auth flag selects.
fn resolve_auth_method(cfg Config, database str, user str, secure bool) !str {
	if len(cfg.Hba) > 0 {
		mut method = ""
		let matched = MatchHba(cfg.Hba, database, user, cfg.PeerAddress, secure)
		if let rule = matched {
			method = rule.Method
		}
		if method == "" {
			mut encryption = "no encryption"
			if secure { encryption = "SSL encryption" }
			fail "proto: no pg_hba.conf entry for host \"{cfg.PeerAddress}\", user \"{user}\", database \"{database}\", {encryption}"
		}
		if method == "reject" {
			fail "proto: pg_hba.conf rejects connection for host \"{cfg.PeerAddress}\", user \"{user}\", database \"{database}\""
		}
		return method
	}
	if cfg.Auth == "" { return "trust" }
	return cfg.Auth
}

// Accept performs startup negotiation (including TLS when configured) and authentication.
// A CancelRequest is returned as Accepted.Canceled for the server to route.
fn Accept(sock mut wire.Conn, cfg Config) !Accepted {
	mut transport = plainStream{conn: sock}
	mut secure = false
	let token = seal.RandomBytes(8)
	mut pid = u32(be(token, 0, 4))
	if cfg.Pid != 0 { pid = cfg.Pid }
	mut conn = Conn{sock: transport, startup: Startup{Parameters: make(map[str]str)}, pid: pid, secretKey: u32(be(token, 4, 4)), out: make([]u8, 0, 4096), in: make([]u8, 0, 4096), messageTimeout: 30s}
	mut version = i64(0)
	mut body = []u8{}
	for {
		let (v, b) = try startup_packet(mut conn.sock)
		if v == sslRequest {
			if cfg.TlsCert == "" {
				_ = try conn.sock.Write("N")
				continue
			}
			_ = try conn.sock.Write("S")
			let serverCfg = try tls.LoadServerConfig(cfg.TlsCert, cfg.TlsKey)
			let secured = tls.Server(sock, serverCfg) catch err {
				fail "proto: TLS handshake failed: {err}"
			}
			conn.sock = tlsStream{conn: secured}
			secure = true
			continue
		}
		if v == gssRequest {
			_ = try conn.sock.Write("N")
			continue
		}
		if v == cancelRequest {
			if len(b) < 8 { fail "proto: malformed cancel request" }
			let pid = u32(be(b, 0, 4))
			let key = u32(be(b, 4, 4))
			conn.sock.Close()
			return Accepted.Canceled(pid, key)
		}
		version = v
		body = b
		break
	}
	let major = version >> 16
	if major != 3 {
		try bad_request(mut conn, "0A000", "unsupported frontend protocol {version >> 16}.{version & 0xffff}: server supports 3.0 to 3.0")
		fail "proto: unsupported protocol version {version}"
	}
	let startup = try parse_startup(version, body)
	conn.startup = startup
	conn.secure = secure
	let minor = protocol_minor(version)
	let unsupported = unsupported_startup_options(startup.Parameters)
	if minor > 0 || len(unsupported) > 0 {
		try conn.send_negotiate(0, unsupported)
	}
	mut database = startup.Database
	if database == "" { database = startup.User }
	if cfg.User != "" && startup.User != cfg.User {
		try bad_request(mut conn, "28000", "role \"{startup.User}\" does not exist")
		fail "proto: configured role mismatch"
	}
	if cfg.Database != "" && database != cfg.Database {
		try bad_request(mut conn, "3D000", "database \"{database}\" does not exist")
		fail "proto: configured database mismatch"
	}
	let method = resolve_auth_method(cfg, database, startup.User, secure) catch err {
		bad_request(mut conn, "28000", fault.Message(err)) catch _ { }
		fail err
	}
	if method == "trust" {
		try conn.auth_ok()
	} else if method == "password" || method == "cleartext" {
		conn.cleartext(cfg.Password) catch err {
			bad_request(mut conn, "28P01", "password authentication failed for user \"{startup.User}\"") catch _ { }
			fail err
		}
		try conn.auth_ok()
	} else if method == "md5" {
		conn.md5(cfg.Password, startup.User) catch err {
			bad_request(mut conn, "28P01", "password authentication failed for user \"{startup.User}\"") catch _ { }
			fail err
		}
		try conn.auth_ok()
	} else if method == "scram-sha-256" {
		conn.scram(cfg.Password) catch err {
			bad_request(mut conn, "28P01", "password authentication failed: " + fault.Message(err)) catch _ { }
			fail err
		}
		try conn.auth_ok()
	} else {
		try bad_request(mut conn, "0A000", "authentication method \"{method}\" is not supported")
		fail "proto: unsupported authentication method"
	}
	// ParameterStatus is the session's business (server.send_parameters) and ReadyForQuery
	// closes the startup: proto hands back an authenticated connection after BackendKeyData
	// and lets the server finish the handshake with the parameters it knows.
	try conn.send_backend_key()
	return Accepted.Ready(conn)
}

fn (c mut Conn) send_backend_key() ! {
	mut key = []u8{}
	putbe(mut key, i64(c.pid), 4)
	putbe(mut key, i64(c.secretKey), 4)
	try c.send('K', key)
}

// RejectStartup reads through SSL/GSS negotiation and sends a fatal startup error.
fn RejectStartup(sock mut wire.Conn, code str, message str) ! {
	mut transport = plainStream{conn: sock}
	for {
		let (version, _) = try startup_packet(mut transport)
		if version == sslRequest || version == gssRequest {
			_ = try transport.Write("N")
			continue
		}
		if version == cancelRequest {
			transport.Close()
			return
		}
		mut c = Conn{sock: transport, startup: Startup{Parameters: make(map[str]str)}, pid: 0, secretKey: 0, out: make([]u8, 0, 256), in: make([]u8, 0, 256), messageTimeout: 30s}
		try bad_request(mut c, code, message)
		mut closed = c
		closed.sock.Close()
		closed.closed = true
		return
	}
}

// is_timeout reports whether a read failed because the socket's deadline passed.
fn is_timeout(err fault) bool {
	return twine.Contains(fault.Message(err), "timed out")
}

// read_full reads exactly n bytes into the connection's input buffer. A socket timeout with
// no message in progress is ErrIdle, which the session loop retries; a timeout in the middle
// of a message keeps waiting until the message timeout, so a slow client is bounded but a
// partial message is never lost.
fn (c mut Conn) read_full(n i64) !str {
	if len(c.in) >= n {
		let out = str(c.in[:n])
		c.in = c.in[n:]
		return out
	}
	let started = tide.Now()
	for {
		let got = c.sock.Read(mut c.in, n - len(c.in)) catch err {
			if !is_timeout(err) { fail err }
			if len(c.in) == 0 { fail ErrIdle }
			if tide.Since(started) > c.messageTimeout { fail "proto: message timed out" }
			continue
		}
		if got == 0 { fail "proto: unexpected end of stream" }
		if len(c.in) >= n {
			let out = str(c.in[:n])
			c.in = c.in[n:]
			return out
		}
	}
}

fn (c mut Conn) read_frontend() !Message {
	let rawHead = try c.read_full(5)
	let head = []u8(rawHead)
	let kind = head[0]
	let n = be(head, 1, 4)
	if n < 4 || n > maxMessage { fail "proto: invalid frontend message length" }
	let rawBody = try c.read_full(n-4)
	let body = []u8(rawBody)
	mut k = Cursor{at: 0}
	match kind {
		'Q' => {
			let sql = try readc(body, mut k)
			if k.at != len(body) { fail "proto: trailing Query bytes" }
			return Message.Query(sql)
		}
		'P' => {
			let name = try readc(body, mut k)
			let sql = try readc(body, mut k)
			let count = be(body, k.at, 2)
			k.at += 2
			if count < 0 || k.at+count*4 > len(body) { fail "proto: invalid Parse parameter count" }
			mut oids = []u32{}
			for i in 0..count {
				oids = append(oids, u32(be(body, k.at, 4)))
				k.at += 4
			}
			if k.at != len(body) { fail "proto: trailing Parse bytes" }
			return Message.Parse(name, sql, oids)
		}
		'B' => {
			let portal = try readc(body, mut k)
			let statement = try readc(body, mut k)
			let formatCount = be(body, k.at, 2)
			k.at += 2
			if formatCount < 0 || k.at+formatCount*2 > len(body) { fail "proto: invalid Bind format count" }
			mut paramFormats = []i16{}
			for i in 0..formatCount {
				paramFormats = append(paramFormats, i16(be(body, k.at, 2)))
				k.at += 2
			}
			let valueCount = be(body, k.at, 2)
			k.at += 2
			if valueCount < 0 || k.at+valueCount*4 > len(body) { fail "proto: invalid Bind value count" }
			mut params = [][]u8{}
			for i in 0..valueCount {
				let size = be32(body, k.at)
				k.at += 4
				if size == -1 {
					params = append(params, []u8{})
					continue
				}
				if size < 0 || k.at+size > len(body) { fail "proto: invalid Bind value length" }
				params = append(params, body[k.at:k.at+size])
				k.at += size
			}
			let resultCount = be(body, k.at, 2)
			k.at += 2
			if resultCount < 0 || k.at+resultCount*2 > len(body) { fail "proto: invalid Bind result format count" }
			mut resultFormats = []i16{}
			for i in 0..resultCount {
				resultFormats = append(resultFormats, i16(be(body, k.at, 2)))
				k.at += 2
			}
			if k.at != len(body) { fail "proto: trailing Bind bytes" }
			return Message.Bind(portal, statement, paramFormats, params, resultFormats)
		}
		'D' => {
			if len(body) < 1 { fail "proto: empty Describe" }
			let kindByte = body[0]
			k.at = 1
			let name = try readc(body, mut k)
			if k.at != len(body) { fail "proto: trailing Describe bytes" }
			return Message.Describe(kindByte, name)
		}
		'E' => {
			let portal = try readc(body, mut k)
			let maxRows = be(body, k.at, 4)
			k.at += 4
			if k.at != len(body) { fail "proto: trailing Execute bytes" }
			return Message.Execute(portal, maxRows)
		}
		'C' => {
			if len(body) < 1 { fail "proto: empty Close" }
			let kindByte = body[0]
			k.at = 1
			let name = try readc(body, mut k)
			if k.at != len(body) { fail "proto: trailing Close bytes" }
			return Message.Close(kindByte, name)
		}
		'X' => {
			if len(body) != 0 { fail "proto: malformed Terminate" }
			return Message.Terminate
		}
		'S' => {
			if len(body) != 0 { fail "proto: malformed Sync" }
			return Message.Sync
		}
		'H' => {
			if len(body) != 0 { fail "proto: malformed Flush" }
			return Message.Flush
		}
		'p' => {
			return Message.Password(str(body))
		}
		'd' => {
			return Message.CopyData(body)
		}
		'c' => {
			if len(body) != 0 { fail "proto: malformed CopyDone" }
			return Message.CopyDone
		}
		'f' => {
			let message = try readc(body, mut k)
			return Message.CopyFail(message)
		}
		_ => {
			return Message.Unknown(kind)
		}
	}
}

// Next reads and validates the next frontend message.
fn (c mut Conn) Next() !Message {
	return try c.read_frontend()
}

// Startup returns the authenticated startup parameters.
fn (c Conn) Startup() Startup {
	return c.startup
}

// Pid returns the BackendKeyData process id of this connection.
fn (c Conn) Pid() u32 { return c.pid }

// SecretKey returns the BackendKeyData secret a CancelRequest must present.
fn (c Conn) SecretKey() u32 { return c.secretKey }

// Secure reports whether this connection negotiated TLS.
fn (c Conn) Secure() bool { return c.secure }

// SetTimeout sets the read and write wait limit for this connection.
fn (c mut Conn) SetTimeout(ns i64) {
	c.sock.SetTimeout(ns)
}

// SetMessageTimeout bounds how long a partially received message may take.
fn (c mut Conn) SetMessageTimeout(ns i64) {
	c.messageTimeout = ns
}

// SendError sends a PostgreSQL ErrorResponse.
fn (c mut Conn) SendError(fields ErrorFields) ! {
	try c.error(fields)
}

// SendNotice sends a PostgreSQL NoticeResponse.
fn (c mut Conn) SendNotice(fields ErrorFields) ! {
	let start = begin_frame(mut c.out, 'N')
	mut severity = fields.Severity
	if severity == "" { severity = "NOTICE" }
	error_field(mut c.out, 'S', severity)
	error_field(mut c.out, 'V', severity)
	error_field(mut c.out, 'C', fields.Code)
	error_field(mut c.out, 'M', fields.Message)
	if fields.Detail != "" { error_field(mut c.out, 'D', fields.Detail) }
	if fields.Hint != "" { error_field(mut c.out, 'H', fields.Hint) }
	c.out = append(c.out, 0)
	end_frame(mut c.out, start)
}

// SendReadyForQuery sends ReadyForQuery with transaction status I, T or E.
fn (c mut Conn) SendReadyForQuery(status u8) ! {
	if status != 'I' && status != 'T' && status != 'E' { fail "proto: invalid transaction status" }
	try c.ready(status)
}

// SendCommandComplete sends CommandComplete.
fn (c mut Conn) SendCommandComplete(tag str) ! {
	try c.send('C', cbyte_payload(tag))
}

fn cbyte_payload(tag str) []u8 {
	mut out = []u8{}
	cstr(mut out, tag)
	return out
}

fn encode_row_description(out mut []u8, cols []Column) {
	let start = begin_frame(mut out, 'T')
	putbe(mut out, len(cols), 2)
	for col in cols {
		cstr(mut out, col.Name)
		putbe(mut out, i64(col.TableOid), 4)
		putbe(mut out, i64(col.Attribute), 2)
		putbe(mut out, i64(col.TypeOid), 4)
		putbe(mut out, i64(col.TypeSize), 2)
		putbe(mut out, i64(col.TypeMod), 4)
		putbe(mut out, i64(col.Format), 2)
	}
	end_frame(mut out, start)
}

fn encode_data_row(out mut []u8, cells []Cell) {
	let start = begin_frame(mut out, 'D')
	putbe(mut out, len(cells), 2)
	for cell in cells {
		if cell.Null {
			putbe(mut out, -1, 4)
			continue
		}
		if cell.Binary {
			putbe(mut out, len(cell.Bytes), 4)
			out = append(out, cell.Bytes...)
			continue
		}
		putbe(mut out, len(cell.Value), 4)
		for i in 0..len(cell.Value) { out = append(out, u8(cell.Value[i])) }
	}
	end_frame(mut out, start)
}

// SendDatumRow appends one DataRow straight into the output buffer: text values are written
// in place (types.AppendText) and only the four length bytes are patched afterwards, and a
// binary value is encoded with the type's binary output.
fn (c mut Conn) SendDatumRow(r types.Row, formats []i16) ! {
	let start = begin_frame(mut c.out, 'D')
	putbe(mut c.out, len(r), 2)
	for i, d in r {
		if types.IsNull(d) {
			putbe(mut c.out, -1, 4)
			continue
		}
		mut format = i16(0)
		if i < len(formats) { format = formats[i] }
		if format == 1 {
			mut buf = []u8{}
			types.EncodeBinary(d, mut buf)
			putbe(mut c.out, len(buf), 4)
			c.out = append(c.out, buf...)
			continue
		}
		let lenAt = len(c.out)
		putbe(mut c.out, 0, 4)
		let before = len(c.out)
		// PostgreSQL's boolean text output is t/f; types.AppendText says true/false.
		if d.Oid() == 16 {
			if d.Text() == "true" { c.out = append(c.out, 't') } else { c.out = append(c.out, 'f') }
		} else {
			types.AppendText(d, mut c.out)
		}
		put_length(mut c.out, lenAt, len(c.out) - before)
	}
	end_frame(mut c.out, start)
}

// put_length patches a four-byte big-endian length in the output buffer.
fn put_length(out mut []u8, at i64, n i64) {
	out[at] = u8(n >> 24)
	out[at+1] = u8(n >> 16)
	out[at+2] = u8(n >> 8)
	out[at+3] = u8(n)
}

// SendRowDescription sends a text-format RowDescription into the reusable output buffer.
fn (c mut Conn) SendRowDescription(cols []Column) ! {
	encode_row_description(mut c.out, cols)
}

// SendDataRow sends one row; NULL cells use length -1 and binary cells use Bytes.
fn (c mut Conn) SendDataRow(cells []Cell) ! {
	encode_data_row(mut c.out, cells)
}

// SendEmptyQueryResponse sends EmptyQueryResponse.
fn (c mut Conn) SendEmptyQueryResponse() ! {
	try c.send('I', []u8{})
}

// SendParseComplete sends ParseComplete.
fn (c mut Conn) SendParseComplete() ! { try c.send('1', []u8{}) }
// SendBindComplete sends BindComplete.
fn (c mut Conn) SendBindComplete() ! { try c.send('2', []u8{}) }
// SendCloseComplete sends CloseComplete.
fn (c mut Conn) SendCloseComplete() ! { try c.send('3', []u8{}) }
// SendNoData sends NoData.
fn (c mut Conn) SendNoData() ! { try c.send('n', []u8{}) }
// SendPortalSuspended sends PortalSuspended.
fn (c mut Conn) SendPortalSuspended() ! { try c.send('s', []u8{}) }

// SendParameterDescription sends ParameterDescription.
fn (c mut Conn) SendParameterDescription(oids []u32) ! {
	let start = begin_frame(mut c.out, 't')
	putbe(mut c.out, len(oids), 2)
	for oid in oids { putbe(mut c.out, i64(oid), 4) }
	end_frame(mut c.out, start)
}

// SendCopyInResponse sends CopyInResponse; format 0 is text and 1 is binary per column.
fn (c mut Conn) SendCopyInResponse(format i8, columnFormats []i16) ! {
	try c.send_copy_response('G', format, columnFormats)
}

// SendCopyOutResponse sends CopyOutResponse.
fn (c mut Conn) SendCopyOutResponse(format i8, columnFormats []i16) ! {
	try c.send_copy_response('H', format, columnFormats)
}

// SendCopyBothResponse sends CopyBothResponse (replication is not implemented yet).
fn (c mut Conn) SendCopyBothResponse(format i8, columnFormats []i16) ! {
	try c.send_copy_response('W', format, columnFormats)
}

fn (c mut Conn) send_copy_response(kind u8, format i8, columnFormats []i16) ! {
	let start = begin_frame(mut c.out, kind)
	c.out = append(c.out, u8(format))
	putbe(mut c.out, len(columnFormats), 2)
	for f in columnFormats { putbe(mut c.out, i64(f), 2) }
	end_frame(mut c.out, start)
}

// SendCopyData sends one CopyData payload.
fn (c mut Conn) SendCopyData(data []u8) ! {
	try c.send('d', data)
}

// SendCopyDone sends CopyDone.
fn (c mut Conn) SendCopyDone() ! {
	try c.send('c', []u8{})
}

// Flush writes backend messages buffered since the last ReadyForQuery.
fn (c mut Conn) Flush() ! {
	try c.flush()
}

// Pending reports how many buffered output bytes have not been written yet.
fn (c Conn) Pending() i64 { return len(c.out) }

// Close closes the network connection.
fn (c mut Conn) Close() {
	if c.closed { return }
	c.sock.Close()
	c.closed = true
}

// CloseIfClosedOnWire closes the socket without sending anything more.
fn (c mut Conn) Abort() {
	if c.closed { return }
	c.sock.Close()
	c.closed = true
}
