package main

import "say"
import "quarry"
import "fault"
import "../../parse"

// parsecheck FILE.sql...: how much of PostgreSQL's own regression SQL tingres's parser accepts.
// Each file is split into statements (psql meta-commands and COPY data blocks removed) and every
// statement goes through parse.Parse. Output:
//   FILE <name> <statements> <parsed>
//   F <category>              one line per failing statement (category groups failures)
//   FIRST <name> <fail> <parsed> <category> :: <statement snippet>
//   TOTAL <files> <filesFullyParsed> <statements> <parsed>
// Pipe the F lines through `sort | uniq -c | sort -rn` to rank missing constructs.

fn main() {
	let args = quarry.Args()
	mut files i64 = 0
	mut full i64 = 0
	mut total i64 = 0
	mut ok i64 = 0
	for a in args[1:] {
		let text = quarry.ReadFile(a) catch _ { "" }
		let stmts = splitStatements(substitutePsqlVars(stripInlineMeta(stripMeta(text))))
		mut good i64 = 0
		mut bad i64 = 0
		mut firstBad = ""
		for s in stmts {
			let r = parse.Parse(s) catch err {
				bad += 1
				let cat = normMsg(err)
				say.Line("F {cat} :: {snippet(s)}")
				if firstBad == "" { firstBad = cat + " :: " + snippet(s) }
				[]parse.Stmt{}
			}
			if len(r) > 0 { good += 1 }
		}
		say.Line("FILE {baseName(a)} {len(stmts)} {good}")
		if bad > 0 { say.Line("FIRST {baseName(a)} {bad} {good} {firstBad}") }
		files += 1
		if good == len(stmts) { full += 1 }
		total += len(stmts)
		ok += good
	}
	say.Line("TOTAL {files} {full} {total} {ok}")
}

// normMsg reduces a parse fault to a stable category: drop the position suffix and the part of
// the message after the first quoted token.
fn normMsg(err fault) str {
	let message = fault.Message(err)
	mut cut = len(message)
	let marker = " (position "
	let at = indexOf(message, marker)
	if at >= 0 { cut = at }
	let q1 = indexOf(message, "\"")
	if q1 >= 0 && q1 < cut {
		let rest = message[q1 + 1:]
		let q2 = indexOf(rest, "\"")
		if q2 >= 0 && q1 + 1 + q2 + 1 <= cut { cut = q1 + 1 + q2 + 1 } else { cut = q1 + 1 }
	}
	return message[:cut]
}

fn indexOf(s str, needle str) i64 {
	if len(needle) == 0 { return 0 }
	if len(s) < len(needle) { return -1 }
	for i in 0..len(s) - len(needle) + 1 {
		if s[i:i + len(needle)] == needle { return i }
	}
	return -1
}

fn snippet(s str) str {
	mut out = ""
	for i in 0..len(s) {
		let c = s[i]
		if c == 10 || c == 13 || c == 9 { out += " " } else { out += str(c) }
		if len(out) >= 90 { return out + "..." }
	}
	return out
}

fn baseName(p str) str {
	mut cut = 0
	for i in 0..len(p) {
		if p[i] == '/' { cut = i + 1 }
	}
	return p[cut:]
}

// stripMeta drops psql meta-command lines and the data block after COPY ... FROM stdin.
fn stripMeta(text str) str {
	mut out = []u8{}
	mut inCopy = false
	mut start = 0
	for i in 0..len(text) + 1 {
		if i == len(text) || text[i] == '\n' {
			let line = text[start:i]
			start = i + 1
			if inCopy {
				if line == "\\." { inCopy = false }
				continue
			}
			if len(line) > 0 && line[0] == '\\' { continue }
			for j in 0..len(line) { out = append(out, line[j]) }
			out = append(out, '\n')
			if hasCopyStdin(line) { inCopy = true }
		}
	}
	return str(out)
}

fn hasCopyStdin(line str) bool {
	let l = lower(line)
	return contains(l, "copy ") && contains(l, "from stdin")
}

fn lower(s str) str {
	mut b = []u8{}
	for i in 0..len(s) {
		mut c = s[i]
		if c >= 'A' && c <= 'Z' { c = c + 32 }
		b = append(b, c)
	}
	return str(b)
}

fn contains(s str, sub str) bool {
	if len(sub) > len(s) { return false }
	for i in 0..len(s) - len(sub) + 1 {
		if s[i:i + len(sub)] == sub { return true }
	}
	return false
}

// splitStatements splits at top-level semicolons, honouring '..', E'..', "..", $tag$..$tag$,
// -- comments and nested /* */ comments. Chunks that are only whitespace/comments are dropped.
fn splitStatements(sql str) []str {
	mut out = []str{}
	mut start = 0
	mut i = 0
	mut meaningful = false
	let n = len(sql)
	for i < n {
		let c = sql[i]
		if c == '-' && i + 1 < n && sql[i + 1] == '-' {
			for i < n && sql[i] != '\n' { i += 1 }
			continue
		}
		if c == '/' && i + 1 < n && sql[i + 1] == '*' {
			mut depth = 1
			i += 2
			for i < n && depth > 0 {
				if sql[i] == '/' && i + 1 < n && sql[i + 1] == '*' {
					depth += 1
					i += 2
					continue
				}
				if sql[i] == '*' && i + 1 < n && sql[i + 1] == '/' {
					depth -= 1
					i += 2
					continue
				}
				i += 1
			}
			continue
		}
		if c == '\'' || c == '"' {
			meaningful = true
			let q = c
			i += 1
			for i < n {
				if sql[i] == '\\' && q == '\'' && isEscapeStart(sql, start, i) {
					i += 2
					continue
				}
				if sql[i] == q {
					if i + 1 < n && sql[i + 1] == q {
						i += 2
						continue
					}
					break
				}
				i += 1
			}
			i += 1
			continue
		}
		if c == '$' {
			mut j = i + 1
			for j < n && (isIdent(sql[j])) { j += 1 }
			if j < n && sql[j] == '$' {
				let tag = sql[i:j + 1]
				meaningful = true
				mut k = j + 1
				mut found = false
				for k + len(tag) <= n {
					if sql[k:k + len(tag)] == tag {
						found = true
						break
					}
					k += 1
				}
				if found { i = k + len(tag) } else { i = n }
				continue
			}
		}
		if c == ';' {
			if meaningful { out = append(out, sql[start:i + 1]) }
			start = i + 1
			meaningful = false
			i += 1
			continue
		}
		if c != ' ' && c != '\n' && c != '\t' && c != '\r' { meaningful = true }
		i += 1
	}
	if meaningful { out = append(out, sql[start:n]) }
	return out
}

// stripInlineMeta removes psql meta-commands (a backslash to end of line) that appear in the
// middle of a line, e.g. "SELECT 1 \gset". Backslashes inside strings, dollar-quoted strings
// and comments are left alone.
fn stripInlineMeta(text str) str {
	mut out = []u8{}
	mut i = 0
	let n = len(text)
	for i < n {
		let c = text[i]
		if c == '\'' || c == '"' {
			let q = c
			out = append(out, c)
			i += 1
			for i < n {
				out = append(out, text[i])
				if text[i] == '\\' && q == '\'' { if i + 1 < n { out = append(out, text[i + 1])
						i += 2
						continue } }
				if text[i] == q {
					if i + 1 < n && text[i + 1] == q { out = append(out, text[i + 1])
						i += 2
						continue }
					i += 1
					break
				}
				i += 1
			}
			continue
		}
		if c == '$' {
			mut j = i + 1
			for j < n && isIdent(text[j]) { j += 1 }
			if j < n && text[j] == '$' {
				let tag = text[i:j + 1]
				for k in i..j + 1 { out = append(out, text[k]) }
				i = j + 1
				mut found = false
				mut k = j + 1
				for k + len(tag) <= n {
					if text[k:k + len(tag)] == tag {
						for m in k..k + len(tag) { out = append(out, text[m]) }
						i = k + len(tag)
						found = true
						break
					}
					k += 1
				}
				if !found { i = n }
				continue
			}
		}
		if c == '-' && i + 1 < n && text[i + 1] == '-' {
			for i < n && text[i] != '\n' { out = append(out, text[i])
				i += 1 }
			continue
		}
		if c == '/' && i + 1 < n && text[i + 1] == '*' {
			mut depth = 1
			for i < n && depth > 0 {
				out = append(out, text[i])
				if text[i] == '/' && i + 1 < n && text[i + 1] == '*' { out = append(out, text[i + 1])
					depth += 1
					i += 2
					continue }
				if text[i] == '*' && i + 1 < n && text[i + 1] == '/' { out = append(out, text[i + 1])
					depth -= 1
					i += 2
					continue }
				i += 1
			}
			continue
		}
		if c == '\\' {
			for i < n && text[i] != '\n' { i += 1 }
			continue
		}
		out = append(out, c)
		i += 1
	}
	return str(out)
}

// substitutePsqlVars replaces psql variable references (:'name' and :name) with a parseable
// placeholder, so regression scripts that psql substitutes before sending still tokenize.
fn substitutePsqlVars(text str) str {
	mut out = []u8{}
	mut i = 0
	let n = len(text)
	for i < n {
		let c = text[i]
		if c == '\'' || c == '"' {
			let q = c
			out = append(out, c)
			i += 1
			for i < n {
				out = append(out, text[i])
				if text[i] == q {
					if i + 1 < n && text[i + 1] == q { out = append(out, text[i + 1])
						i += 2
						continue }
					i += 1
					break
				}
				i += 1
			}
			continue
		}
		if c == ':' && i + 1 < n {
			mut prev u8 = ' '
			if i > 0 { prev = text[i - 1] }
			let prevOk = prev == ' ' || prev == '\n' || prev == '\t' || prev == ',' || prev == '(' || prev == '=' || prev == '\r'
			let next = text[i + 1]
			if (next == '\'' || isIdent(next)) && text[i + 1] != ':' && prevOk {
				i += 1
				continue
			}
		}
		out = append(out, c)
		i += 1
	}
	return str(out)
}

fn isIdent(c u8) bool {
	return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'
}

// isEscapeStart reports whether the string whose backslash is at i was opened as E'...'.
fn isEscapeStart(sql str, start i64, i i64) bool {
	mut j = i - 1
	for j > start && sql[j] != '\'' { j -= 1 }
	if j > start && (sql[j - 1] == 'E' || sql[j - 1] == 'e') { return true }
	return false
}
