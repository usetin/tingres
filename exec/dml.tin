package exec

import "../types"
import "../plan"
import "../catalog"
import "../txn"
import "../store"

// ExecuteModifyTable executes an INSERT, UPDATE, or DELETE plan node against the store.
fn ExecuteModifyTable(node mut plan.ModifyTableNode, ctx mut ExprContext, out mut dyn Sink) !str {
	if let cat = ctx.Catalog {
		if let t = ctx.Txn {
			mut sourcePlan = node.Source
			mut sourceCur = try BuildCursor(mut sourcePlan, mut ctx)
			let rel = store.RelId(node.Table.Rel)
			// Ensure the backing heap relation exists even when the caller built the
			// catalog descriptor directly (unit tests, or a catalog that lost metadata).
			cat.Store.CreateHeap(rel) catch _ { }
			let x = store.NewXidCtx(t.Xid(), t.CommandID())

			mut colTypes = []u32{}
			for col in node.Table.Cols {
				colTypes = append(colTypes, col.Type)
			}

			if len(node.Returning) > 0 && len(node.Cols) > 0 {
				mut sinkCols = []ColDesc{}
				mut formats = []i16{}
				for c in node.Cols {
					sinkCols = append(sinkCols, ColDesc{
						Name: c.Name,
						Oid: c.Oid,
						Typmod: c.Typmod,
						TableOid: c.TableOid,
						Attno: c.Attno,
					})
					formats = append(formats, 0)
				}
				out.RowDescription(sinkCols, formats)
			}

			mut affected = i64(0)

			match node.Kind {
				Insert => {
					for {
						let (sourceRow, ok) = try sourceCur.Next()
						if !ok {
							break
						}
						// Build target row mapped to table columns
						mut targetRow = []types.Datum{}
						for i, col in node.Table.Cols {
							mut mapped = false
							mut val = types.Null()
							if len(node.TargetCols) > 0 {
								for targetIdx, attno in node.TargetCols {
									if i64(attno) == i64(col.Number) && targetIdx < len(sourceRow) {
										val = sourceRow[targetIdx]
										mapped = true
										break
									}
								}
							} else if i < len(sourceRow) {
								val = sourceRow[i]
								mapped = true
							}
							if !mapped {
								val = types.Null()
							}
							// NOT NULL constraint check
							if !col.Nullable && types.IsNull(val) {
								try types.ErrorFault(types.NewPgError("23502", "null value in column \"" + col.Name + "\" of relation \"" + node.Table.Name + "\" violates not-null constraint", "", "", 0))
							}
							targetRow = append(targetRow, val)
						}

						// Check UNIQUE / PRIMARY KEY constraints
						mut conflict = false
						for idx in node.Table.Indexes {
							if idx.Unique {
								let existingScan = cat.Store.HeapScan(rel)
								mut scan = existingScan
								for {
									let (hTuple, hOk) = scan.Next()
									if !hOk {
										break
									}
									let h = hTuple.Header
									let snap = cat.Manager.Snapshot(t)
									if conflictVisible(cat.Manager, snap, t, h) {
										let decoded = types.DecodeRow(colTypes, hTuple.Payload) catch _ { []types.Datum{} }
										if len(decoded) > 0 && len(targetRow) > 0 && !types.IsNull(targetRow[0]) && !types.IsNull(decoded[0]) {
											if types.Compare(targetRow[0], decoded[0]) == 0 {
												conflict = true
												break
											}
										}
									}
								}
							}
							if conflict {
								break
							}
						}

						if conflict {
							if let onConflict = node.OnConflict {
								if onConflict.Action == plan.ModifyKind.Insert {
									// DO NOTHING
									continue
								}
							}
							try types.ErrorFault(types.NewPgError("23505", "duplicate key value violates unique constraint", "", "", 0))
						}

						// Encode and insert
						mut payload = []u8{}
						types.EncodeRow(colTypes, targetRow, mut payload)
						try cat.Store.HeapInsert(x, rel, payload)
						affected += 1

						if len(node.Returning) > 0 {
							mut retCtx = ctx
							retCtx.Row = targetRow
							mut retRow = []types.Datum{}
							for expr in node.Returning {
								mut eMut = expr
								let retVal = try EvalExpr(mut eMut, mut retCtx)
								retRow = append(retRow, retVal)
							}
							out.DataRow(retRow)
						}
					}
					let tag = "INSERT 0 {affected}"
					out.CommandComplete(tag)
					return tag
				}
				Delete => {
					for {
						let (sourceRow, ok) = try sourceCur.Next()
						if !ok {
							break
						}
						// Identify matching tuple in store
						let scan = cat.Store.HeapScan(rel)
						mut hScan = scan
						mut targetTid = store.Tid{}
						mut found = false
						let snap = cat.Manager.Snapshot(t)
						for {
							let (hTuple, hOk) = hScan.Next()
							if !hOk {
								break
							}
							let h = hTuple.Header
							if h.Xmax() == t.Xid() {
								// Already deleted by this transaction; skip it.
								continue
							}
							if cat.Manager.Visible(snap, h) {
								let decoded = types.DecodeRow(colTypes, hTuple.Payload) catch _ { []types.Datum{} }
								if rowsMatch(decoded, sourceRow) {
									targetTid = hTuple.Tid
									found = true
									break
								}
							}
						}
						if found {
							try cat.Store.HeapDelete(x, rel, targetTid)
							affected += 1
							if len(node.Returning) > 0 {
								mut retCtx = ctx
								retCtx.Row = sourceRow
								mut retRow = []types.Datum{}
								for expr in node.Returning {
									mut eMut = expr
									let retVal = try EvalExpr(mut eMut, mut retCtx)
									retRow = append(retRow, retVal)
								}
								out.DataRow(retRow)
							}
						}
					}
					let tag = "DELETE {affected}"
					out.CommandComplete(tag)
					return tag
				}
				Update => {
					// The planner lowers UPDATE to Project(Input: target scan): the input
					// yields the original row and the projection yields the replacement row.
					// Walk the input to match the stored tuple, then write the projection.
					mut oldPlan = freshPlan(node.Source)
					mut newExprs = []plan.Expr{}
					match node.Source {
						Project(pr) => {
							oldPlan = pr.Input
							newExprs = pr.Exprs
						}
						_ => {}
					}
					mut oldCur = try BuildCursor(mut oldPlan, mut ctx)
					for {
						let (oldRow, ok) = try oldCur.Next()
						if !ok {
							break
						}
						let scan = cat.Store.HeapScan(rel)
						mut hScan = scan
						mut targetTid = store.Tid{}
						mut found = false
						let snap = cat.Manager.Snapshot(t)
						for {
							let (hTuple, hOk) = hScan.Next()
							if !hOk {
								break
							}
							let h = hTuple.Header
							if h.Xmax() == t.Xid() {
								// Already modified by this transaction; not a target again.
								continue
							}
							if cat.Manager.Visible(snap, h) {
								let decoded = types.DecodeRow(colTypes, hTuple.Payload) catch _ { []types.Datum{} }
								if rowsMatch(decoded, oldRow) {
									targetTid = hTuple.Tid
									found = true
									break
								}
							}
						}
						if found {
							try cat.Store.HeapDelete(x, rel, targetTid)
							mut updatedRow = []types.Datum{}
							if len(newExprs) > 0 {
								mut updCtx = ctx
								updCtx.Row = oldRow
								for expr in newExprs {
									mut eMut = expr
									let val = try EvalExpr(mut eMut, mut updCtx)
									updatedRow = append(updatedRow, val)
								}
							} else {
								for d in oldRow {
									updatedRow = append(updatedRow, d)
								}
							}
							for i, col in node.Table.Cols {
								if i >= len(updatedRow) {
									updatedRow = append(updatedRow, types.Null())
								}
								if !col.Nullable && types.IsNull(updatedRow[i]) {
									try types.ErrorFault(types.NewPgError("23502", "null value in column \"" + col.Name + "\" of relation \"" + node.Table.Name + "\" violates not-null constraint", "", "", 0))
								}
							}
							mut payload = []u8{}
							types.EncodeRow(colTypes, updatedRow, mut payload)
							try cat.Store.HeapInsert(x, rel, payload)
							affected += 1
							if len(node.Returning) > 0 {
								mut retCtx = ctx
								retCtx.Row = updatedRow
								mut retRow = []types.Datum{}
								for expr in node.Returning {
									mut eMut = expr
									let retVal = try EvalExpr(mut eMut, mut retCtx)
									retRow = append(retRow, retVal)
								}
								out.DataRow(retRow)
							}
						}
					}
					let tag = "UPDATE {affected}"
					out.CommandComplete(tag)
					return tag
				}
			}
		}
	}
	try types.ErrorFault(types.NewPgError("XX000", "catalog and transaction required for DML", "", "", 0))
	return ""
}

// conflictVisible reports whether a tuple is a uniqueness-conflict candidate: a row this
// transaction inserted conflicts even before the command counter advances, and it is gone
// once this transaction deleted it.
fn conflictVisible(m txn.Manager, snap txn.Snapshot, t txn.Txn, h store.TupleHeader) bool {
	if h.Xmin() == t.Xid() {
		return h.Xmax() != t.Xid()
	}
	return m.Visible(snap, h)
}

fn rowsMatch(a []types.Datum, b []types.Datum) bool {
	if len(a) == 0 || len(b) == 0 {
		return false
	}
	let minLen = match len(a) < len(b) {
		true => len(a)
		_ => len(b)
	}
	for i in 0..minLen {
		let da = a[i]
		let db = b[i]
		if types.IsNull(da) || types.IsNull(db) {
			if types.IsNull(da) != types.IsNull(db) {
				return false
			}
		} else if types.Compare(da, db) != 0 {
			return false
		}
	}
	return true
}
