package exec

import "../types"
import "../plan"
import "../catalog"
import "../txn"
import "../store"
import "crucible"
import "quarry"

fn createTestSession(name str) !(Session, txn.Manager) {
	let dir = quarry.TempDir() + "/tingres-util-" + name
	quarry.RemoveAll(dir) catch _ { }
	mut db = try store.Open(dir, store.Options{BufferPages: 8, SyncOnWrite: false})
	mut m = try txn.NewManager(mut db)
	let c = try catalog.Open(mut db, m)
	let s = NewSession(c, m, "postgres", "postgres")
	return s, m
}

fn TestUtilityCreateTableAndDrop(t mut crucible.T) {
	let (sess, _) = createTestSession("create_drop") catch err {
		t.Error("session setup failed: {err}")
		return
	}
	mut s = sess
	mut sink = NewRecordSink()

	// CREATE TABLE test_tbl (id int, name text);
	s.Simple("CREATE TABLE test_tbl (id int, name text);", mut sink) catch err {
		t.Error("CREATE TABLE failed: {err}")
		return
	}
	t.True("received CREATE TABLE tag", len(sink.Tags) > 0 && sink.Tags[len(sink.Tags)-1] == "CREATE TABLE")

	// Verify table exists in catalog
	let tx = s.Txn() catch _ { return }
	let tbl = s.Catalog.LookupTable(tx, "public", "test_tbl")
	t.True("table found in catalog", tbl != nil)

	// DROP TABLE test_tbl;
	s.Simple("DROP TABLE test_tbl;", mut sink) catch err {
		t.Error("DROP TABLE failed: {err}")
		return
	}
	t.True("received DROP TABLE tag", sink.Tags[len(sink.Tags)-1] == "DROP TABLE")
}

fn TestUtilityExplain(t mut crucible.T) {
	let (sess, _) = createTestSession("explain") catch err {
		t.Error("session setup failed: {err}")
		return
	}
	mut s = sess
	mut sink = NewRecordSink()

	// EXPLAIN SELECT 1;
	s.Simple("EXPLAIN SELECT 1;", mut sink) catch err {
		t.Error("EXPLAIN failed: {err}")
		return
	}
	t.True("received EXPLAIN tag", len(sink.Tags) > 0 && sink.Tags[len(sink.Tags)-1] == "EXPLAIN")
	t.True("explain returned lines", len(sink.Rows) > 0)
}

fn TestExtendedProtocolParseBindExecuteDescribe(t mut crucible.T) {
	let (sess, _) = createTestSession("extended_protocol") catch err {
		t.Error("session setup failed: {err}")
		return
	}
	mut s = sess
	mut sink = NewRecordSink()

	// 1. Parse statement
	s.Parse("s1", "SELECT 42;", []u32{}) catch err {
		t.Error("Parse failed: {err}")
		return
	}

	// 2. Describe statement
	let desc = s.Describe('S', "s1") catch err {
		t.Error("Describe failed: {err}")
		return
	}
	t.True("described 1 column", len(desc.Cols) == 1)

	// 3. Bind to portal
	mut bindParams = []types.Datum{}
	s.Bind("p1", "s1", mut bindParams, []i16{0}) catch err {
		t.Error("Bind failed: {err}")
		return
	}

	// 4. Execute portal
	s.Execute("p1", 0, mut sink) catch err {
		t.Error("Execute failed: {err}")
		return
	}
	t.True("received 1 row", len(sink.Rows) == 1)
	if len(sink.Rows) == 1 {
		t.True("row value is 42", sink.Rows[0][0].Text() == "42")
	}

	// 5. Close portal
	s.Close('P', "p1") catch err {
		t.Error("Close failed: {err}")
	}
}

fn TestSystemFunctions(t mut crucible.T) {
	let (sess, _) = createTestSession("sys_funcs") catch err {
		t.Error("session setup failed: {err}")
		return
	}
	mut s = sess
	mut sink = NewRecordSink()

	// SELECT version();
	s.Simple("SELECT version();", mut sink) catch err {
		t.Error("version() failed: {err}")
		return
	}
	t.True("version() returned row", len(sink.Rows) > 0)

	// SELECT current_database();
	mut sink2 = NewRecordSink()
	s.Simple("SELECT current_database();", mut sink2) catch err {
		t.Error("current_database() failed: {err}")
		return
	}
	t.True("current_database() returned row", len(sink2.Rows) > 0)
}
