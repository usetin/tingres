		params = append(params, pt)
	}
	mut analyzed = try AnalyzeStatement(c, t, parse.Stmt.Delete(del), mut params)
	let planTree = try PlanQuery(c, t, mut analyzed)
	return Prepared{
		Stmt: parse.Stmt.Delete(del),
		ParamTypes: params,
		ResultCols: planTree.Cols(),
		Plan: planTree,
		CatalogVersion: c.Version(),
	}
}
