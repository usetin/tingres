package plan

import "../types"
import "../catalog"
import "../txn"
import "say"
import "mint"

const SeqPageCost = 1.0
const RandomPageCost = 4.0
const CpuTupleCost = 0.01
const CpuIndexTupleCost = 0.005
const CpuOperatorCost = 0.0025

fn costSeqScan(rows f64, width i64, numQuals i64) Cost {
	let pages = f64(width * i64(rows)) / 8192.0 + 1.0
	let total = pages * SeqPageCost + rows * (CpuTupleCost + f64(numQuals) * CpuOperatorCost)
	return Cost{
		Startup: 0.0,
		Total: total,
		Rows: rows,
		Width: width,
	}
}

fn costIndexScan(rows f64, width i64, numQuals i64, isUnique bool) Cost {
	if isUnique {
		return Cost{
			Startup: 0.0,
			Total: RandomPageCost * 2.0 + CpuIndexTupleCost + CpuTupleCost + f64(numQuals) * CpuOperatorCost,
			Rows: 1.0,
			Width: width,
		}
	}
	let indexPages = f64(width * i64(rows)) / 16384.0 + 1.0
	let tablePages = f64(width * i64(rows)) / 8192.0 + 1.0
	let total = indexPages * RandomPageCost + tablePages * RandomPageCost + rows * (CpuIndexTupleCost + CpuTupleCost + f64(numQuals) * CpuOperatorCost)
	return Cost{
		Startup: 0.0,
		Total: total,
		Rows: rows,
		Width: width,
	}
}

fn costSort(child Cost, rows f64, width i64) Cost {
	mut logRows = 1.0
	mut r = rows
	for r > 2.0 {
		logRows += 1.0
		r = r / 2.0
	}
	let sortCost = 2.0 * rows * CpuOperatorCost * logRows
	return Cost{
		Startup: child.Total + sortCost,
		Total: child.Total + sortCost + rows * CpuTupleCost,
		Rows: rows,
		Width: width,
	}
}

fn costAgg(child Cost, inRows f64, outRows f64, numAggs i64, width i64) Cost {
	let startup = child.Total
	let total = startup + inRows * (CpuTupleCost + f64(numAggs) * CpuOperatorCost)
	return Cost{
		Startup: startup,
		Total: total,
		Rows: outRows,
		Width: width,
	}
}

fn costHashJoin(left Cost, right Cost, outRows f64, width i64) Cost {
	let hashCost = right.Total + right.Rows * CpuTupleCost
	let total = hashCost + left.Total + left.Rows * (CpuTupleCost + CpuOperatorCost)
	return Cost{
		Startup: hashCost,
		Total: total,
		Rows: outRows,
		Width: width,
	}
}

fn costNestLoop(outer Cost, inner Cost, outRows f64, width i64) Cost {
	let total = outer.Total + outer.Rows * inner.Total
	return Cost{
		Startup: outer.Startup + inner.Startup,
		Total: total,
		Rows: outRows,
		Width: width,
	}
}

// mkConstExpr builds a Const expression from a scalar or materialised datum.
// The datum is always bound to a local first: constructing a value struct
// inline inside the enum literal is miscompiled by Tin when other large locals
// are in scope (see BUGS.md), so all constant construction goes through here.
fn mkConstExpr(d types.Datum, typ u32) Expr {
	let ce = ConstExpr{Value: d, Type: typ}
	return Expr.Const(ce)
}

// mkInt4Const builds an integer Const expression of the given integer type.
fn mkInt4Const(oid types.Oid, v i64) Expr {
	let d = types.FromI64(oid, v)
	return mkConstExpr(d, u32(oid))
}

// mkBoolConst builds a boolean Const expression.
fn mkBoolConst(v bool) Expr {
	let d = types.FromBool(v)
	return mkConstExpr(d, u32(types.BoolOid))
}

// mkStrConst builds a text-family Const expression.
fn mkStrConst(oid types.Oid, v str) Expr {
	let d = types.FromStr(oid, v)
	return mkConstExpr(d, u32(oid))
}

// mkNullConst builds a typed NULL Const expression.
fn mkNullConst(typ u32) Expr {
	let d = types.Null()
	return mkConstExpr(d, typ)
}

// foldExpr performs constant folding on expression trees.
fn foldExpr(expr Expr) Expr {
	match expr {
		Const(_) => { return expr }
		Param(_) => { return expr }
		ColRef(_) => { return expr }
		Cast(c) => {
			let foldedArg = foldExpr(c.Arg)
			match foldedArg {
				Const(lit) => {
					let castVal = types.Cast(lit.Value, types.Oid(c.Type)) catch _ {
						return Expr.Cast(CastExpr{Arg: foldedArg, Type: c.Type, Typmod: c.Typmod})
					}
					return mkConstExpr(castVal, c.Type)
				}
				_ => {
					return Expr.Cast(CastExpr{Arg: foldedArg, Type: c.Type, Typmod: c.Typmod})
				}
			}
		}
		NullTest(nt) => {
			let foldedArg = foldExpr(nt.Arg)
			match foldedArg {
				Const(lit) => {
					let isNull = types.IsNull(lit.Value)
					if nt.Test == NullTestType.IsNull {
						return mkBoolConst(isNull)
					} else {
						return mkBoolConst(!isNull)
					}
				}
				_ => {
					return Expr.NullTest(NullTestExpr{Arg: foldedArg, Test: nt.Test, Type: nt.Type})
				}
			}
		}
		BoolExpr(be) => {
			mut foldedArgs = []Expr{}
			for a in be.Args {
				foldedArgs = append(foldedArgs, foldExpr(a))
			}
			match be.Op {
				And => {
					mut nonConstArgs = []Expr{}
					for fa in foldedArgs {
						match fa {
							Const(lit) => {
								if !types.IsNull(lit.Value) {
									let b = lit.Value.Text() == "t" || lit.Value.Text() == "true"
									if !b {
										return mkBoolConst(false)
									}
								} else {
									nonConstArgs = append(nonConstArgs, fa)
								}
							}
							_ => {
								nonConstArgs = append(nonConstArgs, fa)
							}
						}
					}
					if len(nonConstArgs) == 0 {
						return mkBoolConst(true)
					}
					if len(nonConstArgs) == 1 {
						return nonConstArgs[0]
					}
					return Expr.BoolExpr(BoolExpr{Op: BoolOp.And, Args: nonConstArgs, Type: be.Type})
				}
				Or => {
					mut nonConstArgs = []Expr{}
					for fa in foldedArgs {
						match fa {
							Const(lit) => {
								if !types.IsNull(lit.Value) {
									let b = lit.Value.Text() == "t" || lit.Value.Text() == "true"
									if b {
										return mkBoolConst(true)
									}
								} else {
									nonConstArgs = append(nonConstArgs, fa)
								}
							}
							_ => {
								nonConstArgs = append(nonConstArgs, fa)
							}
						}
					}
					if len(nonConstArgs) == 0 {
						return mkBoolConst(false)
					}
					if len(nonConstArgs) == 1 {
						return nonConstArgs[0]
					}
					return Expr.BoolExpr(BoolExpr{Op: BoolOp.Or, Args: nonConstArgs, Type: be.Type})
				}
				Not => {
					if len(foldedArgs) == 1 {
						match foldedArgs[0] {
							Const(lit) => {
								if !types.IsNull(lit.Value) {
									let b = lit.Value.Text() == "t" || lit.Value.Text() == "true"
									return mkBoolConst(!b)
								}
							}
							_ => {}
						}
					}
					return Expr.BoolExpr(BoolExpr{Op: BoolOp.Not, Args: foldedArgs, Type: be.Type})
				}
			}
		}
		OpCall(op) => {
						mut foldedArgs = []Expr{}
			mut allConst = true
			for a in op.Args {
								let fa = foldExpr(a)
								foldedArgs = append(foldedArgs, fa)
				match fa {
					Const(_) => {}
					_ => { allConst = false }
				}
			}
						if allConst && len(foldedArgs) == 2 {
				mut leftVal = types.Null()
				match foldedArgs[0] {
					Const(l) => { leftVal = l.Value }
					_ => {}
				}
								mut rightVal = types.Null()
				match foldedArgs[1] {
					Const(r) => { rightVal = r.Value }
					_ => {}
				}
								let lookedUp = types.LookupFunc(op.Func.Name, []types.Oid{types.Oid(foldedArgs[0].Type()), types.Oid(foldedArgs[1].Type())})
				if let lf = lookedUp {
					let res = lf.Call([]types.Datum{leftVal, rightVal}) catch _ {
						return Expr.OpCall(OpCallExpr{Op: op.Op, Func: op.Func, Args: foldedArgs, Type: op.Type})
					}
					return mkConstExpr(res, op.Type)
				}
			}
			return Expr.OpCall(OpCallExpr{Op: op.Op, Func: op.Func, Args: foldedArgs, Type: op.Type})
		}
		_ => { return expr }
	}
	return expr
}

// splitConjunction flattens an expression across top-level ANDs.
fn splitConjunction(expr ?Expr) []Expr {
	if let unwrapped = expr {
		match unwrapped {
			BoolExpr(b) => {
				if b.Op == BoolOp.And {
					mut out = []Expr{}
					for a in b.Args {
						let sub = splitConjunction(a)
						for s in sub {
							out = append(out, s)
						}
					}
					return out
				}
				return []Expr{unwrapped}
			}
			_ => {
				return []Expr{unwrapped}
			}
		}
	}
	return []Expr{}
}

// combineConjunction merges a list of predicates into an AND expression.
fn combineConjunction(quals []Expr) ?Expr {
	if len(quals) == 0 {
		return nil
	}
	if len(quals) == 1 {
		return quals[0]
	}
	return Expr.BoolExpr(BoolExpr{Op: BoolOp.And, Args: quals, Type: u32(types.BoolOid)})
}

fn exprReferencedRanges(expr Expr) []i64 {
	match expr {
		ColRef(col) => {
			return []i64{col.RangeIndex}
		}
		OpCall(op) => {
			mut out = []i64{}
			for a in op.Args {
				for r in exprReferencedRanges(a) {
					mut found = false
					for existing in out { if existing == r { found = true
break } }
					if !found { out = append(out, r) }
				}
			}
			return out
		}
		FuncCall(fc) => {
			mut out = []i64{}
			for a in fc.Args {
				for r in exprReferencedRanges(a) {
					mut found = false
					for existing in out { if existing == r { found = true
break } }
					if !found { out = append(out, r) }
				}
			}
			return out
		}
		BoolExpr(be) => {
			mut out = []i64{}
			for a in be.Args {
				for r in exprReferencedRanges(a) {
					mut found = false
					for existing in out { if existing == r { found = true
break } }
					if !found { out = append(out, r) }
				}
			}
			return out
		}
		Cast(ce) => {
			return exprReferencedRanges(ce.Arg)
		}
		NullTest(nt) => {
			return exprReferencedRanges(nt.Arg)
		}
		Case(cs) => {
			mut out = []i64{}
			for w in cs.Whens {
				for r in exprReferencedRanges(w.When) {
					mut found = false
					for existing in out { if existing == r { found = true
break } }
					if !found { out = append(out, r) }
				}
				for r in exprReferencedRanges(w.Then) {
					mut found = false
					for existing in out { if existing == r { found = true
break } }
					if !found { out = append(out, r) }
				}
			}
			if let e = cs.Else {
				for r in exprReferencedRanges(e) {
					mut found = false
					for existing in out { if existing == r { found = true
break } }
					if !found { out = append(out, r) }
				}
			}
			return out
		}
		AggRef(ag) => {
			mut out = []i64{}
			for a in ag.Args {
				for r in exprReferencedRanges(a) {
					mut found = false
					for existing in out { if existing == r { found = true
break } }
					if !found { out = append(out, r) }
				}
			}
			return out
		}
		WindowFuncRef(wf) => {
			mut out = []i64{}
			for a in wf.Args {
				for r in exprReferencedRanges(a) {
					mut found = false
					for existing in out { if existing == r { found = true
break } }
					if !found { out = append(out, r) }
				}
			}
			return out
		}
		_ => {
			return []i64{}
		}
	}
}

fn isSingleTableQual(expr Expr, rangeIndex i64) bool {
	let ranges = exprReferencedRanges(expr)
	if len(ranges) == 0 { return true }
	if len(ranges) == 1 && ranges[0] == rangeIndex { return true }
	return false
}

// PlanQuery converts an AnalyzedQuery AST into an optimized physical Plan.
fn PlanQuery(c catalog.Catalog, tx txn.Txn, query mut AnalyzedQuery) !Plan {
	match query.Command {
		"SELECT" => {
			return try planSelect(c, tx, mut query)
		}
		"INSERT" => {
			return try planInsert(c, tx, mut query)
		}
		"UPDATE" => {
			return try planUpdate(c, tx, mut query)
		}
		"DELETE" => {
			return try planDelete(c, tx, mut query)
		}
		_ => {
			return Plan.Result(ResultNode{
				Exprs: []Expr{},
				Filter: nil,
				Cols: []ColDesc{},
				Cost: Cost{Startup: 0.0, Total: 0.01, Rows: 1.0, Width: 0},
			})
		}
	}
}

fn planSelect(c catalog.Catalog, tx txn.Txn, query mut AnalyzedQuery) !Plan {
	mut foldedWhere ?Expr = nil
	if let w = query.Where {
		foldedWhere = foldExpr(w)
	}
	let allQuals = splitConjunction(foldedWhere)

	// 1. Plan FROM clause
	mut planNode ?Plan = nil
	if len(query.From) == 0 {
		// Zero-table query: e.g. SELECT 1 + 2
		mut projExprs = []Expr{}
		mut outCols = []ColDesc{}
		for target in query.Targets {
			projExprs = append(projExprs, foldExpr(target.Expr))
			outCols = append(outCols, target.Col)
		}
		return Plan.Result(ResultNode{
			Exprs: projExprs,
			Filter: foldedWhere,
			Cols: outCols,
			Cost: Cost{Startup: 0.0, Total: 0.01, Rows: 1.0, Width: 8},
		})
	} else if len(query.From) == 1 {
		planNode = try planFromItem(c, tx, mut query.From[0], allQuals)
	} else {
		// Multi-table FROM (comma joins)
		planNode = try planFromJoinList(c, tx, mut query.From, allQuals)
	}

	mut currentPlan = Plan.Result(ResultNode{
		Exprs: []Expr{},
		Filter: nil,
		Cols: []ColDesc{},
		Cost: Cost{Startup: 0.0, Total: 0.01, Rows: 1.0, Width: 0},
	})
	if let p = planNode {
		currentPlan = p
	}

	// 2. Aggregates / Group By
	mut aggregatedPlan = currentPlan
	if query.HasAggs || len(query.GroupBy) > 0 {
		mut grpKeys = []Expr{}
		for g in query.GroupBy {
			grpKeys = append(grpKeys, foldExpr(g))
		}
		mut aggRefs = []AggRefExpr{}
		for target in query.Targets {
					for r in findAggRefs(target.Expr) {
			mut found = false
			for existing in aggRefs { if existing.Slot == r.Slot { found = true
break } }
			if !found { aggRefs = append(aggRefs, r) }
		}
		}
		let numAggs = i64(len(aggRefs))
		let aggCost = costAgg(currentPlan.Cost(), currentPlan.Cost().Rows, 1.0, numAggs, currentPlan.Cost().Width)
		// Sorted aggregation when the input already arrives ordered on the group
		// keys (single pass, no hash table); otherwise hash aggregation.
		mut groupSortKeys = []SortKey{}
		for g in grpKeys {
			groupSortKeys = append(groupSortKeys, SortKey{Expr: g, Descending: false, NullsFirst: false})
		}
		if len(grpKeys) > 0 && planProvidesOrder(currentPlan, groupSortKeys) {
			aggregatedPlan = Plan.GroupAgg(GroupAggNode{
				Input: currentPlan,
				GroupKeys: grpKeys,
				Aggs: aggRefs,
				Cols: currentPlan.Cols(),
				Cost: aggCost,
			})
		} else {
			aggregatedPlan = Plan.HashAgg(HashAggNode{
				Input: currentPlan,
				GroupKeys: grpKeys,
				Aggs: aggRefs,
				Cols: currentPlan.Cols(),
				Cost: aggCost,
			})
		}
	}

	// 3. HAVING
	mut havingPlan = aggregatedPlan
	if let h = query.Having {
		let foldedHaving = foldExpr(h)
		let cost = Cost{
			Startup: havingPlan.Cost().Startup,
			Total: havingPlan.Cost().Total + havingPlan.Cost().Rows * CpuOperatorCost,
			Rows: havingPlan.Cost().Rows * 0.5,
			Width: havingPlan.Cost().Width,
		}
		havingPlan = Plan.Filter(FilterNode{
			Input: havingPlan,
			Predicate: foldedHaving,
			Cols: havingPlan.Cols(),
			Cost: cost,
		})
	}

	// 4. Projection
	mut projExprs = []Expr{}
	mut outCols = []ColDesc{}
	for target in query.Targets {
		projExprs = append(projExprs, foldExpr(target.Expr))
		outCols = append(outCols, target.Col)
	}
	let projCost = Cost{
		Startup: havingPlan.Cost().Startup,
		Total: havingPlan.Cost().Total + havingPlan.Cost().Rows * CpuTupleCost,
		Rows: havingPlan.Cost().Rows,
		Width: i64(len(outCols) * 8),
	}
	// Drop a trivial identity projection (every output column is the input column
	// at the same position) so single-table queries explain like PostgreSQL's.
	mut projectedPlan = Plan.Project(ProjectNode{
		Input: havingPlan,
		Exprs: projExprs,
		Cols: outCols,
		Cost: projCost,
	})
	if isIdentityProjection(projExprs, havingPlan.Cols()) {
		projectedPlan = havingPlan
	}

	// 5. DISTINCT
	mut distinctPlan = projectedPlan
	if query.Distinct {
		let dCost = Cost{
			Startup: projectedPlan.Cost().Total,
			Total: projectedPlan.Cost().Total + projectedPlan.Cost().Rows * CpuTupleCost,
			Rows: projectedPlan.Cost().Rows * 0.8,
			Width: projectedPlan.Cost().Width,
		}
		distinctPlan = Plan.Unique(UniqueNode{
			Input: projectedPlan,
			Cols: outCols,
			Cost: dCost,
		})
	}

	// 6. ORDER BY (top-N when a constant LIMIT bounds the sort)
	let topN = exprConstInt(query.Limit)
	mut sortedPlan = distinctPlan
	if len(query.OrderBy) > 0 {
		mut sortKeys = []SortKey{}
		for k in query.OrderBy {
			sortKeys = append(sortKeys, SortKey{
				Expr: foldExpr(k.Expr),
				Descending: k.Descending,
				NullsFirst: k.NullsFirst,
			})
		}
		let sCost = costSort(distinctPlan.Cost(), distinctPlan.Cost().Rows, distinctPlan.Cost().Width)
		sortedPlan = Plan.Sort(SortNode{
			Input: distinctPlan,
			Keys: sortKeys,
			Limit: topN,
			Cols: outCols,
			Cost: sCost,
		})
	}

	// 7. LIMIT / OFFSET
	mut finalPlan = sortedPlan
	if query.Limit != nil || query.Offset != nil {
		mut foldedLimit ?Expr = nil
		if let l = query.Limit { foldedLimit = foldExpr(l) }
		mut foldedOffset ?Expr = nil
		if let o = query.Offset { foldedOffset = foldExpr(o) }
		finalPlan = Plan.Limit(LimitNode{
			Input: sortedPlan,
			Count: foldedLimit,
			Offset: foldedOffset,
			Cols: outCols,
			Cost: sortedPlan.Cost(),
		})
	}

	return finalPlan
}

// exprConstInt returns the non-negative integer value of a constant expression,
// or -1 when it is absent or not a constant integer.
fn exprConstInt(e ?Expr) i64 {
	if let x = e {
		match x {
			Const(c) => {
				if types.IsNull(c.Value) { return -1 }
				let n = mint.Atoi(c.Value.Text()) catch _ { return -1 }
				if n < 0 { return -1 }
				return n
			}
			_ => { return -1 }
		}
	}
	return -1
}

// sameSimpleExpr reports whether two expressions are structurally identical for
// the leaf forms that order-key comparison needs.
fn sameSimpleExpr(a Expr, b Expr) bool {
	match a {
		ColRef(ca) => {
			match b {
				ColRef(cb) => { return ca.Slot == cb.Slot && ca.RangeIndex == cb.RangeIndex }
				_ => { return false }
			}
		}
		Const(ca) => {
			match b {
				Const(cb) => { return ca.Value.Oid() == cb.Value.Oid() && ca.Value.Text() == cb.Value.Text() }
				_ => { return false }
			}
		}
		OpCall(oa) => {
			match b {
				OpCall(ob) => {
					if oa.Op != ob.Op || len(oa.Args) != len(ob.Args) { return false }
					for i in 0..len(oa.Args) {
						if !sameSimpleExpr(oa.Args[i], ob.Args[i]) { return false }
					}
					return true
				}
				_ => { return false }
			}
		}
		_ => { return false }
	}
	return false
}

// planProvidesOrder reports whether a plan's output is already sorted on the
// requested keys (a prefix match of an existing Sort node's keys).
fn planProvidesOrder(p Plan, wanted []SortKey) bool {
	match p {
		Sort(n) => {
			if len(n.Keys) < len(wanted) { return false }
			for i, w in wanted {
				if n.Keys[i].Descending != w.Descending { return false }
				if !sameSimpleExpr(n.Keys[i].Expr, w.Expr) { return false }
			}
			return true
		}
		_ => { return false }
	}
}

// isIdentityProjection reports whether exprs is exactly the input columns in order.
fn isIdentityProjection(exprs []Expr, inputCols []ColDesc) bool {
	if len(exprs) != len(inputCols) { return false }
	for i, e in exprs {
		match e {
			ColRef(c) => {
				if c.Slot != i64(i) { return false }
			}
			_ => { return false }
		}
	}
	return true
}

fn findAggRefs(expr Expr) []AggRefExpr {
	match expr {
		AggRef(ag) => {
			return []AggRefExpr{ag}
		}
		OpCall(op) => {
			mut out = []AggRefExpr{}
			for a in op.Args {
				for r in findAggRefs(a) {
					mut found = false
					for existing in out { if existing.Slot == r.Slot { found = true
break } }
					if !found { out = append(out, r) }
				}
			}
			return out
		}
		FuncCall(fc) => {
			mut out = []AggRefExpr{}
			for a in fc.Args {
				for r in findAggRefs(a) {
					mut found = false
					for existing in out { if existing.Slot == r.Slot { found = true
break } }
					if !found { out = append(out, r) }
				}
			}
			return out
		}
		BoolExpr(be) => {
			mut out = []AggRefExpr{}
			for a in be.Args {
				for r in findAggRefs(a) {
					mut found = false
					for existing in out { if existing.Slot == r.Slot { found = true
break } }
					if !found { out = append(out, r) }
				}
			}
			return out
		}
		Cast(ce) => {
			return findAggRefs(ce.Arg)
		}
		Case(cs) => {
			mut out = []AggRefExpr{}
			for w in cs.Whens {
				for r in findAggRefs(w.When) {
					mut found = false
					for existing in out { if existing.Slot == r.Slot { found = true
break } }
					if !found { out = append(out, r) }
				}
				for r in findAggRefs(w.Then) {
					mut found = false
					for existing in out { if existing.Slot == r.Slot { found = true
break } }
					if !found { out = append(out, r) }
				}
			}
			if let e = cs.Else {
				for r in findAggRefs(e) {
					mut found = false
					for existing in out { if existing.Slot == r.Slot { found = true
break } }
					if !found { out = append(out, r) }
				}
			}
			return out
		}
		_ => {
			return []AggRefExpr{}
		}
	}
}

// concatI64 copies two i64 slices into one.
fn concatI64(a []i64, b []i64) []i64 {
	mut out = []i64{}
	for x in a { out = append(out, x) }
	for x in b { out = append(out, x) }
	return out
}

// concatColDesc copies two column-descriptor slices into one.
fn concatColDesc(a []ColDesc, b []ColDesc) []ColDesc {
	mut out = []ColDesc{}
	for x in a { out = append(out, x) }
	for x in b { out = append(out, x) }
	return out
}

// fromItemRanges returns the range-table indices a FROM item provides.
fn fromItemRanges(item FromClauseItem) []i64 {
	match item {
		Table(t) => { return []i64{t.RangeIndex} }
		Subquery(s) => { return []i64{s.RangeIndex} }
		Values(v) => { return []i64{v.RangeIndex} }
		Function(f) => { return []i64{f.RangeIndex} }
		Join(j) => { return concatI64(fromItemRanges(j.Left), fromItemRanges(j.Right)) }
	}
	return []i64{}
}

// rangesContain reports whether set contains every element of want.
fn rangesContain(set []i64, want []i64) bool {
	for w in want {
		mut found = false
		for x in set {
			if x == w {
				found = true
				break
			}
		}
		if !found { return false }
	}
	return true
}

// rangesOverlap reports whether the two sets share an element.
fn rangesOverlap(a []i64, b []i64) bool {
	for x in a {
		for y in b {
			if x == y { return true }
		}
	}
	return false
}

// exprSide classifies an expression by which side of a join it references.
// 1 = left only, 2 = right only, 0 = neither or both.
fn exprSide(e Expr, left []i64, right []i64) i64 {
	let refs = exprReferencedRanges(e)
	mut anyLeft = false
	mut anyRight = false
	for r in refs {
		mut inLeft = false
		for l in left {
			if l == r {
				inLeft = true
				break
			}
		}
		mut inRight = false
		for rr in right {
			if rr == r {
				inRight = true
				break
			}
		}
		if inLeft { anyLeft = true }
		if inRight { anyRight = true }
		if !inLeft && !inRight { return 0 }
	}
	if anyLeft && anyRight { return 0 }
	if anyLeft { return 1 }
	if anyRight { return 2 }
	return 0
}

// applicableJoinQuals selects quals that connect the current relation set to a
// new relation and become fully evaluable once it joins.
fn applicableJoinQuals(quals []Expr, current []i64, candidate []i64) []Expr {
	mut out = []Expr{}
	for q in quals {
		let refs = exprReferencedRanges(q)
		if !rangesOverlap(refs, candidate) { continue }
		if !rangesContain(concatI64(current, candidate), refs) { continue }
		out = append(out, q)
	}
	return out
}

// planJoinPair builds a join node for two inputs, choosing a hash join when an
// equality connecting the two sides exists, otherwise a nested loop.
fn planJoinPair(left Plan, leftRanges []i64, right Plan, rightRanges []i64, quals []Expr, jt JoinType) Plan {
	mut leftKeys = []Expr{}
	mut rightKeys = []Expr{}
	mut rest = []Expr{}
	mut hasEqui = false
	for q in quals {
		mut handled = false
		match q {
			OpCall(op) => {
				if op.Op == "=" && len(op.Args) == 2 {
					let aSide = exprSide(op.Args[0], leftRanges, rightRanges)
					let bSide = exprSide(op.Args[1], leftRanges, rightRanges)
					if aSide == 1 && bSide == 2 {
						leftKeys = append(leftKeys, op.Args[0])
						rightKeys = append(rightKeys, op.Args[1])
						hasEqui = true
						handled = true
					} else if aSide == 2 && bSide == 1 {
						leftKeys = append(leftKeys, op.Args[1])
						rightKeys = append(rightKeys, op.Args[0])
						hasEqui = true
						handled = true
					}
				}
			}
			_ => {}
		}
		if !handled { rest = append(rest, q) }
	}
	let outRows = left.Cost().Rows * right.Cost().Rows * 0.1 + 1.0
	let width = left.Cost().Width + right.Cost().Width
	let cols = concatColDesc(left.Cols(), right.Cols())
	if hasEqui {
		let cost = costHashJoin(left.Cost(), right.Cost(), outRows, width)
		return Plan.HashJoin(HashJoinNode{
			Left: left,
			Right: right,
			JoinType: jt,
			LeftKeys: leftKeys,
			RightKeys: rightKeys,
			Quals: rest,
			Cols: cols,
			Cost: cost,
		})
	}
	let cost = costNestLoop(left.Cost(), right.Cost(), outRows, width)
	return Plan.NestLoop(NestLoopNode{
		Left: left,
		Right: right,
		JoinType: jt,
		Quals: rest,
		Cols: cols,
		Cost: cost,
	})
}

fn planFromItem(c catalog.Catalog, tx txn.Txn, item mut FromClauseItem, allQuals []Expr) !Plan {
	match item {
		Table(tbl) => {
			return try planTableScan(c, tx, tbl, allQuals)
		}
		Subquery(sub) => {
			mut subQuery = sub.Query
			let subPlan = try PlanQuery(c, tx, mut subQuery)
			return subPlan
		}
		Values(v) => {
			mut foldedRows = [][]Expr{}
			for row in v.Rows {
				mut fRow = []Expr{}
				for cell in row {
					fRow = append(fRow, foldExpr(cell))
				}
				foldedRows = append(foldedRows, fRow)
			}
			let cost = Cost{
				Startup: 0.0,
				Total: f64(len(v.Rows)) * CpuTupleCost,
				Rows: f64(len(v.Rows)),
				Width: i64(len(v.Cols) * 8),
			}
			return Plan.Values(ValuesNode{
				Rows: foldedRows,
				Cols: v.Cols,
				Cost: cost,
			})
		}
		Join(j) => {
			mut leftItem = j.Left
			let leftPlan = try planFromItem(c, tx, mut leftItem, allQuals)
			mut rightItem = j.Right
			let rightPlan = try planFromItem(c, tx, mut rightItem, allQuals)
			let leftRanges = fromItemRanges(j.Left)
			let rightRanges = fromItemRanges(j.Right)
			mut joinQuals = []Expr{}
			for q in j.Quals {
				joinQuals = append(joinQuals, foldExpr(q))
			}
			return planJoinPair(leftPlan, leftRanges, rightPlan, rightRanges, joinQuals, j.JoinType)
		}
		Function(_) => {
			return Plan.Result(ResultNode{
				Exprs: []Expr{},
				Filter: nil,
				Cols: []ColDesc{},
				Cost: Cost{Startup: 0.0, Total: 0.01, Rows: 1.0, Width: 0},
			})
		}
	}
}

// planFromJoinList orders comma-separated FROM items greedily: it starts from
// the cheapest relation and repeatedly adds the relation whose join is cheapest,
// pushing each WHERE qual into the join that first makes it evaluable.
fn planFromJoinList(c catalog.Catalog, tx txn.Txn, items mut []FromClauseItem, allQuals []Expr) !Plan {
	mut plans = []Plan{}
	mut ranges = [][]i64{}
	for item in items {
		let p = try planFromItem(c, tx, mut item, allQuals)
		plans = append(plans, p)
		ranges = append(ranges, fromItemRanges(item))
	}

	mut joinQuals = []Expr{}
	for q in allQuals {
		if len(exprReferencedRanges(q)) > 1 {
			joinQuals = append(joinQuals, foldExpr(q))
		}
	}

	if len(plans) == 0 {
		return Plan.Result(ResultNode{Exprs: []Expr{}, Filter: nil, Cols: []ColDesc{}, Cost: Cost{Startup: 0.0, Total: 0.01, Rows: 1.0, Width: 0}})
	}

	mut start = 0
	for i in 1..len(plans) {
		if plans[i].Cost().Total < plans[start].Cost().Total {
			start = i
		}
	}
	mut current = plans[start]
	mut currentRanges = ranges[start]
	mut remaining = []i64{}
	for i in 0..len(plans) {
		if i != start { remaining = append(remaining, i64(i)) }
	}

	for len(remaining) > 0 {
		mut bestPos = 0
		mut bestPlan = plans[remaining[0]]
		mut bestRanges = ranges[remaining[0]]
		mut bestQuals = []Expr{}
		mut bestCost = -1.0
		for pos, j in remaining {
			let applicable = applicableJoinQuals(joinQuals, currentRanges, ranges[j])
			let cand = planJoinPair(current, currentRanges, plans[j], ranges[j], applicable, JoinType.Inner)
			if bestCost < 0.0 || cand.Cost().Total < bestCost {
				bestCost = cand.Cost().Total
				bestPos = pos
				bestPlan = plans[j]
				bestRanges = ranges[j]
				bestQuals = applicable
			}
		}
		current = planJoinPair(current, currentRanges, bestPlan, bestRanges, bestQuals, JoinType.Inner)
		for r in bestRanges {
			currentRanges = append(currentRanges, r)
		}
		mut newRemaining = []i64{}
		for pos, j in remaining {
			if pos != bestPos { newRemaining = append(newRemaining, j) }
		}
		remaining = newRemaining
	}
	return current
}

// --- Index selection ---------------------------------------------------------

// strHasPrefix reports whether s starts with p.
fn strHasPrefix(s str, p str) bool {
	return len(p) <= len(s) && s[:len(p)] == p
}

// strHasSuffix reports whether s ends with p.
fn strHasSuffix(s str, p str) bool {
	return len(p) <= len(s) && s[len(s)-len(p):] == p
}

// inferIndexColumns recovers an index's key columns from its name. The catalog
// Index carries no column list, so plan/ uses the PostgreSQL naming convention
// <table>_<col>[_<col>...][_pkey|_key|_idx|_index|_unique]: the leading table
// name and one trailing suffix are stripped, then column names are consumed
// left to right. A "...._pkey" index with no decodable key falls back to the
// table's leading column (the primary key).
fn inferIndexColumns(idx catalog.Index, tbl catalog.Table) []str {
	mut rest = idx.Name
	if strHasPrefix(rest, tbl.Name + "_") {
		rest = rest[len(tbl.Name)+1:]
	}
	for suffix in []str{"_pkey", "_unique", "_index", "_idx", "_key"} {
		if strHasSuffix(rest, suffix) {
			rest = rest[:len(rest)-len(suffix)]
			break
		}
	}
	mut cols = []str{}
	mut remaining = rest
	for col in tbl.Cols {
		if remaining == col.Name {
			cols = append(cols, col.Name)
			remaining = ""
		} else if strHasPrefix(remaining, col.Name + "_") {
			cols = append(cols, col.Name)
			remaining = remaining[len(col.Name)+1:]
		}
	}
	if len(cols) == 0 && (strHasSuffix(idx.Name, "_pkey") || strHasSuffix(idx.Name, "_key")) {
		if len(tbl.Cols) > 0 {
			cols = append(cols, tbl.Cols[0].Name)
		}
	}
	return cols
}

// tableColAttno returns the 1-based attribute number of a named table column.
fn tableColAttno(tbl catalog.Table, name str) (i16, bool) {
	for col in tbl.Cols {
		if col.Name == name {
			return col.Number, true
		}
	}
	return 0, false
}

// isIndexOp reports whether op can be used as a B-tree index qualification.
fn isIndexOp(op str) bool {
	return op == "=" || op == "<" || op == "<=" || op == ">" || op == ">="
}

// defaultSelectivity mirrors PostgreSQL's default operator selectivities.
fn defaultSelectivity(op str) f64 {
	if op == "=" { return 0.005 }
	if op == "<" || op == ">" || op == "<=" || op == ">=" { return 0.3333 }
	if op == "<>" { return 0.995 }
	return 0.5
}

// matchIndexQuals pairs index columns with equality/range quals on a table scan.
// It returns the matched quals (as Index Cond), their bounds, and the leftover
// quals that must still be applied as a filter. Matching stops at the first
// index column with no qual, so only a usable key prefix is consumed.
fn matchIndexQuals(idxCols []str, tbl catalog.Table, quals []Expr) ([]Expr, []IndexBound, []Expr) {
	mut used = make([]bool, len(quals))
	mut usedQuals = []Expr{}
	mut bounds = []IndexBound{}
	for i, colName in idxCols {
		let (attno, ok) = tableColAttno(tbl, colName)
		if !ok { break }
		mut found = false
		for qi, q in quals {
			if used[qi] || found { continue }
			match q {
				OpCall(op) => {
					if len(op.Args) == 2 && isIndexOp(op.Op) {
						match op.Args[0] {
							ColRef(c) => {
								if c.AttNo == attno {
									used[qi] = true
									usedQuals = append(usedQuals, q)
									bounds = append(bounds, IndexBound{
										Col: i,
										Op: op.Op,
										Value: op.Args[1],
										Inclusive: op.Op == "=" || op.Op == "<=" || op.Op == ">=",
									})
									found = true
								}
							}
							_ => {}
						}
					}
				}
				_ => {}
			}
		}
		if !found { break }
	}
	mut remaining = []Expr{}
	for qi, q in quals {
		if !used[qi] { remaining = append(remaining, q) }
	}
	return usedQuals, bounds, remaining
}

// estimateIndexRows estimates the rows returned for a matched index prefix.
fn estimateIndexRows(baseRows f64, bounds []IndexBound, unique bool) f64 {
	mut rows = baseRows
	mut allEquality = len(bounds) > 0
	for b in bounds {
		rows *= defaultSelectivity(b.Op)
		if b.Op != "=" { allEquality = false }
	}
	if allEquality && unique && len(bounds) > 0 {
		return 1.0
	}
	if rows < 1.0 { rows = 1.0 }
	return rows
}

fn planTableScan(c catalog.Catalog, tx txn.Txn, tbl FromTable, allQuals []Expr) !Plan {
	mut tableQuals = []Expr{}
	for q in allQuals {
		if isSingleTableQual(q, tbl.RangeIndex) {
			tableQuals = append(tableQuals, foldExpr(q))
		}
	}

	let catTable = c.LookupTable(tx, tbl.Schema, tbl.Name)
	let width = i64(len(tbl.Cols) * 8)
	let baseRows = 100.0

	if let t = catTable {
		let seqCost = costSeqScan(baseRows, width, i64(len(tableQuals)))

		// Primary-key point lookup fast path: a unique index whose whole key is
		// matched by equality is always an Index Scan (pgbench-style lookups).
		for idx in t.Indexes {
			let idxCols = inferIndexColumns(idx, t)
			if len(idxCols) == 0 { continue }
			let (usedQuals, bounds, remaining) = matchIndexQuals(idxCols, t, tableQuals)
			if len(usedQuals) == 0 { continue }
			let rows = estimateIndexRows(baseRows, bounds, idx.Unique)
			let idxCost = costIndexScan(rows, width, i64(len(usedQuals)), idx.Unique)
			let filterCond = combineConjunction(remaining)
			mut plan = Plan.IndexScan(IndexScanNode{
				Table: t,
				Index: idx,
				Bounds: bounds,
				Quals: usedQuals,
				Direction: ScanDirection.Forward,
				Filter: filterCond,
				Cols: tbl.Cols,
				Cost: idxCost,
			})
			if idx.Unique && len(usedQuals) == len(idxCols) && rows <= 1.0 {
				return plan
			}
			if idxCost.Total < seqCost.Total {
				return plan
			}
		}

		let filterCond = combineConjunction(tableQuals)
		return Plan.SeqScan(SeqScanNode{
			Table: t,
			Filter: filterCond,
			Projection: []Expr{},
			Cols: tbl.Cols,
			Cost: seqCost,
		})
	}

	fail types.ErrorFault(types.NewError("42P01", "relation \"" + tbl.Name + "\" does not exist"))
}

// dmlTargetTable returns the single target relation of a DML query.
fn dmlTargetTable(c catalog.Catalog, tx txn.Txn, query AnalyzedQuery, verb str) !catalog.Table {
	if len(query.From) == 0 {
		fail types.ErrorFault(types.NewError("42P01", "missing target table for " + verb))
	}
	match query.From[0] {
		Table(t) => {
			if let catTable = c.LookupTable(tx, t.Schema, t.Name) {
				return catTable
			}
		}
		_ => {}
	}
	fail types.ErrorFault(types.NewError("42P01", "invalid target table for " + verb))
}

fn planInsert(c catalog.Catalog, tx txn.Txn, query mut AnalyzedQuery) !Plan {
	let catTable = try dmlTargetTable(c, tx, query, "INSERT")

	mut source = Plan.Result(ResultNode{Exprs: []Expr{}, Filter: nil, Cols: []ColDesc{}, Cost: Cost{Startup: 0.0, Total: 0.01, Rows: 1.0, Width: 0}})
	if len(query.InsertRows) > 0 {
		mut rowsCols = []ColDesc{}
		for j, attno in query.InsertCols {
			mut cd = ColDesc{Name: "column", Oid: types.Int4Oid, Typmod: -1, TableOid: 0, Attno: i16(j + 1), RangeIndex: 0, SourceName: ""}
			for col in catTable.Cols {
				if col.Number == attno {
					cd = ColDesc{Name: col.Name, Oid: col.Type, Typmod: col.Typmod, TableOid: catTable.Oid, Attno: col.Number, RangeIndex: 0, SourceName: catTable.Name}
				}
			}
			rowsCols = append(rowsCols, cd)
		}
		source = Plan.Values(ValuesNode{
			Rows: query.InsertRows,
			Cols: rowsCols,
			Cost: Cost{Startup: 0.0, Total: f64(len(query.InsertRows)) * CpuTupleCost, Rows: f64(len(query.InsertRows)), Width: i64(len(rowsCols) * 8)},
		})
	} else if query.HasInsertQuery {
		if let sq = query.InsertQuery {
			mut q = sq
			source = try PlanQuery(c, tx, mut q)
		}
	}

	return Plan.ModifyTable(ModifyTableNode{
		Kind: ModifyKind.Insert,
		Table: catTable,
		Source: source,
		TargetCols: query.InsertCols,
		OnConflict: query.OnConflict,
		Returning: query.Returning,
		Cols: query.ReturningCols,
		Cost: Cost{Startup: 0.0, Total: 1.0, Rows: 1.0, Width: 0},
	})
}

fn planUpdate(c catalog.Catalog, tx txn.Txn, query mut AnalyzedQuery) !Plan {
	let catTable = try dmlTargetTable(c, tx, query, "UPDATE")

	mut foldedWhere ?Expr = nil
	if let w = query.Where {
		foldedWhere = foldExpr(w)
	}
	let allQuals = splitConjunction(foldedWhere)
	mut item = query.From[0]
	let scan = try planFromItem(c, tx, mut item, allQuals)

	// The update source emits one full table row per matched row: SET expressions
	// replace their columns, all other columns pass through.
	mut exprs = []Expr{}
	for i, col in catTable.Cols {
		mut replaced = false
		for j, attno in query.SetCols {
			if i64(attno) == i64(col.Number) && j < len(query.SetExprs) {
				exprs = append(exprs, query.SetExprs[j])
				replaced = true
				break
			}
		}
		if !replaced {
			exprs = append(exprs, Expr.ColRef(ColRefExpr{Slot: i64(i), RangeIndex: 1, AttNo: col.Number, Type: col.Type}))
		}
	}
	let source = Plan.Project(ProjectNode{
		Input: scan,
		Exprs: exprs,
		Cols: scan.Cols(),
		Cost: scan.Cost(),
	})

	return Plan.ModifyTable(ModifyTableNode{
		Kind: ModifyKind.Update,
		Table: catTable,
		Source: source,
		TargetCols: query.SetCols,
		OnConflict: nil,
		Returning: query.Returning,
		Cols: query.ReturningCols,
		Cost: Cost{Startup: 0.0, Total: 1.0, Rows: 1.0, Width: 0},
	})
}

fn planDelete(c catalog.Catalog, tx txn.Txn, query mut AnalyzedQuery) !Plan {
	let catTable = try dmlTargetTable(c, tx, query, "DELETE")

	mut foldedWhere ?Expr = nil
	if let w = query.Where {
		foldedWhere = foldExpr(w)
	}
	let allQuals = splitConjunction(foldedWhere)
	mut item = query.From[0]
	let scan = try planFromItem(c, tx, mut item, allQuals)

	return Plan.ModifyTable(ModifyTableNode{
		Kind: ModifyKind.Delete,
		Table: catTable,
		Source: scan,
		TargetCols: []i16{},
		OnConflict: nil,
		Returning: query.Returning,
		Cols: query.ReturningCols,
		Cost: Cost{Startup: 0.0, Total: 1.0, Rows: 1.0, Width: 0},
	})
}
