package store

import "lane"
import "quarry"

// Package store owns durable relation pages and their WAL. A content latch protects only a short,
// synchronous page access; no latch is held across an await, a wait or another page's load, and
// Store is core-local (cross-core callers route through relay). The buffer pool is the only path
// from Store operations to page bytes: every read and write goes through it, and a page is written
// to its relation file only after the WAL record that produced its LSN is fsynced.

type Tid struct {
	page u32
	slot u16
}

// NewTid constructs a tuple identifier.
fn NewTid(page PageNo, slot u16) Tid {
	return Tid{page: u32(page), slot: slot}
}

// Page returns the block number of the TID.
fn (t Tid) Page() PageNo {
	return PageNo(t.page)
}

// Slot returns the one-based line-pointer number of the TID.
fn (t Tid) Slot() u16 {
	return t.slot
}

type XidCtx struct {
	xid u32
	cid u32
}

// NewXidCtx constructs the transaction identity attached to a tuple write.
fn NewXidCtx(xid u32, cid u32) XidCtx {
	return XidCtx{xid: xid, cid: cid}
}

// Xid returns the transaction id.
fn (x XidCtx) Xid() u32 {
	return x.xid
}

// Cid returns the command id.
fn (x XidCtx) Cid() u32 {
	return x.cid
}

type Options struct {
	BufferPages i64
	SharedBuffersBytes i64
	WalRingBytes i64
	SyncOnWrite bool
}

type TupleHeader struct {
	xmin u32
	xmax u32
	cid u32
	infomask u16
	ctid Tid
}

// Xmin returns the inserting transaction id.
fn (h TupleHeader) Xmin() u32 {
	return h.xmin
}

// Xmax returns the deleting transaction id, or zero.
fn (h TupleHeader) Xmax() u32 {
	return h.xmax
}

// Cid returns the command id that inserted the row.
fn (h TupleHeader) Cid() u32 {
	return h.cid
}

// Infomask returns tuple visibility hints.
fn (h TupleHeader) Infomask() u16 {
	return h.infomask
}

// Ctid returns the tuple's current TID.
fn (h TupleHeader) Ctid() Tid {
	return h.ctid
}

type HeapTuple struct {
	Header TupleHeader
	Tid Tid
	Payload []u8
}

// RecordRedo is a registered WAL record kind and its redo callback.
type RecordRedo struct {
	kind u8
	name str
	redo fn(rel u32, block u32, slot u16, body []u8) !
}

type Store struct {
	dir str
	opts Options
	files RelationFiles
	buffers BufferPool
	rels map[u32]u8
	freeHint map[u32]u32
	btreeHint map[u32]u64
	kinds map[u8]str
	redos []RecordRedo
	walDir str
	walActiveSeg u64
	walBuf []u8
	lastLsn u64
	writtenLsn u64
	syncedLsn u64
	walGate lane.Lane[u8]
	walFailed bool
	fpiPending map[u64]bool
	checkpointLsn u64
	redoLsn u64
	recovering bool
	closed bool
}

type HeapScan struct {
	tuples []HeapTuple
	pos i64
}

type IndexItem struct {
	key []u8
	tid Tid
}

// Key returns the index key bytes.
fn (item IndexItem) Key() []u8 {
	return item.key
}

// Tid returns the heap TID for this index entry.
fn (item IndexItem) Tid() Tid {
	return item.tid
}

type IndexScan struct {
	items []IndexItem
	pos i64
	backward bool
	err str
}

// Error returns a deferred range-scan error because IndexSeek's fixed contract is not fallible.
fn (scan IndexScan) Error() str {
	return scan.err
}

// Next yields the next index entry.
fn (scan mut IndexScan) Next() (IndexItem, bool) {
	if scan.pos >= len(scan.items) {
		return IndexItem{key: []u8{}, tid: Tid{page: 0, slot: 0}}, false
	}
	let item = scan.items[scan.pos]
	scan.pos += 1
	return item, true
}

// Next yields the next tuple and whether one was present.
fn (scan mut HeapScan) Next() (HeapTuple, bool) {
	if scan.pos >= len(scan.tuples) {
		return HeapTuple{Header: TupleHeader{xmin: 0, xmax: 0, cid: 0, infomask: 0, ctid: Tid{page: 0, slot: 0}}, Tid: Tid{page: 0, slot: 0}, Payload: []u8{}}, false
	}
	let tuple = scan.tuples[scan.pos]
	scan.pos += 1
	return tuple, true
}

// Open initializes the data directory, reads the control file and runs crash recovery before
// returning. Recovery restarts at the last checkpoint's redo LSN, skips pages whose LSN is newer
// than a record's, runs the registered redo callbacks, and truncates the torn WAL tail.
fn Open(dir str, opts Options) !Store {
	try quarry.MkdirAll(dir)
	let walDir = dir + "/wal"
	try quarry.MkdirAll(walDir)
	let baseDir = dir + "/base"
	let hasBase = quarry.Exists(baseDir)
	try quarry.MkdirAll(baseDir)
	let segOne = segmentPath(walDir, 1)
	let hasWal = quarry.Exists(segOne) || hasAnySegment(walDir)
	if !hasWal && hasBase && dirHasEntries(baseDir) {
		fail "store: relation files exist without a WAL"
	}
	if !hasWal {
		try quarry.WriteFile(segOne, "")
		try quarry.Sync(walDir)
	}
	let files = try NewRelationFiles(dir)
	let capacity = try bufferCapacity(opts)
	let buffers = try NewBufferPool(capacity)
	mut walGate = lane.New[u8](1)
	try walGate.Send(1)
	mut s = Store{dir: dir, opts: opts, files: files, buffers: buffers, rels: map[u32]u8{}, freeHint: map[u32]u32{}, btreeHint: map[u32]u64{}, kinds: map[u8]str{}, redos: []RecordRedo{}, walDir: walDir, walActiveSeg: 1, walBuf: make([]u8, 0, walBufBytes), lastLsn: 0, writtenLsn: 0, syncedLsn: 0, walGate: walGate, walFailed: false, fpiPending: map[u64]bool{}, checkpointLsn: 0, redoLsn: 0, recovering: false, closed: false}
	let (redoLsn, _, hasControl) = try s.readControl()
	if hasControl {
		s.redoLsn = redoLsn
	}
	s.recovering = true
	let end = try s.walkWal(s.redoLsn)
	try s.flushBuffers()
	s.recovering = false
	try s.truncateWal(end)
	s.openWalForWrite(end)
	s.fpiPending = map[u64]bool{}
	// Relation-create records before the checkpoint are not replayed, so recover kinds from disk.
	for rel in s.files.List() {
		s.rels[u32(rel)] = try s.detectRelKind(rel)
	}
	return s
}

// detectRelKind reads a relation's first page type; an empty relation is a heap.
fn (s mut Store) detectRelKind(rel RelId) !u8 {
	let count = s.files.PageCount(rel) catch _ { 0 }
	if count == 0 {
		return relKindHeap
	}
	let (frame, page) = try s.pinPage(rel, PageNo(0))
	try s.buffers.LockContent(frame)
	let pt = page.PageType()
	try s.buffers.UnlockContent(frame)
	try s.buffers.Unpin(frame)
	if pt == PageTypeBtreeMeta {
		return relKindBtree
	}
	return relKindHeap
}

// Close runs a shutdown checkpoint and marks the data directory clean.
fn (s mut Store) Close() ! {
	if s.closed {
		return
	}
	try s.flushBuffers()
	let lsn = try s.appendWal(walKindShutdown, 0, 0, 0, 0, []u8{})
	try s.Sync(lsn)
	s.checkpointLsn = u64(lsn)
	s.redoLsn = u64(lsn) - u64(walHeaderSize)
	s.fpiPending = map[u64]bool{}
	try s.writeControl(true)
	s.closed = true
}

// Checkpoint flushes dirty buffers, appends a checkpoint record and updates the control file.
// It must not run concurrently with other Store mutations.
fn (s mut Store) Checkpoint() ! {
	if s.closed {
		return
	}
	try s.flushBuffers()
	try s.Sync(s.CurrentLsn())
	let redo = u64(s.CurrentLsn())
	let lsn = try s.appendWal(walKindCheckpoint, 0, 0, 0, 0, []u8{})
	try s.Sync(lsn)
	s.checkpointLsn = u64(lsn)
	s.redoLsn = redo
	s.fpiPending = map[u64]bool{}
	try s.writeControl(false)
}

// CurrentLsn returns the byte position immediately after the last appended WAL record.
fn (s Store) CurrentLsn() Lsn {
	return Lsn(s.lastLsn)
}

// RedoLsn returns the LSN recovery will restart from.
fn (s Store) RedoLsn() Lsn {
	return Lsn(s.redoLsn)
}

// RegisterRecordKind reserves an extensible kind identifier for a neighbour package.
fn (s mut Store) RegisterRecordKind(kind u8, name str) ! {
	if kind < 16 || len(name) == 0 {
		fail "store: WAL kinds below 16 are reserved"
	}
	let (_, exists) = s.kinds[kind]
	if exists {
		fail "store: WAL record kind is already registered"
	}
	s.kinds[kind] = name
}

// RegisterRecordKindRedo registers a neighbour record kind together with its redo callback; the
// callback runs during a later replay for records of that kind.
fn (s mut Store) RegisterRecordKindRedo(kind u8, name str, redo fn(rel u32, block u32, slot u16, body []u8) !) ! {
	try s.RegisterRecordKind(kind, name)
	s.redos = append(s.redos, RecordRedo{kind: kind, name: name, redo: redo})
}

// LogRecord appends a registered record kind with an opaque payload and returns its ending LSN.
fn (s mut Store) LogRecord(kind u8, payload []u8) !Lsn {
	let (_, registered) = s.kinds[kind]
	if !registered {
		fail "store: WAL record kind is not registered"
	}
	return try s.appendWal(kind, 0, 0, 0, 0, payload)
}

// ReplayRegistered re-runs every replayable record for kinds registered with RegisterRecordKindRedo,
// which lets a neighbour rebuild its own state from the log.
fn (s mut Store) ReplayRegistered() ! {
	_ = try s.walkWal(0)
}

fn (s mut Store) runRegisteredRedo(kind u8, rel u32, block u32, slot u16, body []u8) ! {
	for _, r in s.redos {
		if r.kind == kind {
			try r.redo(rel, block, slot, body)
			return
		}
	}
}

fn (s mut Store) applyWalRecord(kind u8, flags u8, rel u32, block u32, slot u16, body []u8, recStart u64, recEnd u64) ! {
	match kind {
		walKindRelCreate => { try s.redoRelCreate(rel, body, recStart) }
		walKindRelDrop => { try s.redoRelDrop(rel) }
		walKindHeapInsert => { try s.redoHeapInsert(rel, block, slot, flags, body, recStart) }
		walKindHeapDelete, walKindHeapHint => { try s.redoHeapHeader(rel, block, slot, flags, body, recStart) }
		walKindHeapPrune => { try s.redoHeapPrune(rel, block, flags, body, recStart) }
		walKindPageImages => { try s.redoPageImages(rel, body, recStart) }
		walKindBtreeInsert => { try s.redoBtreeInsert(rel, block, body, recStart) }
		walKindBtreeDelete => { try s.redoBtreeDelete(rel, block, body, recStart) }
		walKindCheckpoint => {
			s.checkpointLsn = recEnd
			s.redoLsn = recStart
			s.fpiPending = map[u64]bool{}
		}
		walKindShutdown => { s.checkpointLsn = recEnd }
		_ => { try s.runRegisteredRedo(kind, rel, block, slot, body) }
	}
}

fn (s mut Store) redoRelCreate(rel u32, body []u8, recStart u64) ! {
	if len(body) < 1 {
		fail "store: bad relation-create record"
	}
	let kind = body[0]
	if !s.files.Exists(RelId(rel)) {
		try s.files.Ensure(RelId(rel))
	}
	s.rels[rel] = kind
	if kind == relKindBtree {
		let count = s.files.PageCount(RelId(rel)) catch _ { 0 }
		if count < 2 {
			mut meta = NewPage()
			meta.SetPageType(PageTypeBtreeMeta)
			writeU32(mut meta.Data, 32, 1)
			writeU32(mut meta.Data, 36, 0)
			meta.SetLsn(recStart)
			mut leaf = NewPage()
			leaf.SetPageType(PageTypeBtreeLeaf)
			leaf.SetLsn(recStart)
			try s.files.WritePage(RelId(rel), 0, meta)
			try s.files.WritePage(RelId(rel), 1, leaf)
		}
	}
}

fn (s mut Store) redoRelDrop(rel u32) ! {
	try s.buffers.InvalidateRel(RelId(rel))
	try s.files.Drop(RelId(rel))
	delete(s.rels, rel)
}

// ---- control file ----

const controlMagic u32 = 0x54474e53
const controlBytes i64 = 32

fn (s Store) controlPath() str {
	return s.dir + "/global/control"
}

fn (s mut Store) writeControl(clean bool) ! {
	let dir = s.dir + "/global"
	try quarry.MkdirAll(dir)
	let path = s.controlPath()
	mut b = make([]u8, controlBytes)
	writeU32(mut b, 0, controlMagic)
	writeU32(mut b, 4, 1)
	writeU64(mut b, 8, s.redoLsn)
	writeU64(mut b, 16, s.checkpointLsn)
	if clean {
		writeU32(mut b, 24, 1)
	}
	let tmp = path + ".tmp"
	try quarry.WriteFile(tmp, str(b))
	try quarry.Sync(tmp)
	try quarry.Rename(tmp, path)
	try quarry.Sync(dir)
}

fn (s Store) readControl() !(u64, u64, bool) {
	let path = s.controlPath()
	if !quarry.Exists(path) {
		return 0, 0, false
	}
	let data = try quarry.ReadFile(path)
	if i64(len(data)) < controlBytes {
		return 0, 0, false
	}
	let b = []u8(data)
	if readU32(b, 0) != controlMagic {
		fail "store: control file is not a tingres control file"
	}
	return readU64(b, 8), readU64(b, 16), true
}

fn hasAnySegment(walDir str) bool {
	let names = quarry.ReadDir(walDir) catch _ { return false }
	for _, name in names {
		let (_, ok) = parseSegmentName(name)
		if ok {
			return true
		}
	}
	return false
}

fn dirHasEntries(path str) bool {
	let names = quarry.ReadDir(path) catch _ { return false }
	return len(names) > 0
}

fn bufferCapacity(opts Options) !u32 {
	if opts.BufferPages > 0 {
		if opts.BufferPages > i64(0xffffffff) {
			fail "store: buffer pool is too large"
		}
		return u32(opts.BufferPages)
	}
	mut bytes = opts.SharedBuffersBytes
	if bytes <= 0 {
		bytes = 16*1024*1024
	}
	if bytes < PageSize || bytes%PageSize != 0 || bytes/PageSize > i64(0xffffffff) {
		fail "store: shared_buffers must be a positive multiple of 8 KiB"
	}
	return u32(bytes/PageSize)
}

fn copyBytes(src []u8) []u8 {
	let dst = make([]u8, len(src))
	copy(dst, src)
	return dst
}
