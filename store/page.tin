package store

type RelId = u32
type PageNo = u32


const PageSize = 8192
const pageHeaderSize = 32
const linePointerSize = 8

const PageAllVisible u16 = 0x0001
const PageIsLeaf u16 = 0x0002
const PageIsRoot u16 = 0x0004

const PageTypeHeap u16 = 1
const PageTypeBtreeLeaf u16 = 2
const PageTypeBtreeInternal u16 = 3
const PageTypeBtreeMeta u16 = 4

// Page is an 8 KiB slotted page. The checksum field is zero while hashing.
type Page struct {
	Data []u8
}

// PageHeader is the stable public view of a page header.
type PageHeader struct {
	Lsn u64
	Checksum u32
	Flags u16
	PageType u16
	Lower u16
	Upper u16
	Slots u16
	PrevBlock PageNo
	NextBlock PageNo
}

// NewPage returns an empty page with valid free-space boundaries.
fn NewPage() Page {
	mut p = Page{Data: make([]u8, PageSize)}
	p.Reset()
	return p
}

// Reset clears the reusable page bytes and restores an empty slotted-page header.
fn (p mut Page) Reset() {
	for i in 0..len(p.Data) {
		p.Data[i] = 0
	}
	writeU16(mut p.Data, 14, PageTypeHeap)
	writeU16(mut p.Data, 16, u16(pageHeaderSize))
	writeU16(mut p.Data, 18, u16(PageSize))
	p.Seal()
}

// Header decodes the common page header.
fn (p Page) Header() PageHeader {
	return PageHeader{
		Lsn: readU64(p.Data, 0),
		Checksum: readU32(p.Data, 8),
		Flags: readU16(p.Data, 12),
		PageType: readU16(p.Data, 14),
		Lower: readU16(p.Data, 16),
		Upper: readU16(p.Data, 18),
		Slots: readU16(p.Data, 20),
		PrevBlock: PageNo(readU32(p.Data, 24)),
		NextBlock: PageNo(readU32(p.Data, 28)),
	}
}

// FreeSpace is the number of bytes available to another line pointer and item.
fn (p Page) FreeSpace() i64 {
	let h = p.Header()
	return i64(h.Upper) - i64(h.Lower)
}

// SetLsn updates the page LSN and checksum.
fn (p mut Page) SetLsn(lsn u64) {
	writeU64(mut p.Data, 0, lsn)
	p.Seal()
}

// Flags returns the header flag bits.
fn (p Page) Flags() u16 {
	return readU16(p.Data, 12)
}

// SetFlags replaces the header flag bits.
fn (p mut Page) SetFlags(flags u16) {
	writeU16(mut p.Data, 12, flags)
	p.Seal()
}

// AllVisible reports whether all tuples on this page are visible to every transaction.
fn (p Page) AllVisible() bool {
	return (readU16(p.Data, 12) & PageAllVisible) != 0
}

// SetAllVisible sets or clears the page-level all-visible bit.
fn (p mut Page) SetAllVisible(v bool) {
	mut flags = readU16(p.Data, 12)
	if v {
		flags |= PageAllVisible
	} else {
		flags &= ~PageAllVisible
	}
	writeU16(mut p.Data, 12, flags)
	p.Seal()
}

// PageType returns the page type identifier.
fn (p Page) PageType() u16 {
	return readU16(p.Data, 14)
}

// SetPageType sets the page type identifier.
fn (p mut Page) SetPageType(pt u16) {
	writeU16(mut p.Data, 14, pt)
	p.Seal()
}

// PrevBlock returns the previous sibling block number.
fn (p Page) PrevBlock() PageNo {
	return PageNo(readU32(p.Data, 24))
}

// SetPrevBlock updates the previous sibling block number.
fn (p mut Page) SetPrevBlock(b PageNo) {
	writeU32(mut p.Data, 24, u32(b))
	p.Seal()
}

// NextBlock returns the next sibling block number.
fn (p Page) NextBlock() PageNo {
	return PageNo(readU32(p.Data, 28))
}

// SetNextBlock updates the next sibling block number.
fn (p mut Page) SetNextBlock(b PageNo) {
	writeU32(mut p.Data, 28, u32(b))
	p.Seal()
}

// Seal recomputes the page checksum.
fn (p mut Page) Seal() {
	writeU32(mut p.Data, 8, 0)
	let c = crc32(p.Data)
	writeU32(mut p.Data, 8, c)
}

// Valid reports whether the page size and checksum are valid.
fn (p Page) Valid() bool {
	if len(p.Data) != PageSize {
		return false
	}
	let got = readU32(p.Data, 8)
	mut dst = make([]u8, len(p.Data))
	copy(dst, p.Data)
	writeU32(mut dst, 8, 0)
	return got == crc32(dst)
}

// Insert stores bytes in the page and returns a one-based line pointer.
fn (p mut Page) Insert(value []u8) !u16 {
	if len(p.Data) != PageSize || len(value) == 0 {
		fail "store: invalid page or empty item"
	}
	let h = p.Header()
	let need = len(value) + linePointerSize
	if i64(h.Upper)-i64(h.Lower) < need {
		fail "store: page full"
	}
	let slot = h.Slots
	let off = i64(h.Upper) - len(value)
	copy(p.Data[off:off+len(value)], value)
	let lp = pageHeaderSize + i64(slot)*linePointerSize
	writeU16(mut p.Data, lp, u16(off))
	writeU16(mut p.Data, lp+2, u16(len(value)))
	writeU32(mut p.Data, lp+4, 1)
	writeU16(mut p.Data, 16, u16(i64(h.Lower)+linePointerSize))
	writeU16(mut p.Data, 18, u16(off))
	writeU16(mut p.Data, 20, slot+1)
	p.Seal()
	return slot + 1
}

// InsertAt inserts an item at the specified 1-based slot, shifting subsequent slots right.
fn (p mut Page) InsertAt(targetSlot u16, value []u8) !u16 {
	if len(p.Data) != PageSize || len(value) == 0 {
		fail "store: invalid page or empty item"
	}
	let h = p.Header()
	if targetSlot == 0 || targetSlot > h.Slots + 1 {
		fail "store: invalid slot index"
	}
	let need = len(value) + linePointerSize
	if i64(h.Upper) - i64(h.Lower) < need {
		fail "store: page full"
	}
	let off = i64(h.Upper) - len(value)
	copy(p.Data[off:off+len(value)], value)
	if targetSlot <= h.Slots {
		for s in (i64(targetSlot)..i64(h.Slots)+1).step(1) {
			let fromSlot = i64(h.Slots) + i64(targetSlot) - s
			let srcLp = pageHeaderSize + (fromSlot-1)*linePointerSize
			let dstLp = pageHeaderSize + fromSlot*linePointerSize
			for b in 0..linePointerSize {
				p.Data[dstLp+b] = p.Data[srcLp+b]
			}
		}
	}
	let lp = pageHeaderSize + i64(targetSlot-1)*linePointerSize
	writeU16(mut p.Data, lp, u16(off))
	writeU16(mut p.Data, lp+2, u16(len(value)))
	writeU32(mut p.Data, lp+4, 1)
	writeU16(mut p.Data, 16, u16(i64(h.Lower)+linePointerSize))
	writeU16(mut p.Data, 18, u16(off))
	writeU16(mut p.Data, 20, h.Slots+1)
	p.Seal()
	return targetSlot
}

// ReserveSlot reserves line-pointer space and returns a slot for a tuple whose bytes are not yet
// installed. A reserved slot is invisible to Item and can be completed after WAL append returns.
fn (p mut Page) ReserveSlot(itemBytes i64, reservedBytes i64) !u16 {
	if len(p.Data) != PageSize || itemBytes <= 0 || reservedBytes < 0 {
		fail "store: invalid tuple reservation"
	}
	let h = p.Header()
	for slot in 1..i64(h.Slots)+1 {
		let lp = pageHeaderSize + (slot-1)*linePointerSize
		if readU32(p.Data, lp+4) == 0 && readU16(p.Data, lp+2) == 0 {
			if p.FreeSpace() < itemBytes+reservedBytes {
				fail "store: page full"
			}
			writeU32(mut p.Data, lp+4, 2)
			p.Seal()
			return u16(slot)
		}
	}
	if p.FreeSpace() < itemBytes+reservedBytes+linePointerSize {
		fail "store: page full"
	}
	let slot = h.Slots+1
	let lp = pageHeaderSize+i64(h.Slots)*linePointerSize
	writeU16(mut p.Data, lp, 0)
	writeU16(mut p.Data, lp+2, 0)
	writeU32(mut p.Data, lp+4, 2)
	writeU16(mut p.Data, 16, u16(i64(h.Lower)+linePointerSize))
	writeU16(mut p.Data, 20, slot)
	p.Seal()
	return slot
}

// InsertReserved fills a slot reserved by ReserveSlot; reservedBytes includes this value.
fn (p mut Page) InsertReserved(slot u16, value []u8, reservedBytes i64) ! {
	let h = p.Header()
	if slot == 0 || slot > h.Slots || len(value) == 0 || reservedBytes < len(value) {
		fail "store: invalid reserved tuple"
	}
	let lp = pageHeaderSize+i64(slot-1)*linePointerSize
	if readU32(p.Data, lp+4) != 2 || readU16(p.Data, lp+2) != 0 || p.FreeSpace() < reservedBytes {
		fail "store: invalid reserved line pointer"
	}
	let off = i64(h.Upper)-len(value)
	copy(p.Data[off:off+len(value)], value)
	writeU16(mut p.Data, lp, u16(off))
	writeU16(mut p.Data, lp+2, u16(len(value)))
	writeU32(mut p.Data, lp+4, 1)
	writeU16(mut p.Data, 18, u16(off))
	p.Seal()
}

// Unreserve releases a tuple slot when the WAL append itself fails.
fn (p mut Page) Unreserve(slot u16) ! {
	let h = p.Header()
	if slot == 0 || slot > h.Slots {
		fail "store: invalid tuple reservation"
	}
	let lp = pageHeaderSize+i64(slot-1)*linePointerSize
	if readU32(p.Data, lp+4) != 2 || readU16(p.Data, lp+2) != 0 {
		fail "store: line pointer is not reserved"
	}
	writeU32(mut p.Data, lp+4, 0)
	p.Seal()
}

// SetItem replaces a live item's bytes without changing its line pointer.
fn (p mut Page) SetItem(slot u16, value []u8) ! {
	let h = p.Header()
	if len(p.Data) != PageSize || slot == 0 || slot > h.Slots {
		fail "store: invalid tuple id"
	}
	let lp = pageHeaderSize + i64(slot-1)*linePointerSize
	let off = i64(readU16(p.Data, lp))
	let n = i64(readU16(p.Data, lp+2))
	if n == 0 || off < pageHeaderSize || off+n > PageSize || len(value) != n {
		fail "store: invalid replacement item"
	}
	copy(p.Data[off:off+n], value)
	p.Seal()
}

// Item returns a copy of a live line-pointer item.
fn (p Page) Item(slot u16) ![]u8 {
	let h = p.Header()
	if slot == 0 || slot > h.Slots {
		fail "store: invalid tuple id"
	}
	let lp = pageHeaderSize + i64(slot-1)*linePointerSize
	let status = readU32(p.Data, lp+4)
	if status != 1 {
		fail "store: deleted or uninitialized line pointer"
	}
	let off = i64(readU16(p.Data, lp))
	let n = i64(readU16(p.Data, lp+2))
	if n == 0 || off < pageHeaderSize || off+n > PageSize {
		fail "store: deleted or corrupt line pointer"
	}
	let out = make([]u8, n)
	copy(out, p.Data[off:off+n])
	return out
}

// ItemView returns a slice directly into the page data for read-only access while latched.
fn (p Page) ItemView(slot u16) ![]u8 {
	let h = p.Header()
	if slot == 0 || slot > h.Slots {
		fail "store: invalid tuple id"
	}
	let lp = pageHeaderSize + i64(slot-1)*linePointerSize
	let status = readU32(p.Data, lp+4)
	if status != 1 {
		fail "store: deleted or uninitialized line pointer"
	}
	let off = i64(readU16(p.Data, lp))
	let n = i64(readU16(p.Data, lp+2))
	if n == 0 || off < pageHeaderSize || off+n > PageSize {
		fail "store: deleted or corrupt line pointer"
	}
	return p.Data[off:off+n]
}

// DeleteItem marks a line pointer unused and defragments the page.
fn (p mut Page) DeleteItem(slot u16) ! {
	let h = p.Header()
	if slot == 0 || slot > h.Slots {
		fail "store: invalid tuple id"
	}
	let lp = pageHeaderSize + i64(slot-1)*linePointerSize
	writeU16(mut p.Data, lp, 0)
	writeU16(mut p.Data, lp+2, 0)
	writeU32(mut p.Data, lp+4, 0)
	p.Compact()
}

// Compact defragments page storage by copying all live items towards the end of the page.
fn (p mut Page) Compact() {
	let h = p.Header()
	if h.Slots == 0 {
		writeU16(mut p.Data, 18, u16(PageSize))
		p.Seal()
		return
	}
	mut temp = make([]u8, PageSize)
	copy(temp, p.Data)
	mut newUpper = i64(PageSize)
	for slot in 1..i64(h.Slots)+1 {
		let lp = pageHeaderSize + (slot-1)*linePointerSize
		let status = readU32(temp, lp+4)
		let itemLen = i64(readU16(temp, lp+2))
		let oldOff = i64(readU16(temp, lp))
		if status == 1 && itemLen > 0 && oldOff >= pageHeaderSize && oldOff+itemLen <= PageSize {
			newUpper -= itemLen
			copy(p.Data[newUpper:newUpper+itemLen], temp[oldOff:oldOff+itemLen])
			writeU16(mut p.Data, lp, u16(newUpper))
		} else if status != 2 {
			writeU16(mut p.Data, lp, 0)
			writeU16(mut p.Data, lp+2, 0)
			writeU32(mut p.Data, lp+4, 0)
		}
	}
	writeU16(mut p.Data, 18, u16(newUpper))
	p.Seal()
}

// PruneSlots marks each listed slot dead and compacts the page.
fn (p mut Page) PruneSlots(deadSlots []u16) {
	let h = p.Header()
	for _, slot in deadSlots {
		if slot >= 1 && slot <= h.Slots {
			let lp = pageHeaderSize + i64(slot-1)*linePointerSize
			writeU16(mut p.Data, lp, 0)
			writeU16(mut p.Data, lp+2, 0)
			writeU32(mut p.Data, lp+4, 0)
		}
	}
	p.Compact()
}

fn writeU16(b mut []u8, off i64, v u16) {
	b[off] = u8(v)
	b[off+1] = u8(v >> 8)
}

fn readU16(b []u8, off i64) u16 {
	return u16(b[off]) | (u16(b[off+1]) << 8)
}

fn writeU32(b mut []u8, off i64, v u32) {
	for i in 0..4 {
		b[off+i] = u8(v >> (i*8))
	}
}

fn readU32(b []u8, off i64) u32 {
	mut v = u32(0)
	for i in 0..4 {
		v |= u32(b[off+i]) << (i*8)
	}
	return v
}

fn writeU64(b mut []u8, off i64, v u64) {
	for i in 0..8 {
		b[off+i] = u8(v >> (i*8))
	}
}

fn readU64(b []u8, off i64) u64 {
	mut v = u64(0)
	for i in 0..8 {
		v |= u64(b[off+i]) << (i*8)
	}
	return v
}

fn crc32(b []u8) u32 {
	mut crc = u32(0xffffffff)
	for x in b {
		crc ^= u32(x)
		for bit in 0..8 {
			_ = bit
			if crc&1 != 0 {
				crc = (crc >> 1) ^ 0xedb88320
			} else {
				crc >>= 1
			}
		}
	}
	return crc ^ 0xffffffff
}
