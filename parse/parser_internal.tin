package parse

// Object kinds the parser accepts as opaque utility statements (validated leading keyword,
// then verbatim text). These are PostgreSQL commands whose detailed grammar is not modelled
// by a dedicated AST node yet.
const utilityStatementWords = "reindex cluster refresh declare fetch move close merge security load"
const alterTableActionWords = "attach detach enable disable set reset validate cluster inherit no of not replica force"
const opaqueFunctionWords = "json_value json_query json_exists json_scalar json_serialize json_table json_array json_arrayagg json_object json_objectagg jsonb_path_query jsonb_path_query_array jsonb_path_query_first jsonb_path_match jsonb_path_exists jsonb_path_agg xmlexists xmltable xpath xpath_exists xmlelement xmlforest xmlparse xmlserialize xmlpi xmlroot xmlconcat xmlagg xmlattributes"
const createObjectWords = "aggregate cast collation conversion database domain event extension foreign language materialized operator policy publication rule server statistics subscription tablespace text transform trigger access procedure user recursive global local"
const alterObjectWords = "aggregate cast collation conversion database domain event extension foreign language materialized operator policy publication rule server statistics subscription tablespace text transform trigger access procedure schema function index view sequence type default large"

type Parser struct {
	Source str
	Tokens []Token
	At i64
	Depth i64
	StopWord str
}

fn (p Parser) done() bool { return p.At >= len(p.Tokens) }

fn (p Parser) text() str {
	if p.done() { return "" }
	return p.Tokens[p.At].Text
}

fn (p Parser) kind() str {
	if p.done() { return "eof" }
	return p.Tokens[p.At].Kind
}

fn (p Parser) bytePos() i64 {
	if p.done() { return len(p.Source) }
	return p.Tokens[p.At].BytePos
}

// pos is the 1-based character offset of the current token, suitable for AST Pos fields.
fn (p Parser) pos() i64 {
	if p.done() { return charPosition(p.Source, len(p.Source)) }
	return p.Tokens[p.At].Pos
}

// rawAt returns the source spelling of the token at index at (as written, not lowercased),
// which is what PostgreSQL quotes in "syntax error at or near ..." messages.
// captureRest returns the verbatim source from the current token to the end of the statement
// and consumes every remaining token. Used for opaque tails such as partition bounds.
fn (p mut Parser) captureRest() str {
	if p.done() { return "" }
	let start = p.Tokens[p.At].BytePos
	let end = p.Tokens[len(p.Tokens) - 1].EndBytePos
	p.At = len(p.Tokens)
	return p.Source[start:end]
}

// captureParenInner returns the verbatim text between the current "(" and its matching ")" and
// consumes through the ")". Storage-parameter lists are preserved this way.
fn (p mut Parser) captureParenInner() str {
	if p.text() != "(" { return "" }
	let open = p.At
	mut depth = 0
	mut close = -1
	mut i = open
	for i < len(p.Tokens) {
		if p.Tokens[i].Text == "(" { depth += 1 } else if p.Tokens[i].Text == ")" {
			depth -= 1
			if depth == 0 { close = i
				break }
		}
		i += 1
	}
	if close < 0 { return "" }
	let inner = p.Source[p.Tokens[open].EndBytePos:p.Tokens[close].BytePos]
	p.At = close + 1
	return inner
}

// statementText reconstructs the current statement's source text from its token spans.
fn (p Parser) statementText() str {
	if len(p.Tokens) == 0 { return "" }
	let first = p.Tokens[0]
	let last = p.Tokens[len(p.Tokens) - 1]
	return p.Source[first.BytePos:last.EndBytePos]
}

// utility consumes the rest of the statement and returns an opaque node that preserves it.
// The leading keywords and object kind have already been validated by the caller.
fn (p mut Parser) utility(kind str) Stmt {
	let stmt = Stmt.Utility(UtilityStmt{Pos: p.Tokens[0].Pos, Kind: kind, Text: p.statementText()})
	p.At = len(p.Tokens)
	return stmt
}

fn (p Parser) rawAt(at i64) str {
	if at >= len(p.Tokens) { return "" }
	let token = p.Tokens[at]
	return p.Source[token.BytePos:token.EndBytePos]
}

fn (p Parser) errorHere() ! {
	if p.done() { fail syntaxMessage(p.Source, len(p.Source), "syntax error at end of input") }
	let token = p.Tokens[p.At]
	fail syntaxMessage(p.Source, token.BytePos, "syntax error at or near \"{p.rawAt(p.At)}\"")
}

fn (p mut Parser) take() Token {
	if p.done() {
		return Token{Text: "", Kind: "eof", BytePos: len(p.Source), EndBytePos: len(p.Source), Pos: charPosition(p.Source, len(p.Source))}
	}
	let token = p.Tokens[p.At]
	p.At += 1
	return token
}

fn (p mut Parser) eat(text str) bool {
	if lowerAscii(p.text()) != lowerAscii(text) { return false }
	p.At += 1
	return true
}

fn (p mut Parser) expect(text str) !Token {
	if !p.eat(text) { try p.errorHere() }
	return p.Tokens[p.At - 1]
}

fn (p mut Parser) enter() ! {
	p.Depth += 1
	if p.Depth > 256 { fail positionedMessage("54001", charPosition(p.Source, p.bytePos()), "stack depth limit exceeded") }
}

fn (p mut Parser) leave() {
	if p.Depth > 0 { p.Depth -= 1 }
}

fn (p Parser) canBeIdentifier() bool {
	if p.done() { return false }
	if p.kind() == "quoted" { return true }
	if p.kind() != "word" { return false }
	return p.Tokens[p.At].KeywordClass != "reserved"
}

fn (p mut Parser) parseIdentifier() !Identifier {
	if !p.canBeIdentifier() { try p.errorHere() }
	let token = p.take()
	let decoded = decodeIdentifier(token.Text)
	return Identifier{Pos: token.Pos, Name: decoded.Name, Quoted: decoded.Quoted}
}

fn (p mut Parser) parseLabelIdentifier() !Identifier {
	if p.done() || (p.kind() != "quoted" && p.kind() != "word") { try p.errorHere() }
	let token = p.take()
	let decoded = decodeIdentifier(token.Text)
	return Identifier{Pos: token.Pos, Name: decoded.Name, Quoted: decoded.Quoted}
}

fn (p mut Parser) parseQualifiedName() !QualifiedName {
	mut start = 0
	if !p.done() { start = p.Tokens[p.At].Pos }
	mut parts = []Identifier{}
	let first = try p.parseIdentifier()
	parts = append(parts, first)
	for p.eat(".") {
		if len(parts) >= 3 { try p.errorHere() }
		let part = try p.parseIdentifier()
		parts = append(parts, part)
	}
	return QualifiedName{Pos: start, Parts: parts}
}

fn nameText(name QualifiedName) str {
	mut out = ""
	for i, part in name.Parts {
		if i > 0 { out += "." }
		out += identifierText(part)
	}
	return out
}

fn identifierText(name Identifier) str {
	if name.Quoted { return "\"" + replaceAll(name.Name, "\"", "\"\"") + "\"" }
	return name.Name
}

fn replaceAll(s str, old str, replacement str) str {
	if len(old) == 0 { return s }
	mut out = ""
	mut at = 0
	for at < len(s) {
		let found = findFrom(s, old, at)
		if found < 0 {
			out += s[at:]
			break
		}
		out += s[at:found] + replacement
		at = found + len(old)
	}
	return out
}

fn (p mut Parser) parseTypeName() !TypeName {
	mut start = 0
	if !p.done() { start = p.Tokens[p.At].Pos }
	let first = try p.parseIdentifier()
	mut parts = []Identifier{first}
	for p.eat(".") {
		let part = try p.parseIdentifier()
		parts = append(parts, part)
	}
	if p.text() == "%" && p.At + 1 < len(p.Tokens) && (lowerAscii(p.Tokens[p.At + 1].Text) == "type" || lowerAscii(p.Tokens[p.At + 1].Text) == "rowtype") {
		p.At += 2
	}
	mut withTimeZone = false
	mut intervalFields = ""
	let firstName = lowerAscii(first.Name)
	if (firstName == "double" || firstName == "character" || firstName == "bit" || firstName == "national" || firstName == "timestamp" || firstName == "time" || firstName == "interval") && p.canBeIdentifier() {
		let next = lowerAscii(p.text())
		if (firstName == "double" && next == "precision") || (firstName == "character" && (next == "varying" || next == "large")) || (firstName == "bit" && next == "varying") || (firstName == "national" && (next == "character" || next == "char")) {
			let part = try p.parseIdentifier()
			parts = append(parts, part)
			if firstName == "character" && next == "large" && p.eat("object") { parts = append(parts, Identifier{Name: "object"}) }
		}
		if firstName == "timestamp" || firstName == "time" {
			if p.eat("with") {
				try p.expect("time")
				try p.expect("zone")
				withTimeZone = true
			} else if p.eat("without") {
				try p.expect("time")
				try p.expect("zone")
			}
		}
		if firstName == "interval" && (p.eat("year") || p.eat("month") || p.eat("day") || p.eat("hour") || p.eat("minute") || p.eat("second")) {
			intervalFields = lowerAscii(p.Tokens[p.At - 1].Text)
			if p.eat("to") { intervalFields += " to " + lowerAscii(p.take().Text) }
		}
	}
	mut modifiers = []TypeModifier{}
	if p.eat("(") {
		for {
			let value = try p.parseExpression(0)
			mut modifierPos = valuePos(value)
			if len(modifiers) == 0 { modifierPos = start }
			modifiers = append(modifiers, TypeModifier{Pos: modifierPos, Value: value})
			if !p.eat(",") { break }
		}
		try p.expect(")")
	}
	if (firstName == "timestamp" || firstName == "time") && !withTimeZone {
		if p.eat("with") {
			try p.expect("time")
			try p.expect("zone")
			withTimeZone = true
		} else if p.eat("without") {
			try p.expect("time")
			try p.expect("zone")
		}
	}
	mut bounds = []ArrayBound{}
	for p.eat("[") {
		mut length ?Expr = nil
		if !p.eat("]") {
			length = Expr.Literal(LiteralExpr{Kind: "integer", Value: p.take().Text})
			try p.expect("]")
		}
		bounds = append(bounds, ArrayBound{Pos: start, Length: length})
	}
	return TypeName{Pos: start, Name: QualifiedName{Pos: start, Parts: parts}, Modifiers: modifiers, ArrayBounds: bounds, WithTimeZone: withTimeZone, IntervalFields: intervalFields}
}

fn valuePos(value Expr) i64 {
	return match value {
		Literal(v) => v.Pos
		ColumnRef(v) => v.Pos
		Param(v) => v.Pos
		Unary(v) => v.Pos
		Binary(v) => v.Pos
		Boolean(v) => v.Pos
		Is(v) => v.Pos
		Between(v) => v.Pos
		In(v) => v.Pos
		Like(v) => v.Pos
		Quantified(v) => v.Pos
		Exists(v) => v.Pos
		Subquery(v) => v.Pos
		Array(v) => v.Pos
		ArraySubquery(v) => v.Pos
		Subscript(v) => v.Pos
		Row(v) => v.Pos
		Field(v) => v.Pos
		Case(v) => v.Pos
		Call(v) => v.Pos
		Special(v) => v.Pos
		Cast(v) => v.Pos
		Collate(v) => v.Pos
		AtTimeZone(v) => v.Pos
		Default(v) => v.Pos
	}
}
