package parse

// Parse parses every non-empty statement in a simple-query string.
fn Parse(sql str) ![]Stmt {
	let tokens = try lex(sql)
	mut statements = []Stmt{}
	mut start = 0
	mut parens = 0
	mut brackets = 0
	for i, token in tokens {
		if token.Text == "(" { parens += 1 }
		if token.Text == ")" {
			parens -= 1
			if parens < 0 { fail syntaxMessage(sql, token.BytePos, "syntax error at or near \")\"") }
		}
		if token.Text == "[" { brackets += 1 }
		if token.Text == "]" {
			brackets -= 1
			if brackets < 0 { fail syntaxMessage(sql, token.BytePos, "syntax error at or near \"]\"") }
		}
		if token.Text == ";" && parens == 0 && brackets == 0 {
			if i > start {
				let statement = try parseStatement(sql, tokens[start:i])
				statements = append(statements, statement)
			}
			start = i + 1
		}
	}
	if parens != 0 || brackets != 0 { fail syntaxMessage(sql, len(sql), "syntax error at end of input") }
	if start < len(tokens) {
		let statement = try parseStatement(sql, tokens[start:])
		statements = append(statements, statement)
	}
	return statements
}

// ParseExpr parses exactly one PostgreSQL expression.
fn ParseExpr(sql str) !Expr {
	let tokens = try lex(sql)
	if len(tokens) == 0 { fail syntaxMessage(sql, len(sql), "syntax error at end of input") }
	mut p = Parser{Source: sql, Tokens: tokens, At: 0, Depth: 0}
	let expression = try p.parseExpression(0)
	if !p.done() { try p.errorHere() }
	return expression
}

// Deparse returns canonical SQL for a typed statement.
fn Deparse(statement Stmt) str {
	return deparseStatement(statement)
}
