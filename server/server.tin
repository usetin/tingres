// Package server owns the listener, the per-connection tasks and the session loop that
// binds a proto connection to a query session through exec.Sink.
//
// Concurrency: connections are tasks on one lane; every socket wait lets the lane serve
// the other sessions, so a slow client cannot block the accept loop or another session.
// Linux SO_REUSEPORT listeners (one per core) are not reachable from Tin yet: wire.Listen
// exposes no reuse-port option, so this is the single-listener form; see BUGS.md.
package server

import "../exec"
import "../proto"
import "../types"
import "atomic"
import "lane"
import "fault"
import "quarry"
import "say"
import "tide"
import "twine"
import "wire"

const defaultMaxConnections = 100
const defaultShutdownGrace = 5s
const copyFlushBytes = 64 * 1024
const livenessTick = 1s

// The engine is owned by main and reaches every connection through the accept loop's
// closure: engine values are references, so a session built from a copy shares the one
// store, transaction manager and catalog (and the WAL gate that belongs to them). Routing
// it as a parameter, instead of through a package global, keeps the long-lived engine out
// of the request pool's escape rules.

shared let activeConnections = atomic.NewInt(0)
shared let stopping = atomic.NewBool(false)

// Config is the server's configuration, after flags and files are read.
type Config struct {
	Data str
	Listen str
	Role str
	Database str
	HbaPath str
	Auth str
	Password str
	MaxConnections i64
	StartupTimeout i64
	IdleTimeout i64
	IoTimeout i64
	LogMinDurationMs i64
	ShutdownFile str
	ReloadFile str
	PidFile str
	TlsCertFile str
	TlsKeyFile str
	TlsCert str
	TlsKey str
	ServerVersion str
	Engine str
	Fake bool
	Hba []proto.HbaLine
}

// CancelHandle is the per-connection cancellation flag: the accept loop sets it from a
// CancelRequest and the session observes it. Only atomics live here, so nothing a task
// allocates has to be stored into another task's memory.
type CancelHandle struct {
	Flag atomic.Bool
}

// NewCancelHandle creates a clear cancellation flag.
fn NewCancelHandle() CancelHandle {
	return CancelHandle{Flag: atomic.NewBool(false)}
}

// ConnSlot is the shared state of one accepted connection. It holds only atomics and small
// values created by the accept loop itself, so a CancelRequest on another connection can
// reach the right session without either side storing the other's memory.
type ConnSlot struct {
	Pid u32
	SecretKey u32
	Ready atomic.Bool
	Done atomic.Bool
	Terminate atomic.Bool
	Cancel CancelHandle
}

fn new_slot(pid u32) ConnSlot {
	return ConnSlot{
		Pid: pid,
		SecretKey: 0,
		Ready: atomic.NewBool(false),
		Done: atomic.NewBool(false),
		Terminate: atomic.NewBool(false),
		Cancel: NewCancelHandle(),
	}
}

// RequestShutdown asks a running server to stop accepting and terminate its sessions.
fn RequestShutdown() { stopping.Store(true) }

// ClearShutdown resets the shutdown flag.
fn ClearShutdown() { stopping.Store(false) }

// ActiveConnections is the number of connections currently reserved.
fn ActiveConnections() i64 { return activeConnections.Load() }

// Limit clamps a configured connection limit to the server default.
fn Limit(configured i64) i64 {
	if configured <= 0 { return defaultMaxConnections }
	return configured
}

// Serve listens on addr and serves until shutdown.
fn Serve(addr str, cfg Config, engine Engine) ! {
	let listener = try wire.Listen(addr)
	say.Line("tingres: listening on {addr} (max_connections={Limit(cfg.MaxConnections)}, engine={engine_name(cfg)})")
	try serve_listener(listener, cfg, engine)
	mut closed = listener
	closed.Close()
}

// Listen serves until shutdown on an already-open listener (tests bind port 0).
fn Listen(listener wire.Listener, cfg Config, engine Engine) ! {
	try serve_listener(listener, cfg, engine)
}

// engine_name names the engine used for logging.
fn engine_name(cfg Config) str {
	if cfg.Fake { return "conformance" }
	return "real"
}

fn reserve_connection(maxAllowed i64) bool {
	let current = activeConnections.Add(1)
	if current <= maxAllowed { return true }
	activeConnections.Add(-1)
	return false
}

// proto_config builds the per-connection protocol configuration.
fn proto_config(cfg Config, pid u32, peer str) proto.Config {
	return proto.Config{
		User: cfg.Role,
		Database: cfg.Database,
		Auth: cfg.Auth,
		Password: cfg.Password,
		MaxConnections: cfg.MaxConnections,
		Hba: cfg.Hba,
		TlsCert: cfg.TlsCert,
		TlsKey: cfg.TlsKey,
		PeerAddress: peer,
		ServerVersion: cfg.ServerVersion,
		Pid: pid,
	}
}

// peer_address is the client address pg_hba matching uses; wire exposes no RemoteAddr yet
// (see BUGS.md), so it is the listener's own host, which is the loopback address in tests
// and development.
fn peer_address(cfg Config) str {
	let colon = twine.LastIndex(cfg.Listen, ":")
	if colon <= 0 { return "127.0.0.1" }
	let host = cfg.Listen[:colon]
	if host == "" || host == "0.0.0.0" || host == "*" { return "0.0.0.0" }
	if host == "::" || host == "[::]" { return "::1" }
	return host
}

fn serve_listener(listener wire.Listener, cfg Config, engine Engine) ! {
	mut registry = make(map[u32]ConnSlot)
	mut nextPid = u32(20000)
	mut active = cfg
	ClearShutdown()
	mut keepAlive = lane.New[bool](1)
	let eng = engine
	scope sessions {
		sessions.spawn(fn() ! {
			for {
				if stopping.Load() || shutdown_requested(active) {
					mut closingEng = eng
					begin_shutdown(mut registry, active)
					keepAlive.Send(true) catch _ {}
					return
				}
				if reload_requested(active) {
					active = reload_hba(active)
				}
				// AcceptTimeout is the accept loop's liveness tick: it lets the loop notice a
				// shutdown file or a pg_hba reload without waiting for a new connection.
				mut accepted = listener.AcceptTimeout(livenessTick) catch err {
					if stopping.Load() || shutdown_requested(active) {
						begin_shutdown(mut registry, active)
						keepAlive.Send(true) catch _ {}
						return
					}
					if is_timeout_fault(err) {
						continue
					}
					begin_shutdown(mut registry, active)
					keepAlive.Send(true) catch _ {}
					return
				}
				prune_registry(mut registry)
				if !reserve_connection(Limit(active.MaxConnections)) {
					proto.RejectStartup(mut accepted, "53300", "sorry, too many clients already") catch _ {
					}
					accepted.Close()
					continue
				}
				let pid = nextPid
				nextPid += 1
				let slot = new_slot(pid)
				registry[pid] = slot
				let clientArg = accepted
				let peer = peer_address(active)
				let cfgCopy = active
				sessions.spawn(fn() ! {
					mut clientLocal = clientArg
					mut slotLocal = slot
					mut cfgLocal = cfgCopy
					client_loop(mut clientLocal, mut cfgLocal, mut slotLocal, registry, peer, pid, eng) catch err {
						if !proto.IsProtocolError(err) {
							say.Line("tingres: connection {pid} ended: {fault.Message(err)}")
						}
					}
				})
			}
		})
		for {
			let _ = keepAlive.Recv() catch _ { false }
			break
		}
	}
}

fn client_loop(client mut wire.Conn, cfg mut Config, slot mut ConnSlot, registry map[u32]ConnSlot, peer str, pid u32, engine Engine) ! {

	defer activeConnections.Add(-1)
	defer slot.Done.Store(true)
	client.SetTimeout(cfg.StartupTimeout)
	mut accepted = proto.Accept(mut client, proto_config(cfg, pid, peer)) catch err {
		client.Close()
		fail err
	}
	match accepted {
		Canceled(target, key) => {
			handle_cancel(registry, target, key)
			client.Close()
			return
		}
		Ready(conn) => {
			mut c = conn
			let startup = c.Startup()
			let user = startup.User
			mut database = startup.Database
			if database == "" { database = user }
			let session = try new_session(engine, cfg.Fake, user, database, pid, slot.Cancel)
			mut current dyn QuerySession = session
			slot.SecretKey = c.SecretKey()
			slot.Ready.Store(true)
			c.SetTimeout(cfg.IoTimeout)
			try send_parameters(mut c, current)
			c.SendReadyForQuery(current.StatusChar()) catch _ {
			}
			try serve_messages(mut c, mut current, cfg, slot)
			c.Close()
		}
	}
}

// new_session creates the execution session for a connection.
fn new_session(engine Engine, fake bool, user str, db str, pid u32, cancel CancelHandle) !Session {
	if fake { return FakeSessionOf(NewFakeSession(user, db, pid, cancel)) }
	return RealSession(engine.NewSession(user, db))
}

// send_parameters reports every ParameterStatus PostgreSQL reports at startup.
fn send_parameters(c mut proto.Conn, session dyn QuerySession) ! {
	for name in parameter_order() {
		if let v = session.GetGuc(twine.ToLower(name)) {
			try c.SendParameter(name, v)
			continue
		}
		let fallback = parameter_fallback(name)
		if fallback != "" { try c.SendParameter(name, fallback) }
	}
}

// ---------------------------------------------------------------------------
// message loop

fn serve_messages(c mut proto.Conn, session mut dyn QuerySession, cfg Config, slot ConnSlot) ! {
	mut sink = NewSessionSink(c)
	mut skipUntilSync = false
	mut lastActivity = tide.Now()
	for {
		if slot.Terminate.Load() || stopping.Load() {
			terminating_connection(mut c)
			return
		}
		if slot.Cancel.Flag.Load() {
			// A CancelRequest arrived: hand it to the executor, which raises 57014 at its
			// next cancellation point (the conformance engine's pg_sleep polls it directly).
			slot.Cancel.Flag.Store(false)
			session.Cancel()
		}
		// A short read deadline is the liveness tick: an idle session wakes here, so it can
		// see a shutdown or an idle timeout. It is restored to the configured I/O limit
		// before the statement runs, so a slow client is never cut off mid-statement.
		c.SetTimeout(livenessTick)
		let message = c.Next() catch err {
			if proto.IsIdle(err) {
				if cfg.IdleTimeout > 0 && tide.Since(lastActivity) >= cfg.IdleTimeout {
					say.Line("LOG: closing idle session {slot.Pid}")
					c.Abort()
					return
				}
				continue
			}
			if proto.IsProtocolError(err) {
				c.SendError(proto.ErrorFields{Severity: "ERROR", Code: "08P01", Message: fault.Message(err)}) catch _ {
				}
				c.Flush() catch _ {
				}
				c.Abort()
				return
			}
			c.Abort()
			return
		}
		c.SetTimeout(cfg.IoTimeout)
		lastActivity = tide.Now()
		if skipUntilSync {
			match message {
				Sync => {
					skipUntilSync = false
					session.Sync(mut sink) catch _ {
					}
					c.SendReadyForQuery(session.StatusChar()) catch _ {
					}
				}
				Terminate => {
					c.Abort()
					return
				}
				_ => {}
			}
			continue
		}
		match message {
			Query(sql) => {
				if is_empty_query(sql) {
					c.SendEmptyQueryResponse() catch _ {
					}
					c.SendReadyForQuery(session.StatusChar()) catch _ {
					}
				} else {
					let started = tide.Now()
					let (_ran, failed) = session.Simple(sql, mut sink)
					logStatement(sql, tide.Since(started), cfg.LogMinDurationMs)
					if sink.Failed {
						c.Abort()
						return
					}
					if sink.InCopyIn {
						let copied = finish_copy_in(mut c, mut sink)
						if !copied.Ok {
							c.SendError(proto.ErrorFields{Severity: "ERROR", Code: copied.Code, Message: copied.Message}) catch _ {
							}
						}
						send_pending_tag(mut c, mut sink) catch _ {
						}
					} else if failed != nil {
						send_error(mut c, failed)
					}
					c.SendReadyForQuery(session.StatusChar()) catch _ {
					}
				}
			}
			Parse(name, sql, oids) => {
				let (_parsed, failed) = session.Parse(name, sql, oids)
				if failed != nil {
					send_error(mut c, failed)
					skipUntilSync = true
				} else {
					c.SendParseComplete() catch _ {
					}
				}
			}
			Bind(portal, statement, paramFormats, params, resultFormats) => {
				let (_bound, failed) = session.BindBytes(portal, statement, mut paramFormats, mut params, mut resultFormats)
				if failed != nil {
					send_error(mut c, failed)
					skipUntilSync = true
				} else {
					c.SendBindComplete() catch _ {
					}
				}
			}
			Describe(kind, name) => {
				let described = describe_or_skip(mut c, session, kind, name)
				if !described.Ok {
					skipUntilSync = true
					continue
				}
				if kind == 'S' {
					c.SendParameterDescription(described.Desc.ParamOids) catch _ {
					}
				}
				if len(described.Desc.Cols) == 0 {
					c.SendNoData() catch _ {
					}
				} else {
					c.SendRowDescription(columns_of(described.Desc.Cols, []i16{})) catch _ {
					}
				}
			}
			Execute(portal, maxRows) => {
				sink.SawTag = false
				let started = tide.Now()
				let (_executed, failed) = session.Execute(portal, maxRows, mut sink)
				logStatement("execute " + portal, tide.Since(started), cfg.LogMinDurationMs)
				if sink.Failed {
					c.Abort()
					return
				}
				if sink.InCopyIn {
					let copied = finish_copy_in(mut c, mut sink)
					if !copied.Ok {
						c.SendError(proto.ErrorFields{Severity: "ERROR", Code: copied.Code, Message: copied.Message}) catch _ {
						}
					}
					send_pending_tag(mut c, mut sink) catch _ {
					}
					continue
				}
				if failed != nil {
					send_error(mut c, failed)
					skipUntilSync = true
					continue
				}
				if !sink.SawTag { c.SendPortalSuspended() catch _ {
					} }
			}
			Close(kind, name) => {
				let (_closed, failed) = session.Close(kind, name)
				if failed != nil {
					send_error(mut c, failed)
					skipUntilSync = true
				} else {
					c.SendCloseComplete() catch _ {
					}
				}
			}
			Sync => {
				session.Sync(mut sink) catch _ {
				}
				c.SendReadyForQuery(session.StatusChar()) catch _ {
				}
			}
			Flush => {
				c.Flush() catch _ {
				}
			}
			Terminate => {
				c.Abort()
				return
			}
			CopyData(_) => {
				protocol_violation(mut c, "unexpected CopyData message")
				return
			}
			CopyDone => {
				protocol_violation(mut c, "unexpected CopyDone message")
				return
			}
			CopyFail(_) => {
				protocol_violation(mut c, "unexpected CopyFail message")
				return
			}
			Password(_) => {
				protocol_violation(mut c, "unexpected PasswordMessage")
				return
			}
			Unknown(kind) => {
				protocol_violation(mut c, "invalid frontend message type {kind}")
				return
			}
		}
		if session.IsCanceled() {
			// The cancelled statement has been answered; the flag must not leak into the
			// statements that follow it.
			session.ResetCancel()
		}
	}
}

// terminating_connection sends the 57P01 PostgreSQL sends on a fast shutdown.
fn terminating_connection(c mut proto.Conn) {
	c.SendError(proto.ErrorFields{Severity: "FATAL", Code: "57P01", Message: "terminating connection due to administrator command"}) catch _ {
	}
	c.Flush() catch _ {
	}
	c.Abort()
}

// protocol_violation answers 08P01 and closes, as PostgreSQL does. The error is flushed
// first: Abort closes the socket without writing what is still buffered.
fn protocol_violation(c mut proto.Conn, message str) {
	c.SendError(proto.ErrorFields{Severity: "ERROR", Code: "08P01", Message: message}) catch _ {
	}
	c.Flush() catch _ {
	}
	c.Abort()
}

// DescribeResult reports a Describe outcome: the description or the error to send.
type DescribeResult struct {
	Ok bool
	Desc exec.Description
	Code str
	Message str
}

// describe_or_skip describes a statement or portal, reporting the error itself.
fn describe_or_skip(c mut proto.Conn, session dyn QuerySession, kind u8, name str) DescribeResult {
	mut failedToDescribe = false
	mut payload = types.NewError("XX000", "")
	let described = session.Describe(kind, name) catch err {
		failedToDescribe = true
		payload = types.ErrorFromFault(err)
		exec.Description{Cols: []exec.ColDesc{}, ParamOids: []u32{}}
	}
	if failedToDescribe {
		c.SendError(error_fields(payload)) catch _ {
		}
		return DescribeResult{Ok: false, Desc: described, Code: payload.Code, Message: payload.Message}
	}
	return DescribeResult{Ok: true, Desc: described, Code: "", Message: ""}
}

// send_error writes a fault as a PostgreSQL ErrorResponse.
fn send_error(c mut proto.Conn, err fault) {
	let payload = types.ErrorFromFault(err)
	c.SendError(error_fields(payload)) catch _ {
	}
}

// send_pending_tag sends the CommandComplete a COPY FROM STDIN deferred while the client's
// copy data was read.
fn send_pending_tag(c mut proto.Conn, sink mut SessionSink) ! {
	if sink.PendingTag != "" {
		try c.SendCommandComplete(sink.PendingTag)
		sink.PendingTag = ""
	}
	sink.InCopyIn = false
	sink.InCopyOut = false
	sink.SawTag = false
}

// error_fields converts a PostgreSQL error payload for the wire.
fn error_fields(p types.PgError) proto.ErrorFields {
	return proto.ErrorFields{Severity: p.Severity, Code: p.Code, Message: p.Message, Detail: p.Detail, Hint: p.Hint, Position: p.Position}
}

// columns_of builds RowDescription descriptors from executor column descriptions.
fn columns_of(cols []exec.ColDesc, formats []i16) []proto.Column {
	mut out = make([]proto.Column, 0, len(cols))
	for i, c in cols {
		mut format = i16(0)
		if i < len(formats) { format = formats[i] }
		out = append(out, proto.Column{Name: c.Name, TableOid: c.TableOid, Attribute: c.Attno, TypeOid: c.Oid, TypeSize: type_size(c.Oid), TypeMod: c.Typmod, Format: format})
	}
	return out
}

// ---------------------------------------------------------------------------
// COPY

// CopyResult reports how a COPY FROM STDIN exchange ended.
type CopyResult struct {
	Ok bool
	Code str
	Message str
}

// finish_copy_in reads the client's CopyData stream until CopyDone, or reports the
// CopyFail message, and counts the bytes and rows for the log.
fn finish_copy_in(c mut proto.Conn, sink mut SessionSink) CopyResult {
	mut bytes = i64(0)
	mut rows = i64(0)
	for {
		let message = c.Next() catch err {
			return CopyResult{Ok: false, Code: "08006", Message: fault.Message(err)}
		}
		match message {
			CopyData(data) => {
				bytes += i64(len(data))
				for i in 0..len(data) { if data[i] == '\n' { rows += 1 } }
			}
			CopyDone => {
				sink.CopyRows += rows
				say.Line("LOG: COPY IN: {rows} rows, {bytes} bytes received (storage path pending in exec)")
				return CopyResult{Ok: true, Code: "", Message: ""}
			}
			CopyFail(message) => {
				return CopyResult{Ok: false, Code: "57014", Message: "COPY from stdin failed: " + message}
			}
			Terminate => {
				return CopyResult{Ok: false, Code: "57014", Message: "COPY from stdin failed: client terminated"}
			}
			_ => {
				return CopyResult{Ok: false, Code: "08P01", Message: "unexpected message during COPY FROM STDIN"}
			}
		}
	}
}

// ---------------------------------------------------------------------------
// shutdown, reload, cancel, registry

fn shutdown_requested(cfg Config) bool {
	if cfg.ShutdownFile == "" { return false }
	return quarry.Exists(cfg.ShutdownFile)
}

fn reload_requested(cfg Config) bool {
	if cfg.ReloadFile == "" { return false }
	return quarry.Exists(cfg.ReloadFile)
}

// reload_hba re-reads pg_hba.conf, as SIGHUP does in PostgreSQL. Until Tin can deliver a
// signal, the server watches --reload-file instead (see BUGS.md).
fn reload_hba(cfg Config) Config {
	quarry.Remove(cfg.ReloadFile) catch _ {
	}
	let text = quarry.ReadFile(cfg.HbaPath) catch _ {
		return cfg
	}
	let rules = proto.ParseHba(text)
	say.Line("tingres: reloaded {cfg.HbaPath} ({len(rules)} rules)")
	return Config{
		Data: cfg.Data,
		Listen: cfg.Listen,
		Role: cfg.Role,
		Database: cfg.Database,
		Auth: cfg.Auth,
		Password: cfg.Password,
		MaxConnections: cfg.MaxConnections,
		StartupTimeout: cfg.StartupTimeout,
		IdleTimeout: cfg.IdleTimeout,
		IoTimeout: cfg.IoTimeout,
		LogMinDurationMs: cfg.LogMinDurationMs,
		ShutdownFile: cfg.ShutdownFile,
		ReloadFile: cfg.ReloadFile,
		PidFile: cfg.PidFile,
		TlsCertFile: cfg.TlsCertFile,
		TlsKeyFile: cfg.TlsKeyFile,
		TlsCert: cfg.TlsCert,
		TlsKey: cfg.TlsKey,
		ServerVersion: cfg.ServerVersion,
		Engine: cfg.Engine,
		Fake: cfg.Fake,
		Hba: rules,
	}
}

// begin_shutdown is PostgreSQL's fast shutdown: stop accepting, ask every session to
// terminate (57P01 at its next message), wait for them, checkpoint, and return so the
// process exits 0. A session blocked reading an idle socket wakes on the liveness timeout
// and sees the flag; without a Tin signal API (see BUGS.md) the process itself is stopped
// by SIGTERM, and an idle session is dropped when it exits.
fn begin_shutdown(registry mut map[u32]ConnSlot, cfg Config) {
	say.Line("tingres: shutting down ({activeConnections.Load()} connections)")
	stopping.Store(true)
	for _, slot in registry {
		slot.Terminate.Store(true)
	}
	let deadline = tide.Now() + defaultShutdownGrace
	for tide.Now() < deadline {
		if pending_connections(registry) == 0 { break }
		tide.Sleep(20ms)
	}
}

// pending_connections counts sessions that have not finished.
fn pending_connections(registry map[u32]ConnSlot) i64 {
	mut n = i64(0)
	for _, slot in registry {
		if slot.Ready.Load() && !slot.Done.Load() { n += 1 }
	}
	return n
}

fn prune_registry(registry mut map[u32]ConnSlot) {
	mut finished = []u32{}
	for pid, slot in registry {
		if slot.Done.Load() { finished = append(finished, pid) }
	}
	for pid in finished { delete(registry, pid) }
}

// handle_cancel answers a CancelRequest: when the pid and secret match a live session,
// that session is flagged for cancellation, which the executor turns into 57014.
fn handle_cancel(registry map[u32]ConnSlot, pid u32, key u32) {
	let (slot, ok) = registry[pid]
	if !ok { return }
	if !slot.Ready.Load() { return }
	if slot.SecretKey != key { return }
	slot.Cancel.Flag.Store(true)
	say.Line("LOG: cancel request for backend {pid}")
}

// ---------------------------------------------------------------------------
// helpers

// ReadHba parses a pg_hba.conf file; a missing file is no rules.
fn ReadHba(path str) []proto.HbaLine {
	let text = quarry.ReadFile(path) catch _ {
		return []proto.HbaLine{}
	}
	return proto.ParseHba(text)
}

// WritePidFile writes postmaster.pid, PostgreSQL's lock file, and returns the path.
fn WritePidFile(dataDir str, listen str) !str {
	let path = dataDir + "/postmaster.pid"
	try quarry.WriteFile(path, "{quarry.Pid()}\n{dataDir}\n{listen}\n{tide.Now()}\n")
	return path
}

// RemovePidFile removes the lock file at shutdown.
fn RemovePidFile(path str) {
	if path == "" { return }
	quarry.Remove(path) catch _ {
	}
}

// is_timeout_fault reports whether a wait failed because its deadline passed.
fn is_timeout_fault(err fault) bool {
	return twine.Contains(fault.Message(err), "timed out")
}

// is_empty_query reports whether a simple query holds no statement at all.
fn is_empty_query(sql str) bool {
	for i in 0..len(sql) {
		let c = sql[i]
		if c == ';' || c == ' ' || c == '\t' || c == '\n' || c == '\r' { continue }
		return false
	}
	return true
}

fn supported_query(sql str) bool {
	let q = twine.ToLower(twine.TrimSpace(twine.Trim(sql, " \t\r\n;")))
	return q == "select 1" || q == "select 1 as answer"
}
