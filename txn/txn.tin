package txn

import "../store"

const xactRel store.RelId = 4294967294
const xidBlockSize u32 = 256
const walXidReserve u8 = 16
const walXidCommit u8 = 17
const walXidAbort u8 = 18
const walClogPage u8 = 19
const walXidSubCommit u8 = 20
const clogPageXids u32 = 256
const clogPageBytes i64 = 64

// Manager owns the durable xid horizon, two-bit commit log, snapshots, and locks.

// Isolation selects when a statement takes its visibility snapshot.
type Isolation enum {
	ReadCommitted
	RepeatableRead
	Serializable
}

// XidState is the durable outcome recorded for a transaction id.
type XidState enum {
	InProgress
	Committed
	Aborted
	SubCommitted
}

// Txn carries the caller-visible identity and statement counter.
type Txn struct {
	xid u32
	iso Isolation
	cid u32
	startXmin u32
	startXmax u32
	startXip []u32
	active bool
	// xids is the transaction's own xid plus every live subtransaction xid.
	xids []u32
	// writeXid is the xid stamped on new tuple versions (the innermost subtransaction).
	writeXid u32
	savepoints []SavepointEntry
}

// SavepointEntry records one open savepoint and its subtransaction xid.
type SavepointEntry struct {
	Name str
	Subxid u32
}

// Snapshot is the MVCC horizon and active transaction set for one statement.
type Snapshot struct {
	Xmin u32
	Xmax u32
	Xip []u32
	Xid u32
	Cid u32
	// Xids is the reading transaction's own xid and subtransaction xids.
	Xids []u32
}

type SnapshotHandle struct {
	Id u64
	Value Snapshot
}

type TupleCheckCode enum {
	Ok
	Invisible
	SelfModified
	Updated
	BeingModified
}

// TupleHeader is the subset of a heap header required for visibility.
type TupleHeader struct {
	Xmin u32
	Xmax u32
	Cid u32
	Infomask u16
}

type TupleCheck struct {
	Code TupleCheckCode
	By u32
	Ctid store.Tid
}

// LockMode is one of PostgreSQL's eight relation lock modes.
type LockMode enum {
	AccessShare
	RowShare
	RowExclusive
	ShareUpdateExclusive
	Share
	ShareRowExclusive
	Exclusive
	AccessExclusive
}

// TupleLock is a row-level lock mode.
type TupleLock enum {
	ForKeyShare
	ForShare
	ForNoKeyUpdate
	ForUpdate
}

// LockKey identifies one relation lock table entry.
type LockKey struct {
	rel u32
}

// LockHolder is one transaction's held lock.
type LockHolder struct {
	xid u32
	mode LockMode
}

// TupleLockKey identifies one tuple lock table entry.
type TupleLockKey struct {
	rel u32
	page u32
	slot u16
}

// TupleLockHolder is one transaction's held tuple lock.
type TupleLockHolder struct {
	xid u32
	mode TupleLock
}

type DeleteCommand struct {
	xid u32
	cid u32
}

type TuplePageKey struct {
	rel u32
	page u32
}

type PageVisibility struct {
	xmin u32
	xmax u32
}

// Manager owns transaction ids, outcomes, active snapshots and relation locks.
type Manager struct {
	store store.Store
	nextXid u32
	reservedUntil u32
	clog map[u32][]u8
	active map[u32]bool
	subxids map[u32][]u32
	txnXmin map[u32]u32
	locks map[LockKey][]LockHolder
	tupleLocks map[TupleLockKey][]TupleLockHolder
	deleteCommands map[TupleLockKey]DeleteCommand
	snapshots map[u64]Snapshot
	publishedXip []u32
	publishedXmin u32
	allVisiblePages map[TuplePageKey]PageVisibility
	nextSnapshot u64
	version u64
}

const infXmaxLockOnly u16 = 0x0080
const infXminCommitted u16 = 0x0100
const infXminInvalid u16 = 0x0200
const infXminFrozen u16 = 0x0300
const infXmaxCommitted u16 = 0x0400
const infXmaxInvalid u16 = 0x0800

// NewManager recovers the durable xid horizon and commit log from the store.
fn NewManager(s mut store.Store) !Manager {
	try s.RegisterRecordKind(walXidReserve, "txn xid reserve")
	try s.RegisterRecordKind(walXidCommit, "txn commit")
	try s.RegisterRecordKind(walXidAbort, "txn abort")
	try s.RegisterRecordKind(walClogPage, "txn clog page")
	try s.RegisterRecordKind(walXidSubCommit, "txn subcommit")
	s.CreateHeap(xactRel) catch _ { }
	mut m = Manager{store: s, nextXid: 3, reservedUntil: 3, clog: make(map[u32][]u8), active: make(map[u32]bool), subxids: make(map[u32][]u32), txnXmin: make(map[u32]u32), locks: make(map[LockKey][]LockHolder), tupleLocks: make(map[TupleLockKey][]TupleLockHolder), deleteCommands: make(map[TupleLockKey]DeleteCommand), snapshots: make(map[u64]Snapshot), publishedXip: []u32{}, publishedXmin: 3, allVisiblePages: make(map[TuplePageKey]PageVisibility), nextSnapshot: 1, version: 1}
	mut scan = s.HeapScan(xactRel)
	for {
		let (tuple, ok) = scan.Next()
		if !ok { break }
		if len(tuple.Payload) == 5 && tuple.Payload[0] == 1 {
			let watermark = readU32(tuple.Payload, 1)
			if watermark > m.nextXid { m.nextXid = watermark }
		} else if len(tuple.Payload) == clogPageBytes+5 && tuple.Payload[0] == 2 {
			let page = readU32(tuple.Payload, 1)
			m.clog[page] = cloneBytes(tuple.Payload[5:])
		}
	}
	if m.nextXid < 3 { m.nextXid = 3 }
	m.reservedUntil = m.nextXid
	m.publishedXmin = m.nextXid
	try m.recoverInflight()
	try m.reserveXids()
	return m
}

// Begin starts a transaction at the current xid horizon. Serializable currently has repeatable-read semantics; SSI is not implemented.
fn (m mut Manager) Begin(iso Isolation) !Txn {
	if m.nextXid >= m.reservedUntil {
		try m.reserveXids()
	}
	let xid = m.nextXid
	m.nextXid += 1
	let activeXids = m.publishedXip
	let xmin = m.publishedXmin
	m.active[xid] = true
	if iso == Isolation.ReadCommitted { m.txnXmin[xid] = xid } else { m.txnXmin[xid] = xmin }
	m.refreshPublishedXip()
	m.version += 1
	return Txn{xid: xid, iso: iso, cid: 0, startXmin: xmin, startXmax: xid, startXip: activeXids, active: true, xids: []u32{xid}, writeXid: xid, savepoints: []SavepointEntry{}}
}

// Xid returns the transaction id.
fn (t Txn) Xid() u32 {
	return t.xid
}

// WriteXid returns the xid stamped on new tuple versions (the innermost subtransaction).
fn (t Txn) WriteXid() u32 {
	return t.writeXid
}

// Subxids returns the transaction's subtransaction xids.
fn (t Txn) Subxids() []u32 {
	return t.xids
}
fn (t Txn) CommandID() u32 {
	return t.cid
}

// NextXid returns the next transaction id the manager will allocate.
fn (m Manager) NextXid() u32 {
	return m.nextXid
}

// CommandCounterIncrement advances the current transaction's command id.
fn (t mut Txn) CommandCounterIncrement() {
	t.cid += 1
}

// Snapshot returns a fresh statement snapshot for read committed and a stable one otherwise.
fn (m Manager) Snapshot(t Txn) Snapshot {
	if t.iso != Isolation.ReadCommitted {
		return Snapshot{Xmin: t.startXmin, Xmax: t.startXmax, Xip: t.startXip, Xid: t.xid, Cid: t.cid, Xids: t.xids}
	}
	return Snapshot{Xmin: m.publishedXmin, Xmax: m.nextXid, Xip: m.publishedXip, Xid: t.xid, Cid: t.cid, Xids: t.xids}
}

// AcquireSnapshot registers a statement snapshot until ReleaseSnapshot is called.
fn (m mut Manager) AcquireSnapshot(t Txn) SnapshotHandle {
	let snap = m.Snapshot(t)
	let id = m.nextSnapshot
	m.nextSnapshot += 1
	m.snapshots[id] = snap
	return SnapshotHandle{Id: id, Value: snap}
}

// ReleaseSnapshot removes a registered statement snapshot from the vacuum horizon.
fn (m mut Manager) ReleaseSnapshot(h SnapshotHandle) {
	delete(m.snapshots, h.Id)
}

// GlobalXmin returns the oldest xid retained by any active transaction or registered snapshot.
fn (m Manager) GlobalXmin() u32 {
	mut xmin = m.nextXid
	for xid, horizon in m.txnXmin {
		let (isActive, active) = m.active[xid]
		if active && isActive && horizon < xmin { xmin = horizon }
	}
	for _, snap in m.snapshots {
		if snap.Xmin < xmin { xmin = snap.Xmin }
	}
	if xmin < 3 { return 3 }
	return xmin
}

fn (m mut Manager) releaseTxnSnapshots(xid u32) {
	mut ids = []u64{}
	for id, snap in m.snapshots {
		if snap.Xid == xid { ids = append(ids, id) }
	}
	for id in ids { delete(m.snapshots, id) }
}

fn (m mut Manager) releaseDeleteCommands(xid u32) {
	mut keys = []TupleLockKey{}
	for key, value in m.deleteCommands {
		if value.xid == xid { keys = append(keys, key) }
	}
	for key in keys { delete(m.deleteCommands, key) }
}

// Commit records a committed outcome and releases transaction locks.
fn (m mut Manager) Commit(t mut Txn) ! {
	if !t.active {
		fail "25000 transaction is not active"
	}
	let lsn = try m.persistState(t.xid, XidState.Committed, walXidCommit)
	for sub in t.xids {
		if sub != t.xid {
			_ = try m.persistState(sub, XidState.Committed, walXidSubCommit)
		}
	}
	try m.store.Sync(lsn)
	m.clearTxn(mut t)
	return
}

// Abort records an aborted outcome and releases transaction locks.
fn (m mut Manager) Abort(t mut Txn) ! {
	if !t.active {
		return
	}
	_ = try m.persistState(t.xid, XidState.Aborted, walXidAbort)
	for sub in t.xids {
		if sub != t.xid {
			_ = try m.persistState(sub, XidState.Aborted, walXidAbort)
		}
	}
	m.clearTxn(mut t)
}

fn (m mut Manager) clearTxn(t mut Txn) {
	for xid in t.xids {
		delete(m.active, xid)
		delete(m.subxids, xid)
	}
	delete(m.active, t.xid)
	delete(m.subxids, t.xid)
	delete(m.txnXmin, t.xid)
	t.active = false
	m.refreshPublishedXip()
	for xid in t.xids {
		m.releaseTxnSnapshots(xid)
		m.releaseDeleteCommands(xid)
	}
	m.releaseTxnSnapshots(t.xid)
	m.releaseDeleteCommands(t.xid)
	m.version += 1
	for xid in t.xids {
		m.releaseLocks(xid)
	}
	m.releaseLocks(t.xid)
}

// Savepoint allocates a subtransaction xid and records a savepoint name.
fn (m mut Manager) Savepoint(t mut Txn, name str) ! {
	if !t.active {
		fail "25000 transaction is not active"
	}
	if m.nextXid >= m.reservedUntil {
		try m.reserveXids()
	}
	let sub = m.nextXid
	m.nextXid += 1
	m.active[sub] = true
	let list = m.subxids[t.xid]
	m.subxids[t.xid] = append(list, sub)
	t.xids = append(t.xids, sub)
	t.writeXid = sub
	t.savepoints = append(t.savepoints, SavepointEntry{Name: name, Subxid: sub})
	m.version += 1
	return
}

// RollbackTo aborts every subtransaction established after the named savepoint and
// restarts it with a fresh subtransaction xid.
fn (m mut Manager) RollbackTo(t mut Txn, name str) ! {
	let idx = lastSavepoint(t, name)
	if idx < 0 {
		fail "3B001 savepoint \"{name}\" does not exist"
	}
	let keepSub = t.savepoints[idx].Subxid
	mut keptXids = []u32{t.xid}
	mut aborted = []u32{}
	for xid in t.xids {
		if xid == t.xid {
			continue
		}
		if xid < keepSub {
			keptXids = append(keptXids, xid)
		} else {
			aborted = append(aborted, xid)
		}
	}
	if m.nextXid >= m.reservedUntil {
		try m.reserveXids()
	}
	let fresh = m.nextXid
	m.nextXid += 1
	m.active[fresh] = true
	let list = m.subxids[t.xid]
	m.subxids[t.xid] = append(list, fresh)
	keptXids = append(keptXids, fresh)
	for sub in aborted {
		_ = try m.persistState(sub, XidState.Aborted, walXidAbort)
		delete(m.active, sub)
		m.releaseLocks(sub)
		m.releaseTxnSnapshots(sub)
		m.releaseDeleteCommands(sub)
	}
	t.xids = keptXids
	mut keptSp = []SavepointEntry{}
	for i, sp in t.savepoints {
		if i < idx {
			keptSp = append(keptSp, sp)
		} else if i == idx {
			keptSp = append(keptSp, SavepointEntry{Name: sp.Name, Subxid: fresh})
		}
	}
	t.savepoints = keptSp
	t.writeXid = fresh
	m.version += 1
	return
}

// Release drops the named savepoint and every savepoint established after it.
fn (m mut Manager) Release(t mut Txn, name str) ! {
	let idx = lastSavepoint(t, name)
	if idx < 0 {
		fail "3B001 savepoint \"{name}\" does not exist"
	}
	let sub = t.savepoints[idx].Subxid
	_ = try m.persistState(sub, XidState.SubCommitted, walXidSubCommit)
	mut keptSp = []SavepointEntry{}
	for i, sp in t.savepoints {
		if i < idx {
			keptSp = append(keptSp, sp)
		}
	}
	t.savepoints = keptSp
	mut writeXid = t.xid
	if len(t.savepoints) > 0 {
		writeXid = t.savepoints[len(t.savepoints)-1].Subxid
	}
	t.writeXid = writeXid
	m.version += 1
	return
}

fn lastSavepoint(t Txn, name str) i64 {
	mut idx = i64(-1)
	for i, sp in t.savepoints {
		if sp.Name == name {
			idx = i64(i)
		}
	}
	return idx
}

// IsOwnXid reports whether xid belongs to the transaction itself or a subtransaction.
fn (t Txn) IsOwnXid(xid u32) bool {
	return xidIn(xid, t.xids)
}
// State returns the known outcome of xid, treating an unknown id as aborted.
fn (m Manager) State(xid u32) XidState {
	if xid < 3 { return XidState.Committed }
	let (isActive, active) = m.active[xid]
	if active && isActive { return XidState.InProgress }
	return m.clogState(xid)
}

fn (m mut Manager) reserveXids() ! {
	let base = max(m.nextXid, m.reservedUntil)
	let watermark = base + xidBlockSize
	let payload = []u8{1}
	appendU32(mut payload, watermark)
	_ = try m.store.HeapInsert(store.NewXidCtx(2, 0), xactRel, payload)
	let lsn = try m.store.LogRecord(walXidReserve, u32Bytes(watermark))
	try m.store.Sync(lsn)
	m.reservedUntil = watermark
}

fn (m mut Manager) persistState(xid u32, state XidState, outcomeKind u8) !store.Lsn {
	let pageNo = xid / clogPageXids
	mut page = m.clogPage(pageNo)
	setClogBits(mut page, xid % clogPageXids, state)
	let payload = clogPayload(pageNo, page)
	_ = try m.store.HeapInsert(store.NewXidCtx(2, 0), xactRel, payload)
	_ = try m.store.LogRecord(walClogPage, payload)
	let outcomeLsn = try m.store.LogRecord(outcomeKind, u32Bytes(xid))
	m.clog[pageNo] = page
	return outcomeLsn
}

fn (m mut Manager) recoverInflight() ! {
	mut changed = make(map[u32]bool)
	mut xid = u32(3)
	for xid < m.nextXid {
		let state = m.clogState(xid)
		if state == XidState.InProgress || state == XidState.SubCommitted {
			let pageNo = xid / clogPageXids
			mut page = m.clogPage(pageNo)
			setClogBits(mut page, xid % clogPageXids, XidState.Aborted)
			m.clog[pageNo] = page
			changed[pageNo] = true
		}
		xid += 1
	}
	for pageNo, hasChanges in changed {
		if hasChanges {
			let page = m.clog[pageNo]
			let payload = clogPayload(pageNo, page)
			_ = try m.store.HeapInsert(store.NewXidCtx(2, 0), xactRel, payload)
			_ = try m.store.LogRecord(walClogPage, payload)
		}
	}
}

fn (m Manager) clogState(xid u32) XidState {
	let pageNo = xid / clogPageXids
	let (page, ok) = m.clog[pageNo]
	if !ok {
		if xid < m.reservedUntil { return XidState.InProgress }
		return XidState.Aborted
	}
	let offset = xid % clogPageXids
	let byteAt = i64(offset / 4)
	let shift = u16((offset % 4) * 2)
	let state = (page[byteAt] >> shift) & 3
	match state {
		0 => return XidState.InProgress
		1 => return XidState.SubCommitted
		2 => return XidState.Committed
		_ => return XidState.Aborted
	}
}

fn (m Manager) clogPage(pageNo u32) []u8 {
	let (page, ok) = m.clog[pageNo]
	if ok { return cloneBytes(page) }
	return make([]u8, clogPageBytes)
}

fn setClogBits(page mut []u8, offset u32, state XidState) {
	let byteAt = i64(offset / 4)
	let shift = u16((offset % 4) * 2)
	let bits = stateBits(state)
	page[byteAt] = (page[byteAt] & ~(u8(3) << shift)) | (bits << shift)
}

fn stateBits(state XidState) u8 {
	match state {
		InProgress => return 0
		SubCommitted => return 1
		Committed => return 2
		Aborted => return 3
	}
}

fn clogPayload(pageNo u32, page []u8) []u8 {
	mut payload = []u8{2}
	appendU32(mut payload, pageNo)
	payload = append(payload, page...)
	return payload
}

fn u32Bytes(value u32) []u8 {
	mut bytes = []u8{}
	appendU32(mut bytes, value)
	return bytes
}

fn appendU32(out mut []u8, value u32) {
	out = append(out, u8(value >> 24), u8(value >> 16), u8(value >> 8), u8(value))
}

fn readU32(bytes []u8, at i64) u32 {
	return u32(bytes[at]) << 24 | u32(bytes[at+1]) << 16 | u32(bytes[at+2]) << 8 | u32(bytes[at+3])
}

fn cloneBytes(src []u8) []u8 {
	let dst = make([]u8, len(src))
	copy(dst, src)
	return dst
}

// Visible applies PostgreSQL MVCC visibility to a store tuple header.
fn (m Manager) Visible(snap Snapshot, h store.TupleHeader) bool {
	let (visible, _) = m.visibleHeader(snap, h, snap.Cid)
	return visible
}

// HeapTupleVisible applies MVCC visibility to a tuple with its own TID, using the
// recorded delete command id so a transaction still sees its own delete.
fn (m Manager) HeapTupleVisible(snap Snapshot, rel store.RelId, h store.TupleHeader, tid store.Tid) bool {
	return m.TupleHeaderVisible(snap, rel, h.Xmin(), h.Xmax(), h.Cid(), h.Infomask(), tid)
}

// TupleHeaderVisible is HeapTupleVisible over plain header fields, so a caller that
// decodes rows itself needs no store.TupleHeader value.
fn (m Manager) TupleHeaderVisible(snap Snapshot, rel store.RelId, xmin u32, xmax u32, cid u32, infomask u16, tid store.Tid) bool {
	mut cmax = snap.Cid
	if xidIn(xmax, snap.Xids) {
		let key = tupleLockKey(rel, tid)
		let (deleteCommand, ok) = m.deleteCommands[key]
		if ok && deleteCommand.xid == snap.Xid { cmax = deleteCommand.cid }
	}
	let (visible, _) = m.visibleHeaderFields(snap, xmin, xmax, cid, infomask, cmax)
	return visible
}

// VisibleHeader applies MVCC visibility to a decoded value header.
fn (m Manager) VisibleHeader(snap Snapshot, h TupleHeader) bool {
	let (visible, _) = m.visibleHeaderFields(snap, h.Xmin, h.Xmax, h.Cid, h.Infomask, snap.Cid)
	return visible
}

// HeapTupleSatisfiesMVCC is the PostgreSQL name for the visibility rule.
fn (m Manager) HeapTupleSatisfiesMVCC(snap Snapshot, h store.TupleHeader) bool {
	return m.Visible(snap, h)
}

// VisibleTuple applies MVCC visibility and persists final xmin/xmax hint bits.
fn (m mut Manager) VisibleTuple(snap Snapshot, rel store.RelId, tuple store.HeapTuple) bool {
	let pageKey = TuplePageKey{rel: u32(rel), page: u32(tuple.Tid.Page())}
	let (pageVisibility, allVisible) = m.allVisiblePages[pageKey]
	if allVisible && snap.Xmin >= pageVisibility.xmin && snap.Xmax >= pageVisibility.xmax {
		return true
	}
	mut cmax = snap.Cid
	if xidIn(tuple.Header.Xmax(), snap.Xids) {
		let key = tupleLockKey(rel, tuple.Tid)
		let (deleteCommand, hasDeleteCid) = m.deleteCommands[key]
		if hasDeleteCid && deleteCommand.xid == snap.Xid { cmax = deleteCommand.cid }
	}
	let (visible, hints) = m.visibleHeader(snap, tuple.Header, cmax)
	let missingHints = hints & ~tuple.Header.Infomask()
	if missingHints != 0 {
		m.store.SetHint(rel, tuple.Tid, missingHints) catch _ { }
	}
	return visible
}

// HeapInsert writes a tuple with the transaction's current xid and command id.
fn (m mut Manager) HeapInsert(t Txn, rel store.RelId, payload []u8) !store.Tid {
	if !t.active { fail "25000 transaction is not active" }
	let tid = try m.store.HeapInsert(store.NewXidCtx(t.writeXid, t.cid), rel, payload)
	delete(m.allVisiblePages, TuplePageKey{rel: u32(rel), page: u32(tid.Page())})
	return tid
}

// HeapDelete records the current command id for own-delete visibility and updates xmax.
fn (m mut Manager) HeapDelete(t Txn, rel store.RelId, tid store.Tid) ! {
	if !t.active { fail "25000 transaction is not active" }
	try m.store.HeapDelete(store.NewXidCtx(t.writeXid, t.cid), rel, tid)
	delete(m.allVisiblePages, TuplePageKey{rel: u32(rel), page: u32(tid.Page())})
	m.deleteCommands[tupleLockKey(rel, tid)] = DeleteCommand{xid: t.xid, cid: t.cid}
}

// CertifyPageAllVisible records a full-page visibility pass for later snapshots.
// Callers must certify only after every live tuple on the page is known visible.
fn (m mut Manager) CertifyPageAllVisible(rel store.RelId, page u32) {
	m.allVisiblePages[TuplePageKey{rel: u32(rel), page: page}] = PageVisibility{xmin: m.publishedXmin, xmax: m.nextXid}
}

// InvalidatePageVisibility clears a cached page certificate after an external store write.
fn (m mut Manager) InvalidatePageVisibility(rel store.RelId, page u32) {
	delete(m.allVisiblePages, TuplePageKey{rel: u32(rel), page: page})
}

fn (m Manager) visibleHeaderFields(snap Snapshot, xmin u32, xmax u32, cid u32, infomask u16, cmax u32) (bool, u16) {
	mut hints = u16(0)
	let xminBits = infomask & infXminFrozen
	if xmin == 0 || xminBits == infXminInvalid { return false, hints }
	if xidIn(xmin, snap.Xids) {
		if cid >= snap.Cid { return false, hints }
	} else {
		mut committed = xminBits == infXminFrozen || xminBits&infXminCommitted != 0
		if !committed {
			let state = m.State(xmin)
			if state == XidState.Aborted {
				hints |= infXminInvalid
				return false, hints
			}
			if state == XidState.Committed {
				hints |= infXminCommitted
				committed = true
			}
			if !committed { return false, hints }
		}
		if xmin >= snap.Xmin && (xidIn(xmin, snap.Xip) || xmin >= snap.Xmax) { return false, hints }
	}
	let xmaxBits = infomask
	if xmax == 0 || xmaxBits&infXmaxInvalid != 0 || xmaxBits&infXmaxLockOnly != 0 { return true, hints }
	if xidIn(xmax, snap.Xids) {
		return cmax >= snap.Cid, hints
	}
	if xmaxBits&infXmaxCommitted != 0 {
		if xmax < snap.Xmin { return false, hints }
		if xidIn(xmax, snap.Xip) || xmax >= snap.Xmax { return true, hints }
		return false, hints
	}
	if xidIn(xmax, snap.Xip) || xmax >= snap.Xmax { return true, hints }
	let xmaxState = m.State(xmax)
	if xmaxState == XidState.Committed {
		hints |= infXmaxCommitted
		return false, hints
	}
	if xmaxState == XidState.Aborted { hints |= infXmaxInvalid }
	return true, hints
}

fn (m Manager) visibleHeader(snap Snapshot, h store.TupleHeader, cmax u32) (bool, u16) {
	return m.visibleHeaderFields(snap, h.Xmin(), h.Xmax(), h.Cid(), h.Infomask(), cmax)
}

// HeapTupleSatisfiesDirty reports whether a write must wait before it can inspect this tuple.
fn (m Manager) HeapTupleSatisfiesDirty(t Txn, h store.TupleHeader) TupleCheck {
	let xmin = h.Xmin()
	let xminBits = h.Infomask() & infXminFrozen
	mut xminState = m.State(xmin)
	if xminBits == infXminFrozen || xminBits&infXminCommitted != 0 { xminState = XidState.Committed }
	if xmin == 0 || xminBits == infXminInvalid || xminState == XidState.Aborted {
		return TupleCheck{Code: TupleCheckCode.Invisible, By: 0, Ctid: h.Ctid()}
	}
	if t.IsOwnXid(xmin) && h.Cid() >= t.cid {
		return TupleCheck{Code: TupleCheckCode.Invisible, By: 0, Ctid: h.Ctid()}
	}
	if !t.IsOwnXid(xmin) && (xminState == XidState.InProgress || xminState == XidState.SubCommitted) {
		return TupleCheck{Code: TupleCheckCode.BeingModified, By: xmin, Ctid: h.Ctid()}
	}
	let xmax = h.Xmax()
	let xmaxBits = h.Infomask()
	if xmax == 0 || xmaxBits&infXmaxInvalid != 0 {
		return TupleCheck{Code: TupleCheckCode.Ok, By: 0, Ctid: h.Ctid()}
	}
	if t.IsOwnXid(xmax) {
		return TupleCheck{Code: TupleCheckCode.SelfModified, By: xmax, Ctid: h.Ctid()}
	}
	let xmaxState = m.State(xmax)
	if xmaxBits&infXmaxLockOnly != 0 {
		if xmaxState == XidState.InProgress || xmaxState == XidState.SubCommitted {
			return TupleCheck{Code: TupleCheckCode.BeingModified, By: xmax, Ctid: h.Ctid()}
		}
		return TupleCheck{Code: TupleCheckCode.Ok, By: 0, Ctid: h.Ctid()}
	}
	if xmaxBits&infXmaxCommitted != 0 { return TupleCheck{Code: TupleCheckCode.Updated, By: xmax, Ctid: h.Ctid()} }
	if xmaxState == XidState.InProgress || xmaxState == XidState.SubCommitted {
		return TupleCheck{Code: TupleCheckCode.BeingModified, By: xmax, Ctid: h.Ctid()}
	}
	if xmaxState == XidState.Committed {
		return TupleCheck{Code: TupleCheckCode.Updated, By: xmax, Ctid: h.Ctid()}
	}
	return TupleCheck{Code: TupleCheckCode.Ok, By: 0, Ctid: h.Ctid()}
}

// HeapTupleSatisfiesUpdate returns the executor's update result for the current transaction.
fn (m Manager) HeapTupleSatisfiesUpdate(t Txn, h store.TupleHeader) TupleCheck {
	return m.HeapTupleSatisfiesDirty(t, h)
}

// FinishStatement advances the caller's command counter.
fn FinishStatement(t mut Txn) {
	t.cid += 1
}

fn (m Manager) activeXids() []u32 {
	return m.publishedXip
}

fn (m mut Manager) refreshPublishedXip() {
	mut out = []u32{}
	mut xmin = m.nextXid
	for xid, isActive in m.active {
		if isActive {
			out = append(out, xid)
			if xid < xmin { xmin = xid }
		}
	}
	m.publishedXip = out
	m.publishedXmin = xmin
}

fn (m Manager) minimumActive(fallback u32) u32 {
	mut xmin = fallback
	for xid, isActive in m.active {
		if isActive && xid < xmin {
			xmin = xid
		}
	}
	return xmin
}

fn xidIn(xid u32, xs []u32) bool {
	for x in xs {
		if xid == x {
			return true
		}
	}
	return false
}

fn tupleLockKey(rel store.RelId, tid store.Tid) TupleLockKey {
	return TupleLockKey{rel: u32(rel), page: u32(tid.Page()), slot: tid.Slot()}
}

// LockRelation acquires a relation lock if no incompatible holder exists.
fn (m mut Manager) LockRelation(t Txn, rel u32, mode LockMode) ! {
	if !m.TryLockRelation(t, rel, mode) {
		fail "55P03 could not obtain lock on relation"
	}
	return
}

// TryLockRelation checks and acquires without allocating an error on contention.
fn (m mut Manager) TryLockRelation(t Txn, rel u32, mode LockMode) bool {
	let key = LockKey{rel: rel}
	let holders = m.locks[key]
	for h in holders {
		if h.xid == t.writeXid && h.mode == mode { return true }
		if h.xid != t.writeXid && conflicts(mode, h.mode) {
			return false
		}
	}
	m.locks[key] = append(holders, LockHolder{xid: t.xid, mode: mode})
	return true
}

// LockTuple acquires a tuple lock if no incompatible holder owns that tuple.
fn (m mut Manager) LockTuple(t Txn, rel u32, page u32, slot u16, mode TupleLock) ! {
	let key = TupleLockKey{rel: rel, page: page, slot: slot}
	let holders = m.tupleLocks[key]
	for h in holders {
		if h.xid == t.writeXid && h.mode == mode { return }
		if h.xid != t.writeXid && tupleConflicts(mode, h.mode) {
			fail "55P03 could not obtain lock on tuple"
		}
	}
	m.tupleLocks[key] = append(holders, TupleLockHolder{xid: t.xid, mode: mode})
	return
}

fn tupleConflicts(a TupleLock, b TupleLock) bool {
	match a {
		ForKeyShare => return b == TupleLock.ForUpdate
		ForShare => return b == TupleLock.ForNoKeyUpdate || b == TupleLock.ForUpdate
		ForNoKeyUpdate => return b == TupleLock.ForShare || b == TupleLock.ForNoKeyUpdate || b == TupleLock.ForUpdate
		ForUpdate => return true
	}
}

fn conflicts(a LockMode, b LockMode) bool {
	match a {
		AccessShare => return b == LockMode.AccessExclusive
		RowShare => return b == LockMode.Exclusive || b == LockMode.AccessExclusive
		RowExclusive => return b == LockMode.Share || b == LockMode.ShareRowExclusive || b == LockMode.Exclusive || b == LockMode.AccessExclusive
		ShareUpdateExclusive => return b == LockMode.ShareUpdateExclusive || b == LockMode.Share || b == LockMode.ShareRowExclusive || b == LockMode.Exclusive || b == LockMode.AccessExclusive
		Share => return b == LockMode.RowExclusive || b == LockMode.ShareUpdateExclusive || b == LockMode.Share || b == LockMode.ShareRowExclusive || b == LockMode.Exclusive || b == LockMode.AccessExclusive
		ShareRowExclusive => return b != LockMode.AccessShare
		Exclusive => return b != LockMode.AccessShare && b != LockMode.RowShare
		AccessExclusive => return true
	}
}

fn (m mut Manager) releaseLocks(xid u32) {
	for key, holders in m.locks {
		mut kept = []LockHolder{}
		for h in holders {
			if h.xid != xid {
				kept = append(kept, h)
			}
		}
		m.locks[key] = kept
	}
	for key, holders in m.tupleLocks {
		mut kept = []TupleLockHolder{}
		for h in holders {
			if h.xid != xid {
				kept = append(kept, h)
			}
		}
		m.tupleLocks[key] = kept
	}
}
