package catalog

import "../store"
import "../txn"
import "../types"
import "mint"

// Oid is a PostgreSQL object identifier.
type Oid = u32

// Column describes one visible attribute of a relation.
type Column struct {
	Name str
	Type Oid
	Typmod i32
	Number i16
	Nullable bool
	HasDefault bool
	DefaultText str
	Identity str
	Generated str
	Collation Oid
}

// ColumnDef is one requested column in a CREATE TABLE.
type ColumnDef struct {
	Name str
	Type Oid
	Typmod i32
	Nullable bool
	DefaultText str
	NotNull bool
}

// Index describes an index attached to a table.
type Index struct {
	Oid Oid
	Name str
	Rel u32
	Unique bool
	Cols []i16
}

// Table is a catalog relation descriptor.
type Table struct {
	Oid Oid
	Schema str
	Name str
	Cols []Column
	Rel u32
	Indexes []Index
	CreatedBy u32
	CreatedCommand u32
	DroppedBy u32
	DroppedCommand u32
	System bool
	Owner u32
	Kind str
	RowType u32
}

// TableDef describes a table to create.
type TableDef struct {
	Schema str
	Name str
	Columns []ColumnDef
	PrimaryKey []i16
}

// IndexDef describes an index to create.
type IndexDef struct {
	Table Table
	Name str
	Unique bool
	Cols []i16
	Primary bool
}

// SequenceDef describes a CREATE SEQUENCE.
type SequenceDef struct {
	Schema str
	Name str
	Type Oid
	Start i64
	Increment i64
	Min i64
	Max i64
	Cache i64
	Cycle bool
}

// ViewDef describes a CREATE VIEW.
type ViewDef struct {
	Schema str
	Name str
	Columns []ColumnDef
	Query str
}

// Catalog stores transactional relation metadata in the pg_catalog heaps and keeps
// a decoded row cache rebuilt whenever the catalog version changes.
type Catalog struct {
	Store store.Store
	Manager txn.Manager
	rows map[str][]RawRow
	sysCols map[str][]ColDef
	relIds map[str]u32
	searchPaths map[u32][]str
	nextOid u32
	nextRel u32
	version u64
}

// Open bootstraps pg_catalog on an empty data directory and loads the row cache.
fn Open(s mut store.Store, m txn.Manager) !Catalog {
	mut b = Bootstrapper{Store: s, sysCols: make(map[str][]ColDef), relIds: make(map[str]u32)}
	try b.bootstrap()
	let (rows, nextOid, nextRel) = loadRows(mut s, b.sysCols, b.relIds)
	mut c = Catalog{Store: s, Manager: m, rows: rows, sysCols: b.sysCols, relIds: b.relIds, searchPaths: make(map[u32][]str), nextOid: nextOid, nextRel: nextRel, version: 1}
	return c
}

const pgCatalogOid u32 = 11
const publicOid u32 = 2200

// LookupTable resolves a visible table by explicit schema or the transaction search path.
fn (c Catalog) LookupTable(t txn.Txn, schema str, name str) ?Table {
	let snap = c.Manager.Snapshot(t)
	if schema != "" {
		return c.lookupInSchema(snap, schema, name)
	}
	for path in c.SearchPath(t) {
		let found = c.lookupInSchema(snap, path, name)
		if found != nil {
			return found
		}
	}
	return nil
}

// LookupTableOid rebuilds a table descriptor by oid.
fn (c Catalog) LookupTableOid(t txn.Txn, oid Oid) ?Table {
	let snap = c.Manager.Snapshot(t)
	return c.lookupByOid(snap, oid)
}

// SystemTable returns one bootstrapped pg_catalog relation descriptor by name.
fn (c Catalog) SystemTable(name str) ?Table {
	let snap = c.bootSnapshot()
	return c.lookupInSchema(snap, "pg_catalog", name)
}

// SearchPath returns the configured schema order or PostgreSQL's default.
fn (c Catalog) SearchPath(t txn.Txn) []str {
	let (path, ok) = c.searchPaths[t.Xid()]
	if ok {
		return path
	}
	return []str{"pg_catalog", "public"}
}

// SetSearchPath sets the transaction-local schema search order.
fn (c mut Catalog) SetSearchPath(t txn.Txn, path []str) {
	c.searchPaths[t.Xid()] = path
	c.version += 1
}

// Version returns the catalog version used to invalidate cached plans.
fn (c Catalog) Version() u64 {
	return c.version
}

// LookupType returns the PostgreSQL OID for a built-in type name.
fn (c Catalog) LookupType(name str) ?Oid {
	return match name {
		"bool", "boolean" => 16
		"bytea" => 17
		"char", "\"char\"" => 18
		"name" => 19
		"int8", "bigint" => 20
		"int2", "smallint" => 21
		"int4", "integer", "int" => 23
		"text" => 25
		"oid" => 26
		"json" => 114
		"float4", "real" => 700
		"float8", "double precision" => 701
		"bpchar", "character" => 1042
		"varchar", "character varying" => 1043
		"date" => 1082
		"time" => 1083
		"timestamp" => 1114
		"timestamptz", "timestamp with time zone" => 1184
		"interval" => 1186
		"numeric", "decimal" => 1700
		"uuid" => 2950
		"jsonb" => 3802
		_ => nil
	}
}

fn (c Catalog) bootSnapshot() txn.Snapshot {
	return txn.Snapshot{Xmin: 3, Xmax: c.Manager.NextXid(), Xip: []u32{}, Xid: 0, Cid: 0}
}

fn (c Catalog) lookupInSchema(snap txn.Snapshot, schema str, name str) ?Table {
	let ns = c.namespaceOid(snap, schema)
	if ns == 0 {
		return nil
	}
	for row in c.rows["pg_class"] {
		if !c.visible(snap, "pg_class", row) {
			continue
		}
		if c.textField("pg_class", row, "relname") != name {
			continue
		}
		if u32(c.intField("pg_class", row, "relnamespace")) != ns {
			continue
		}
		let kind = c.textField("pg_class", row, "relkind")
		if !isRelationKind(kind) {
			continue
		}
		return c.tableFromClass(snap, row)
	}
	return nil
}

fn (c Catalog) lookupByOid(snap txn.Snapshot, oid Oid) ?Table {
	for row in c.rows["pg_class"] {
		if !c.visible(snap, "pg_class", row) {
			continue
		}
		if u32(c.intField("pg_class", row, "oid")) != oid {
			continue
		}
		if !isRelationKind(c.textField("pg_class", row, "relkind")) {
			continue
		}
		return c.tableFromClass(snap, row)
	}
	return nil
}

fn isRelationKind(kind str) bool {
	return kind == "r" || kind == "p" || kind == "v" || kind == "m" || kind == "S" || kind == "f"
}

fn (c Catalog) namespaceOid(snap txn.Snapshot, schema str) u32 {
	if schema == "pg_temp" {
		return 0
	}
	for row in c.rows["pg_namespace"] {
		if !c.visible(snap, "pg_namespace", row) {
			continue
		}
		if c.textField("pg_namespace", row, "nspname") == schema {
			return u32(c.intField("pg_namespace", row, "oid"))
		}
	}
	return 0
}

fn (c Catalog) namespaceName(snap txn.Snapshot, oid u32) str {
	for row in c.rows["pg_namespace"] {
		if !c.visible(snap, "pg_namespace", row) {
			continue
		}
		if u32(c.intField("pg_namespace", row, "oid")) == oid {
			return c.textField("pg_namespace", row, "nspname")
		}
	}
	return ""
}

// LookupNamespace returns the oid of a visible schema.
fn (c Catalog) LookupNamespace(t txn.Txn, schema str) Oid {
	return c.namespaceOid(c.Manager.Snapshot(t), schema)
}

fn (c Catalog) tableFromClass(snap txn.Snapshot, row RawRow) ?Table {
	let oid = u32(c.intField("pg_class", row, "oid"))
	let ns = u32(c.intField("pg_class", row, "relnamespace"))
	return Table{
		Oid: oid,
		Schema: c.namespaceName(snap, ns),
		Name: c.textField("pg_class", row, "relname"),
		Cols: c.attributesFor(snap, oid),
		Rel: u32(c.intField("pg_class", row, "relfilenode")),
		Indexes: c.indexesFor(snap, oid),
		CreatedBy: row.Xmin,
		CreatedCommand: row.Cid,
		DroppedBy: row.Xmax,
		DroppedCommand: 0,
		System: ns == pgCatalogOid,
		Owner: u32(c.intField("pg_class", row, "relowner")),
		Kind: c.textField("pg_class", row, "relkind"),
		RowType: u32(c.intField("pg_class", row, "reltype")),
	}
}

fn (c Catalog) attributesFor(snap txn.Snapshot, oid u32) []Column {
	mut found = []Column{}
	mut nums = []i16{}
	for row in c.rows["pg_attribute"] {
		if !c.visible(snap, "pg_attribute", row) {
			continue
		}
		if u32(c.intField("pg_attribute", row, "attrelid")) != oid {
			continue
		}
		let num = i16(c.intField("pg_attribute", row, "attnum"))
		if num <= 0 || c.boolField("pg_attribute", row, "attisdropped") {
			continue
		}
		mut col = Column{
			Name: c.textField("pg_attribute", row, "attname"),
			Type: u32(c.intField("pg_attribute", row, "atttypid")),
			Typmod: i32(c.intField("pg_attribute", row, "atttypmod")),
			Number: num,
			Nullable: !c.boolField("pg_attribute", row, "attnotnull"),
			HasDefault: c.boolField("pg_attribute", row, "atthasdef"),
			Identity: c.textField("pg_attribute", row, "attidentity"),
			Generated: c.textField("pg_attribute", row, "attgenerated"),
			Collation: u32(c.intField("pg_attribute", row, "attcollation")),
		}
		if col.HasDefault {
			col.DefaultText = c.defaultTextFor(snap, oid, num)
		}
		found = append(found, col)
		nums = append(nums, num)
	}
	// Insertion sort by attnum keeps dropped and re-added columns stable.
	for i in 1..len(found) {
		mut j = i
		for j > 0 && nums[j-1] > nums[j] {
			let tmpC = found[j-1]
			found[j-1] = found[j]
			found[j] = tmpC
			let tmpN = nums[j-1]
			nums[j-1] = nums[j]
			nums[j] = tmpN
			j -= 1
		}
	}
	return found
}

fn (c Catalog) defaultTextFor(snap txn.Snapshot, oid u32, attnum i16) str {
	for row in c.rows["pg_attrdef"] {
		if !c.visible(snap, "pg_attrdef", row) {
			continue
		}
		if u32(c.intField("pg_attrdef", row, "adrelid")) != oid {
			continue
		}
		if i16(c.intField("pg_attrdef", row, "adnum")) != attnum {
			continue
		}
		return c.textField("pg_attrdef", row, "adbin")
	}
	return ""
}

fn (c Catalog) indexesFor(snap txn.Snapshot, oid u32) []Index {
	mut out = []Index{}
	for row in c.rows["pg_index"] {
		if !c.visible(snap, "pg_index", row) {
			continue
		}
		if u32(c.intField("pg_index", row, "indrelid")) != oid {
			continue
		}
		let idxOid = u32(c.intField("pg_index", row, "indexrelid"))
		out = append(out, Index{
			Oid: idxOid,
			Name: c.relationName(snap, idxOid),
			Rel: c.relationFilenode(snap, idxOid),
			Unique: c.boolField("pg_index", row, "indisunique"),
		})
	}
	return out
}

fn (c Catalog) relationName(snap txn.Snapshot, oid u32) str {
	for row in c.rows["pg_class"] {
		if !c.visible(snap, "pg_class", row) {
			continue
		}
		if u32(c.intField("pg_class", row, "oid")) == oid {
			return c.textField("pg_class", row, "relname")
		}
	}
	return ""
}

fn (c Catalog) relationFilenode(snap txn.Snapshot, oid u32) u32 {
	for row in c.rows["pg_class"] {
		if !c.visible(snap, "pg_class", row) {
			continue
		}
		if u32(c.intField("pg_class", row, "oid")) == oid {
			return u32(c.intField("pg_class", row, "relfilenode"))
		}
	}
	return 0
}

// findClassRow returns the visible pg_class row for an oid.
fn (c Catalog) findClassRow(snap txn.Snapshot, oid u32) ?RawRow {
	for row in c.rows["pg_class"] {
		if !c.visible(snap, "pg_class", row) {
			continue
		}
		if u32(c.intField("pg_class", row, "oid")) == oid && isRelationKind(c.textField("pg_class", row, "relkind")) {
			return row
		}
	}
	return nil
}
