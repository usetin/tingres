package main

import "quarry"
import "say"
import "tide"

fn main() ! {
	let rows = 1000000
	mut seed i64 = 42
	mut i i64 = 0
	say.Line("-- generated bench data")
	say.Line("CREATE TABLE IF NOT EXISTS bench_accounts (aid int PRIMARY KEY, bid int, abalance int, filler char(84));")
	for i < rows {
		seed = seed * 1103515245 + 12345
		let bid = (seed % 10) + 1
		say.Out("INSERT INTO bench_accounts VALUES ({i+1},{bid},0,'');\n")
		i += 1
	}
	_ = tide.Now()
	_ = quarry.Args()
}
