package types

import "gauge"
import "mint"
import "twine"

const NumericBase i64 = 10000
const numericDecDigits i64 = 4
const minNumericSigDigits i64 = 16
const maxNumericDisplayScale i64 = 1000

// Numeric stores PostgreSQL base-10000 digits and the display scale.
type Numeric value struct {
	sign i64
	weight i64
	dscale i64
	digits []i64
	special i64
}

fn float_text(d Datum) str {
	if d.f != d.f { return "NaN" }
	if d.f == 0.0 && gauge.Signbit(d.f) { return "-0" }
	if d.f == gauge.Inf(1) { return "Infinity" }
	if d.f == gauge.Inf(-1) { return "-Infinity" }
	if d.oid == Float4Oid { return pg_float_text(d.f, true) }
	return pg_float_text(d.f, false)
}

// pg_float_text renders a float the way PostgreSQL 17 does: shortest
// round-trip digits, fixed notation for display exponents in [-4, 14] and
// scientific notation (d.dd e±NN) otherwise.
fn pg_float_text(v f64, narrow bool) str {
	mut sign = ""
	if gauge.Signbit(v) { sign = "-" }
	mut digits = ""
	mut exp = i64(0)
	if narrow {
		let (d, e) = shortest_float4_digits(v)
		digits = d
		exp = e
	} else {
		let (d, e) = parse_float_sci(mint.FormatFloat(v, 'e', -1))
		digits = d
		exp = e
	}
	if exp >= -4 && exp < 15 { return sign+format_float_fixed(digits, exp) }
	return sign+format_float_sci(digits, exp)
}

fn shortest_float4_digits(v f64) (str, i64) {
	for p in 1..10 {
		let candidate = mint.FormatFloat(v, 'e', p-1)
		let parsed = mint.ParseFloat(candidate) catch _ { continue }
		if f32(parsed) == f32(v) { return parse_float_sci(candidate) }
	}
	return parse_float_sci(mint.FormatFloat(v, 'e', -1))
}

// parse_float_sci splits Go's scientific form (for example "1.25e-01") into
// its significant digits and the power of ten of the leading digit.
fn parse_float_sci(s str) (str, i64) {
	let eAt = find_byte(s, 'e', 0)
	mut mantissa = s
	mut exponent = i64(0)
	if eAt >= 0 {
		mantissa = s[:eAt]
		exponent = mint.Atoi(s[eAt+1:]) catch _ { 0 }
	}
	mut digits = ""
	for c in mantissa {
		if c >= '0' && c <= '9' { digits += str([]u8{u8(c)}) }
	}
	digits = strip_leading_zeroes(digits)
	if len(digits) == 0 { return "0", 0 }
	return digits, exponent
}

fn format_float_fixed(digits str, exp i64) str {
	let nexp = exp+1
	let n = len(digits)
	if nexp <= 0 { return "0."+zeroes(0-nexp)+digits }
	if nexp >= n { return digits+zeroes(nexp-n) }
	return digits[:nexp]+"."+digits[nexp:]
}

fn format_float_sci(digits str, exp i64) str {
	let trimmed = twine.TrimRight(digits, "0")
	mut mantissa = trimmed
	if len(trimmed) == 0 { mantissa = "0" }
	mut body = mantissa
	if len(mantissa) > 1 { body = mantissa[:1]+"."+mantissa[1:] }
	mut sign = "+"
	mut value = exp
	if exp < 0 {
		sign = "-"
		value = 0-exp
	}
	mut exponentText = mint.Itoa(value)
	if len(exponentText) < 2 { exponentText = "0"+exponentText }
	return body+"e"+sign+exponentText
}

fn compare_float(a f64, b f64) i64 {
	let aNan = a != a
	let bNan = b != b
	if aNan {
		if bNan { return 0 }
		return 1
	}
	if bNan { return -1 }
	if a < b { return -1 }
	if a > b { return 1 }
	return 0
}

// ParseNumeric parses PostgreSQL decimal syntax into a numeric Datum.
fn ParseNumeric(text str) !Datum {
	let n = try parse_numeric_value(text)
	return FromStr(NumericOid, format_numeric(n))
}

// ParseNumericTypmod parses and applies PostgreSQL numeric precision and scale.
fn ParseNumericTypmod(text str, precision i64, scale i64) !Datum {
	if precision < 1 || precision > 1000 || scale < -1000 || scale > 1000 {
		fail ErrorFault(NewError("22023", "numeric field overflow"))
	}
	let n = try parse_numeric_value(text)
	if n.special != 0 { return FromStr(NumericOid, format_numeric(n)) }
	let rounded = numeric_round_value(n, scale)
	let rendered = format_numeric(rounded)
	let dot = find_dot(rendered)
	mut integerText = rendered
	if dot >= 0 { integerText = rendered[:dot] }
	if len(integerText) > 0 && integerText[0] == '-' { integerText = integerText[1:] }
	let integerDigits = len(strip_leading_zeroes(integerText))
	if rounded.sign != 0 && integerDigits > precision-scale {
		fail ErrorFault(NewError("22003", "numeric field overflow"))
	}
	return FromStr(NumericOid, format_numeric(rounded))
}

// NumericText returns the exact PostgreSQL text representation of a numeric Datum.
fn NumericText(d Datum) str {
	let n = parse_numeric_value(d.s) catch _ { return d.s }
	return format_numeric(n)
}

// EncodeNumericBinary appends PostgreSQL's base-10000 numeric wire representation.
fn EncodeNumericBinary(d Datum, out mut []u8) {
	let n = parse_numeric_value(NumericText(d)) catch _ { return }
	let wireDigits = canonical_wire_digits(n)
	put_u16(mut out, u16(len(wireDigits)))
	put_u16(mut out, u16(i16(n.weight)))
	mut sign = u16(0)
	if n.special == 2 { sign = 0xC000 } else if n.special == 1 { sign = 0xD000 } else if n.special == -1 { sign = 0xF000 } else if n.sign < 0 { sign = 0x4000 }
	put_u16(mut out, sign)
	put_u16(mut out, u16(n.dscale))
	for digit in wireDigits { put_u16(mut out, u16(digit)) }
}

// DecodeNumericBinary reads PostgreSQL's base-10000 numeric wire representation.
fn DecodeNumericBinary(b []u8) !Datum {
	if len(b) < 8 { fail PgFault("22P03", "invalid binary representation for type numeric") }
	let count = i64(i16(read_u16(b, 0)))
	let weight = i64(i16(read_u16(b, 2)))
	let sign = read_u16(b, 4)
	let scale = i64(read_u16(b, 6))
	if count < 0 || len(b) != 8+count*2 { fail PgFault("22P03", "invalid binary representation for type numeric") }
	mut special = i64(0)
	mut numericSign = i64(1)
	if sign == 0xC000 { special = 2 } else if sign == 0xD000 { special = 1 } else if sign == 0xF000 { special = -1 } else if sign == 0x4000 { numericSign = -1 } else if sign != 0 { fail PgFault("22P03", "invalid binary representation for type numeric") }
	mut digits = []i64{}
	for i in 0..count {
		let digit = i64(read_u16(b, 8+i*2))
		if digit >= NumericBase { fail PgFault("22P03", "invalid binary representation for type numeric") }
		digits = append(digits, digit)
	}
	if special != 0 { return FromStr(NumericOid, format_numeric(Numeric{sign: numericSign, weight: 0, dscale: scale, digits: []i64{}, special: special})) }
	if count == 0 { numericSign = 0 }
	return FromStr(NumericOid, format_numeric(Numeric{sign: numericSign, weight: weight, dscale: scale, digits: digits, special: 0}))
}

fn canonical_wire_digits(n Numeric) []i64 {
	if n.special != 0 || n.sign == 0 { return []i64{} }
	return n.digits
}

fn parse_numeric_value(raw str) !Numeric {
	let s = twine.TrimSpace(raw)
	if s == "NaN" || s == "nan" || s == "NAN" {
		return Numeric{sign: 1, weight: 0, dscale: 0, digits: []i64{}, special: 2}
	}
	if s == "Infinity" || s == "+Infinity" || s == "infinity" || s == "+infinity" {
		return Numeric{sign: 1, weight: 0, dscale: 0, digits: []i64{}, special: 1}
	}
	if s == "-Infinity" || s == "-infinity" {
		return Numeric{sign: -1, weight: 0, dscale: 0, digits: []i64{}, special: -1}
	}
	if len(s) == 0 { fail ErrorFault(NewError("22P02", "invalid input syntax for type numeric: \"{raw}\"")) }
	mut sign = i64(1)
	mut at = i64(0)
	if s[0] == '-' {
		sign = -1
		at = 1
	} else if s[0] == '+' {
		at = 1
	}
	let exponentAt = find_exp(s, at)
	mut exp = i64(0)
	mut mantissaEnd = len(s)
	if exponentAt >= 0 {
		mantissaEnd = exponentAt
		let expText = s[exponentAt+1:]
		if len(expText) == 0 { fail ErrorFault(NewError("22P02", "invalid input syntax for type numeric: \"{raw}\"")) }
		exp = mint.Atoi(expText) catch _ { fail ErrorFault(NewError("22P02", "invalid input syntax for type numeric: \"{raw}\"")) }
		if exp < -10000 || exp > 10000 { fail ErrorFault(NewError("22003", "value overflows numeric format")) }
	}
	mut dotAt = -1
	mut digitCount = i64(0)
	for i in at..mantissaEnd {
		let c = s[i]
		if c >= '0' && c <= '9' { digitCount += 1 } else if c == '.' && dotAt < 0 { dotAt = i } else { fail ErrorFault(NewError("22P02", "invalid input syntax for type numeric: \"{raw}\"")) }
	}
	if digitCount == 0 { fail ErrorFault(NewError("22P02", "invalid input syntax for type numeric: \"{raw}\"")) }
	mut intEnd = dotAt
	mut fracStart = dotAt+1
	if dotAt < 0 {
		intEnd = mantissaEnd
		fracStart = mantissaEnd
	}
	let intRaw = s[at:intEnd]
	let fracRaw = s[fracStart:mantissaEnd]
	mut all = ""
	for i in at..mantissaEnd { if s[i] != '.' { all += str(s[i]) } }
	let decimalAt = len(intRaw)+exp
	mut whole = ""
	mut fraction = ""
	if decimalAt <= 0 {
		whole = "0"
		fraction = zeroes(-decimalAt)+all
	} else if decimalAt >= len(all) {
		whole = all+zeroes(decimalAt-len(all))
	} else {
		whole = all[:decimalAt]
		fraction = all[decimalAt:]
	}
	_ = fracRaw
	whole = strip_leading_zeroes(whole)
	if whole == "" { whole = "0" }
	let scale = len(fraction)
	let intPad = (4-len(whole)%4)%4
	let paddedWhole = zeroes(intPad)+whole
	let paddedFraction = fraction+zeroes((4-len(fraction)%4)%4)
	mut groups = []i64{}
	for i in 0..len(paddedWhole)/4 {
		let group = mint.Atoi(paddedWhole[i*4:i*4+4]) catch _ { 0 }
		groups = append(groups, group)
	}
	for i in 0..len(paddedFraction)/4 {
		let group = mint.Atoi(paddedFraction[i*4:i*4+4]) catch _ { 0 }
		groups = append(groups, group)
	}
	mut weight = len(paddedWhole)/4-1
	for len(groups) > 0 && groups[0] == 0 {
		groups = groups[1:]
		weight -= 1
	}
	for len(groups) > 0 && groups[len(groups)-1] == 0 { groups = groups[:len(groups)-1] }
	mut nonzero = false
	for g in groups { if g != 0 { nonzero = true } }
	if !nonzero {
		sign = 0
		weight = 0
		groups = []i64{}
	}
	return Numeric{sign: sign, weight: weight, dscale: scale, digits: groups, special: 0}
}

fn find_exp(s str, from i64) i64 {
	for i in from..len(s) {
		if s[i] == 'e' || s[i] == 'E' { return i }
	}
	return -1
}

fn strip_leading_zeroes(s str) str {
	mut i = i64(0)
	for i < len(s) && s[i] == '0' { i += 1 }
	return s[i:]
}

fn zeroes(n i64) str {
	mut out = ""
	for i in 0..n {
		out += "0"
		_ = i
	}
	return out
}

fn format_numeric(n Numeric) str {
	if n.special == 2 { return "NaN" }
	if n.special == 1 { return "Infinity" }
	if n.special == -1 { return "-Infinity" }
	let negative = n.sign < 0
	mut whole = "0"
	if n.sign != 0 && n.weight >= 0 {
		whole = mint.Itoa(n.digits[0])
		for idx in 1..n.weight+1 {
			if idx < len(n.digits) { whole += numeric_group_text(n.digits[idx]) } else { whole += "0000" }
		}
	}
	mut out = whole
	if negative { out = "-"+whole }
	if n.dscale > 0 {
		mut frac = ""
		let fracGroups = (n.dscale+3)/4
		for j in 0..fracGroups {
			let idx = n.weight+1+j
			if n.sign != 0 && idx >= 0 && idx < len(n.digits) { frac += numeric_group_text(n.digits[idx]) } else { frac += "0000" }
		}
		out += "."+frac[:n.dscale]
	}
	return out
}

fn numeric_group_text(v i64) str {
	let s = mint.Itoa(v)
	return zeroes(4-len(s))+s
}

// NumericAdd adds two numeric Datums without converting through floating point.
fn NumericAdd(a Datum, b Datum) !Datum { return try numeric_binary(a, b, 0) }

// NumericSub subtracts b from a without converting through floating point.
fn NumericSub(a Datum, b Datum) !Datum { return try numeric_binary(a, b, 1) }

fn numeric_binary(a Datum, b Datum, op i64) !Datum {
	let x = try parse_numeric_value(NumericText(a))
	let y0 = try parse_numeric_value(NumericText(b))
	if x.special != 0 || y0.special != 0 { return try numeric_special_binary(x, y0, op) }
	mut y = y0
	if op == 1 { y = numeric_neg_value(y0) }
	if x.sign == 0 && y.sign == 0 { return FromStr(NumericOid, zero_with_scale(max(x.dscale, y.dscale))) }
	if x.sign == 0 { return FromStr(NumericOid, format_numeric(with_scale(y, max(x.dscale, y.dscale)))) }
	if y.sign == 0 { return FromStr(NumericOid, format_numeric(with_scale(x, max(x.dscale, y.dscale)))) }
	mut high = max(x.weight, y.weight)
	let low = min(numeric_low_exp(x), numeric_low_exp(y))
	let n = high-low+1
	mut xs = []i64{}
	mut ys = []i64{}
	for i in 0..n {
		let exp = high-i
		xs = append(xs, numeric_digit_at(x, exp))
		ys = append(ys, numeric_digit_at(y, exp))
	}
	mut sign = x.sign
	mut digits = []i64{}
	for i in 0..n {
		digits = append(digits, 0)
		_ = i
	}
	if x.sign == y.sign {
		mut carry = i64(0)
		for k in 0..n {
			let i = n-1-k
			let v = xs[i]+ys[i]+carry
			digits[i] = v%NumericBase
			carry = v/NumericBase
		}
		if carry > 0 {
			mut shifted = []i64{carry}
			shifted = append(shifted, digits...)
			digits = shifted
			high += 1
		}
	} else {
		let cmp = numeric_abs_compare(x, y)
		if cmp == 0 { return FromStr(NumericOid, zero_with_scale(max(x.dscale, y.dscale))) }
		mut larger = xs
		mut smaller = ys
		if cmp < 0 {
			larger = ys
			smaller = xs
		}
		if cmp < 0 { sign = y.sign }
		mut borrow = i64(0)
		for k in 0..n {
			let i = n-1-k
			mut v = larger[i]-smaller[i]-borrow
			borrow = 0
			if v < 0 {
				v += NumericBase
				borrow = 1
			}
			digits[i] = v
		}
	}
	let mutN = numeric_from_dense(sign, high, max(x.dscale, y.dscale), digits)
	return FromStr(NumericOid, format_numeric(mutN))
}

// NumericMul multiplies two numeric Datums with base-10000 arithmetic.
fn NumericMul(a Datum, b Datum) !Datum {
	let x = try parse_numeric_value(NumericText(a))
	let y = try parse_numeric_value(NumericText(b))
	if x.special != 0 || y.special != 0 { return FromStr(NumericOid, numeric_special_mul(x, y)) }
	if x.sign == 0 || y.sign == 0 { return FromStr(NumericOid, zero_with_scale(x.dscale+y.dscale)) }
	let xa = reverse_i64(x.digits)
	let ya = reverse_i64(y.digits)
	mut out = []i64{}
	for i in 0..len(xa)+len(ya)+1 {
		out = append(out, 0)
		_ = i
	}
	for i in 0..len(xa) {
		mut carry = i64(0)
		for j in 0..len(ya) {
			let k = i+j
			let v = out[k]+xa[i]*ya[j]+carry
			out[k] = v%NumericBase
			carry = v/NumericBase
		}
		mut k = i+len(ya)
		for carry > 0 {
			let v = out[k]+carry
			out[k] = v%NumericBase
			carry = v/NumericBase
			k += 1
		}
	}
	for len(out) > 0 && out[len(out)-1] == 0 { out = out[:len(out)-1] }
	let digits = reverse_i64(out)
	let productWeight = numeric_low_exp(x)+numeric_low_exp(y)+len(digits)-1
	let n = numeric_from_dense(x.sign*y.sign, productWeight, x.dscale+y.dscale, digits)
	return FromStr(NumericOid, format_numeric(n))
}

// NumericDiv divides a numeric Datum using PostgreSQL's select_div_scale result scale.
fn NumericDiv(a Datum, b Datum) !Datum {
	let x = try parse_numeric_value(NumericText(a))
	let y = try parse_numeric_value(NumericText(b))
	if y.sign == 0 && y.special == 0 { fail ErrorFault(NewError("22012", "division by zero")) }
	if x.special != 0 || y.special != 0 { return FromStr(NumericOid, numeric_special_div(x, y)) }
	let rscale = select_div_scale(x, y)
	let value = try numeric_div_at(x, y, rscale)
	return FromStr(NumericOid, format_numeric(value))
}

// numeric_div_at divides x by y, rounding to rscale decimal places.
fn numeric_div_at(x Numeric, y Numeric, rscale i64) !Numeric {
	if x.sign == 0 { return try parse_numeric_value(zero_with_scale(rscale)) }
	let numerator = reverse_i64(x.digits)
	let denominator = reverse_i64(y.digits)
	let xlow = numeric_low_exp(x)
	let ylow = numeric_low_exp(y)
	let commonLow = min(xlow, ylow)
	let n = big_append_zero_groups(numerator, xlow-commonLow)
	let d = big_append_zero_groups(denominator, ylow-commonLow)
	let (wholeQ, rem) = big_divmod(n, d)
	mut q = reverse_i64(wholeQ)
	mut remainder = rem
	// One guard decimal digit beyond rscale, rounded to four-digit groups.
	let fracGroupCount = (rscale+1+3)/4
	mut fracGroups = []i64{}
	for i in 0..fracGroupCount {
		remainder = big_mul_base_add(remainder, 0)
		let (digit, rest) = big_div_digit(remainder, d)
		fracGroups = append(fracGroups, digit)
		remainder = rest
		_ = i
	}
	if len(q) == 0 { q = []i64{0} }
	mut digits = []i64{}
	digits = append(digits, q...)
	digits = append(digits, fracGroups...)
	let weight = len(q)-1
	let raw = numeric_from_dense(x.sign*y.sign, weight, fracGroupCount*4, digits)
	return numeric_round_value(raw, rscale)
}

// select_div_scale mirrors PostgreSQL's division result-scale rule (numeric.c).
fn select_div_scale(a Numeric, b Numeric) i64 {
	let (weight1, firstdigit1) = numeric_first_digit(a)
	let (weight2, firstdigit2) = numeric_first_digit(b)
	mut qweight = weight1-weight2
	if firstdigit1 <= firstdigit2 { qweight -= 1 }
	mut rscale = minNumericSigDigits-qweight*numericDecDigits
	rscale = max(rscale, a.dscale)
	rscale = max(rscale, b.dscale)
	rscale = max(rscale, 0)
	rscale = min(rscale, maxNumericDisplayScale)
	return rscale
}

fn numeric_first_digit(n Numeric) (i64, i64) {
	for i in 0..len(n.digits) {
		if n.digits[i] != 0 { return n.weight-i, n.digits[i] }
	}
	return 0, 0
}

// NumericMod returns the PostgreSQL numeric remainder of a and b.
fn NumericMod(a Datum, b Datum) !Datum {
	let quotient = try NumericDiv(a, b)
	let whole = NumericTrunc(quotient, 0)
	let product = try NumericMul(whole, b)
	return try NumericSub(a, product)
}

// NumericNeg returns the additive inverse of a numeric Datum.
fn NumericNeg(a Datum) !Datum {
	let n = try parse_numeric_value(NumericText(a))
	return FromStr(NumericOid, format_numeric(numeric_neg_value(n)))
}

// NumericAbs returns the absolute value of a numeric Datum.
fn NumericAbs(a Datum) !Datum {
	let n = try parse_numeric_value(NumericText(a))
	mut copy = n
	if copy.sign < 0 { copy.sign = 1 }
	if copy.special < 0 { copy.special = 1 }
	return FromStr(NumericOid, format_numeric(copy))
}

// NumericRound rounds at scale decimal places, ties away from zero.
fn NumericRound(a Datum, scale i64) !Datum {
	let n = try parse_numeric_value(NumericText(a))
	return FromStr(NumericOid, format_numeric(numeric_round_value(n, scale)))
}

// NumericTrunc truncates at scale decimal places toward zero.
fn NumericTrunc(a Datum, scale i64) Datum {
	let n = parse_numeric_value(NumericText(a)) catch _ { return a }
	return FromStr(NumericOid, format_numeric(numeric_trunc_value(n, scale)))
}

// NumericFloor returns the greatest integer not greater than a.
fn NumericFloor(a Datum) Datum { return NumericRoundDirected(a, 0, -1) }

// NumericCeil returns the least integer not less than a.
fn NumericCeil(a Datum) Datum { return NumericRoundDirected(a, 0, 1) }

// NumericSign returns -1, 0 or 1 as a numeric Datum.
fn NumericSign(a Datum) Datum {
	let n = parse_numeric_value(NumericText(a)) catch _ { return FromStr(NumericOid, "0") }
	if n.special == 2 { return FromStr(NumericOid, "NaN") }
	if n.special != 0 {
		if n.special < 0 { return FromStr(NumericOid, "-1") }
		return FromStr(NumericOid, "1")
	}
	if n.sign < 0 { return FromStr(NumericOid, "-1") }
	if n.sign > 0 { return FromStr(NumericOid, "1") }
	return FromStr(NumericOid, "0")
}

// NumericPow raises a numeric value to a numeric exponent.
fn NumericPow(a Datum, b Datum) !Datum {
	let base = try parse_numeric_value(NumericText(a))
	let exp = try parse_numeric_value(NumericText(b))
	let value = try numeric_pow_value(base, exp)
	return FromStr(NumericOid, format_numeric(value))
}

// NumericSqrt returns the square root of a numeric value.
fn NumericSqrt(a Datum) !Datum {
	let x = try parse_numeric_value(NumericText(a))
	if x.special == 2 { return FromStr(NumericOid, "NaN") }
	if x.special == 1 { return FromStr(NumericOid, "Infinity") }
	if x.special == -1 { fail ErrorFault(NewError("2201F", "cannot take square root of a negative number")) }
	let value = try numeric_sqrt_value(x, numeric_sqrt_scale(x))
	return FromStr(NumericOid, format_numeric(value))
}

// NumericExp returns e raised to a numeric value.
fn NumericExp(a Datum) !Datum {
	let x = try parse_numeric_value(NumericText(a))
	if x.special == 2 { return FromStr(NumericOid, "NaN") }
	if x.special == 1 { return FromStr(NumericOid, "Infinity") }
	if x.special == -1 { return FromStr(NumericOid, "0.0000000000000000") }
	let value = try numeric_exp_value(x, numeric_exp_scale(x))
	return FromStr(NumericOid, format_numeric(value))
}

// NumericLn returns the natural logarithm of a numeric value.
fn NumericLn(a Datum) !Datum {
	let x = try parse_numeric_value(NumericText(a))
	if x.special == 2 { return FromStr(NumericOid, "NaN") }
	if x.special == 1 { return FromStr(NumericOid, "Infinity") }
	if x.special == -1 { fail ErrorFault(NewError("2201E", "cannot take logarithm of a negative number")) }
	if x.sign == 0 { fail ErrorFault(NewError("2201E", "cannot take logarithm of zero")) }
	if x.sign < 0 { fail ErrorFault(NewError("2201E", "cannot take logarithm of a negative number")) }
	let value = try numeric_ln_value(x, numeric_ln_scale(x))
	return FromStr(NumericOid, format_numeric(value))
}

// The nv_* helpers compute with Numeric values at an explicit working scale.
fn nv_parse(s str) Numeric { return parse_numeric_value(s) catch _ { return Numeric{sign: 0, weight: 0, dscale: 0, digits: []i64{}, special: 0} } }
fn nv_from_int(v i64) Numeric { return nv_parse(mint.Itoa(v)) }
fn nv_neg(a Numeric) Numeric { return numeric_neg_value(a) }
fn nv_cmp(a Numeric, b Numeric) i64 { return CompareNumeric(FromStr(NumericOid, format_numeric(a)), FromStr(NumericOid, format_numeric(b))) }

fn nv_add(a Numeric, b Numeric, rscale i64) Numeric {
	let sum = NumericAdd(FromStr(NumericOid, format_numeric(a)), FromStr(NumericOid, format_numeric(b))) catch _ { return a }
	let v = parse_numeric_value(sum.s) catch _ { return a }
	return numeric_round_value(v, rscale)
}

fn nv_sub(a Numeric, b Numeric, rscale i64) Numeric {
	let diff = NumericSub(FromStr(NumericOid, format_numeric(a)), FromStr(NumericOid, format_numeric(b))) catch _ { return a }
	let v = parse_numeric_value(diff.s) catch _ { return a }
	return numeric_round_value(v, rscale)
}

fn nv_mul(a Numeric, b Numeric, rscale i64) Numeric {
	let product = NumericMul(FromStr(NumericOid, format_numeric(a)), FromStr(NumericOid, format_numeric(b))) catch _ { return a }
	let v = parse_numeric_value(product.s) catch _ { return a }
	return numeric_round_value(v, rscale)
}

fn nv_div(a Numeric, b Numeric, rscale i64) !Numeric { return try numeric_div_at(a, b, rscale) }
fn nv_div_int(a Numeric, d i64, rscale i64) !Numeric { return try numeric_div_at(a, nv_from_int(d), rscale) }

fn numeric_sqrt_scale(a Numeric) i64 {
	let sweight = a.weight*numericDecDigits/2+1
	mut rscale = minNumericSigDigits-sweight
	rscale = max(rscale, a.dscale)
	rscale = max(rscale, 0)
	rscale = min(rscale, maxNumericDisplayScale)
	return rscale
}

fn numeric_exp_scale(a Numeric) i64 {
	let val = float_of_numeric(a)*0.434294481903252
	mut rscale = minNumericSigDigits-i64(val)
	rscale = max(rscale, a.dscale)
	rscale = max(rscale, 0)
	rscale = min(rscale, maxNumericDisplayScale)
	return rscale
}

fn numeric_ln_scale(a Numeric) i64 {
	let dweight = estimate_ln_dweight(a)
	mut rscale = minNumericSigDigits-dweight
	rscale = max(rscale, a.dscale)
	rscale = max(rscale, 0)
	rscale = min(rscale, maxNumericDisplayScale)
	return rscale
}

fn float_of_numeric(a Numeric) f64 {
	return mint.ParseFloat(format_numeric(a)) catch _ { return 0.0 }
}

fn estimate_ln_dweight(a Numeric) i64 {
	if a.sign != 1 { return 0 }
	let nine = nv_parse("0.9")
	let eleven = nv_parse("1.1")
	if nv_cmp(a, nine) >= 0 && nv_cmp(a, eleven) <= 0 {
		let x = nv_sub(a, nv_parse("1"), 30)
		if len(x.digits) > 0 {
			return x.weight*numericDecDigits+i64(gauge.Log10(f64(x.digits[0])))
		}
		return 0
	}
	if len(a.digits) > 0 {
		mut digits = f64(a.digits[0])
		mut dweight = a.weight*numericDecDigits
		if len(a.digits) > 1 {
			digits = digits*10000.0+f64(a.digits[1])
			dweight -= numericDecDigits
		}
		let ln_var = gauge.Log(digits)+f64(dweight)*2.302585092994046
		return i64(gauge.Log10(gauge.Abs(ln_var)))
	}
	return 0
}

// numeric_sqrt_value computes sqrt(a) to rscale places with a Newton iteration
// on base-10000 digits.
fn numeric_sqrt_value(a Numeric, rscale i64) !Numeric {
	if a.sign == 0 { return nv_parse(zero_with_scale(rscale)) }
	let work = max(rscale+12, 20)
	mut guess = gauge.Sqrt(float_of_numeric(a))
	if guess != guess { guess = 1.0 }
	mut x = nv_parse(mint.FormatFloat(guess, 'f', work))
	if x.sign == 0 { x = nv_parse("1") }
	for i in 0..80 {
		let q = try numeric_div_at(a, x, work)
		let sumv = nv_add(x, q, work+4)
		let half = try numeric_div_at(sumv, nv_from_int(2), work)
		if nv_cmp(half, x) == 0 { break }
		x = half
		_ = i
	}
	return numeric_round_value(x, rscale)
}

// numeric_exp_value computes exp(a) to rscale places using argument reduction
// and the exp Taylor series, as PostgreSQL's exp_var does.
fn numeric_exp_value(a Numeric, rscale i64) !Numeric {
	if a.sign == 0 { return nv_parse("1"+dot_zeroes(rscale)) }
	let val = float_of_numeric(a)
	mut ndiv2 = i64(0)
	if gauge.Abs(val) > 0.01 {
		ndiv2 = 1
		mut v = val/2.0
		for gauge.Abs(v) > 0.01 {
			ndiv2 += 1
			v = v/2.0
		}
	}
	let work = rscale+12+ndiv2
	mut x = a
	if ndiv2 > 0 { x = try numeric_div_at(a, nv_from_int(i64(1) << ndiv2), work) }
	mut total = nv_add(nv_parse("1"), x, work)
	mut term = x
	mut i = i64(2)
	for i < 5000 {
		term = try numeric_div_at(nv_mul(term, x, work+4), nv_from_int(i), work)
		if term.sign == 0 { break }
		total = nv_add(total, term, work)
		i += 1
	}
	for k in 0..ndiv2 {
		total = nv_mul(total, total, work)
		_ = k
	}
	return numeric_round_value(total, rscale)
}

// numeric_ln_value computes ln(a) to rscale places using range reduction by
// repeated square roots and the atanh series, as PostgreSQL's ln_var does.
fn numeric_ln_value(a Numeric, rscale i64) !Numeric {
	mut x = a
	mut nsqrt = i64(0)
	let nine = nv_parse("0.9")
	let eleven = nv_parse("1.1")
	for nv_cmp(x, nine) <= 0 {
		x = try numeric_sqrt_value(x, rscale-x.weight*numericDecDigits/2+8)
		nsqrt += 1
	}
	for nv_cmp(x, eleven) >= 0 {
		x = try numeric_sqrt_value(x, rscale-x.weight*numericDecDigits/2+8)
		nsqrt += 1
	}
	let local = rscale+i64(f64(nsqrt+1)*0.301029995663981)+8
	let one = nv_parse("1")
	let numv = nv_sub(x, one, local)
	let denv = nv_add(x, one, local)
	let z = try numeric_div_at(numv, denv, local)
	let z2 = nv_mul(z, z, local)
	mut total = z
	mut power = z
	mut k = i64(3)
	for k < 100000 {
		power = nv_mul(power, z2, local)
		let term = try numeric_div_at(power, nv_from_int(k), local)
		if term.sign == 0 { break }
		total = nv_add(total, term, local)
		k += 2
	}
	let factor = nv_from_int(i64(1) << (nsqrt+1))
	return numeric_round_value(nv_mul(total, factor, local), rscale)
}

fn numeric_pow_value(base Numeric, exp Numeric) !Numeric {
	if base.special == 2 || exp.special == 2 { return nv_parse("NaN") }
	if exp.sign == 0 { return nv_parse("1"+dot_zeroes(numeric_pow_int_scale(base, exp, 0))) }
	if base.sign == 0 {
		if exp.sign < 0 { fail ErrorFault(NewError("2201F", "zero raised to a negative power is undefined")) }
		return nv_parse(zero_with_scale(numeric_pow_general_scale(base, exp)))
	}
	if let n = numeric_integer_exponent(exp) {
		return try numeric_pow_int(base, n, exp.dscale)
	}
	if base.sign < 0 { fail ErrorFault(NewError("2201F", "a negative number raised to a non-integer power yields a complex result")) }
	let ln_dweight = estimate_ln_dweight(base)
	let low = max(8-ln_dweight, 0)
	let ln_base_low = try numeric_ln_value(base, low)
	let ln_num_low = nv_mul(ln_base_low, exp, low)
	let val = float_of_numeric(ln_num_low)*0.434294481903252
	mut rscale = minNumericSigDigits-i64(val)
	rscale = max(rscale, base.dscale)
	rscale = max(rscale, exp.dscale)
	rscale = max(rscale, 0)
	rscale = min(rscale, maxNumericDisplayScale)
	let sig_digits = max(rscale+i64(val), 0)
	let local_rscale = max(sig_digits-ln_dweight+8, 0)
	let ln_base = try numeric_ln_value(base, local_rscale)
	let ln_num = nv_mul(ln_base, exp, local_rscale)
	return try numeric_exp_value(ln_num, rscale)
}

fn numeric_pow_general_scale(base Numeric, exp Numeric) i64 {
	let ln_dweight = estimate_ln_dweight(base)
	let local = max(8-ln_dweight, 0)
	let ln_base = numeric_ln_value(base, local) catch _ { return minNumericSigDigits }
	let ln_num = nv_mul(ln_base, exp, local)
	let val = float_of_numeric(ln_num)*0.434294481903252
	mut rscale = minNumericSigDigits-i64(val)
	rscale = max(rscale, base.dscale)
	rscale = max(rscale, exp.dscale)
	rscale = max(rscale, 0)
	rscale = min(rscale, maxNumericDisplayScale)
	return rscale
}

fn numeric_pow_int_scale(base Numeric, exp Numeric, ignored i64) i64 {
	_ = ignored
	return numeric_pow_general_scale(base, exp)
}

// numeric_integer_exponent returns the exponent as an i64 when it is an exact
// integer that fits, otherwise nil.
fn numeric_integer_exponent(exp Numeric) ?i64 {
	if exp.special != 0 { return nil }
	if len(exp.digits) == 0 { return 0 }
	if len(exp.digits) > exp.weight+1 { return nil }
	let text = format_numeric(exp)
	let value = mint.Atoi(text) catch _ { return nil }
	return value
}

// numeric_pow_int raises base to an integer exponent, rounding to the scale
// PostgreSQL's power_var_int chooses.
fn numeric_pow_int(base Numeric, exp i64, exp_dscale i64) !Numeric {
	let rscale = numeric_pow_int_result_scale(base, exp, exp_dscale)
	if exp == 0 { return nv_parse("1"+dot_zeroes(rscale)) }
	if base.sign == 0 {
		if exp < 0 { fail ErrorFault(NewError("22012", "division by zero")) }
		return nv_parse(zero_with_scale(rscale))
	}
	let magnitude = iabs(exp)
	let work = rscale+30
	mut result = nv_parse("1")
	mut factor = base
	mut mask = magnitude
	for mask > 0 {
		if mask%2 == 1 { result = nv_mul(result, factor, work) }
		mask = mask/2
		if mask > 0 { factor = nv_mul(factor, factor, work) }
	}
	if exp < 0 { return try numeric_div_at(nv_parse("1"), result, rscale) }
	return numeric_round_value(result, rscale)
}

fn numeric_pow_int_result_scale(base Numeric, exp i64, exp_dscale i64) i64 {
	mut f = 0.0
	if len(base.digits) != 0 {
		f = f64(base.digits[0])
		mut p = base.weight*numericDecDigits
		mut i = i64(1)
		for i < len(base.digits) && i*numericDecDigits < 16 {
			f = f*10000.0+f64(base.digits[i])
			p -= numericDecDigits
			i += 1
		}
		f = f64(exp)*(gauge.Log10(f)+f64(p))
	}
	mut rscale = minNumericSigDigits-i64(f)
	rscale = max(rscale, base.dscale)
	rscale = max(rscale, exp_dscale)
	rscale = max(rscale, 0)
	rscale = min(rscale, maxNumericDisplayScale)
	return rscale
}

fn dot_zeroes(n i64) str {
	if n <= 0 { return "" }
	return "."+zeroes(n)
}

// NumericLog10 returns the base-10 logarithm of a numeric value.
fn NumericLog10(a Datum) !Datum {
	let ten = FromStr(NumericOid, "10")
	let numerator = try NumericLn(a)
	let denominator = try NumericLn(ten)
	return try NumericDiv(numerator, denominator)
}

// NumericDivInt returns the integer part of the quotient, truncated toward zero.
fn NumericDivInt(a Datum, b Datum) !Datum {
	let quotient = try NumericDiv(a, b)
	return NumericTrunc(quotient, 0)
}

// CompareNumeric compares numeric values exactly, including PostgreSQL NaN ordering.
fn CompareNumeric(a Datum, b Datum) i64 {
	let x = parse_numeric_value(NumericText(a)) catch _ { return 0 }
	let y = parse_numeric_value(NumericText(b)) catch _ { return 0 }
	if x.special == 2 {
		if y.special == 2 { return 0 }
		return 1
	}
	if y.special == 2 { return -1 }
	if x.special != 0 || y.special != 0 {
		if x.special < y.special { return -1 }
		if x.special > y.special { return 1 }
		return 0
	}
	if x.sign < y.sign { return -1 }
	if x.sign > y.sign { return 1 }
	if x.sign == 0 { return 0 }
	return numeric_abs_compare(x, y)*x.sign
}

fn NumericIndexKey(d Datum) []u8 {
	let n = parse_numeric_value(NumericText(d)) catch _ { return []u8{} }
	mut out = []u8{}
	if n.special == 2 { return []u8{0x81} }
	if n.special == 1 { return []u8{0x80} }
	if n.special == -1 { return []u8{0x00} }
	if n.sign == 0 { return []u8{0x40} }
	if n.sign > 0 { out = append(out, 0x60) } else { out = append(out, 0x20) }
	let biased = u32(n.weight+2147483648)
	mut mag = []u8{}
	put_u32(mut mag, biased)
	let valueDigits = canonical_numeric_digits(n)
	for i in 0..len(valueDigits) {
		let d0 = valueDigits[i]
		mag = append(mag, u8(d0 >> 8), u8(d0))
	}
	mag = append(mag, 0, 0)
	if n.sign < 0 { for i in 0..len(mag) { out = append(out, ~mag[i]) } } else { out = append(out, mag...) }
	return out
}

fn canonical_numeric_digits(n Numeric) []i64 {
	mut digits = n.digits
	for len(digits) > 0 && digits[len(digits)-1] == 0 { digits = digits[:len(digits)-1] }
	return digits
}

fn numeric_neg_value(n Numeric) Numeric {
	mut out = n
	if out.special == 1 {
		out.special = -1
		return out
	}
	if out.special == -1 {
		out.special = 1
		return out
	}
	out.sign = 0-out.sign
	return out
}

fn numeric_low_exp(n Numeric) i64 { return n.weight-len(n.digits)+1 }

fn numeric_digit_at(n Numeric, exp i64) i64 {
	let idx = n.weight-exp
	if idx < 0 || idx >= len(n.digits) { return 0 }
	return n.digits[idx]
}

fn numeric_abs_compare(a Numeric, b Numeric) i64 {
	if a.sign == 0 {
		if b.sign == 0 { return 0 }
		return -1
	}
	if b.sign == 0 { return 1 }
	if a.weight < b.weight { return -1 }
	if a.weight > b.weight { return 1 }
	let low = min(numeric_low_exp(a), numeric_low_exp(b))
	for i in 0..a.weight-low+1 {
		let exp = a.weight-i
		let x = numeric_digit_at(a, exp)
		let y = numeric_digit_at(b, exp)
		if x < y { return -1 }
		if x > y { return 1 }
	}
	return 0
}

fn numeric_from_dense(sign i64, weight i64, scale i64, input []i64) Numeric {
	mut digits = input
	mut w = weight
	for len(digits) > 0 && digits[0] == 0 {
		digits = digits[1:]
		w -= 1
	}
	for len(digits) > 0 && digits[len(digits)-1] == 0 { digits = digits[:len(digits)-1] }
	mut s = sign
	if len(digits) == 0 {
		s = 0
		w = 0
	}
	return Numeric{sign: s, weight: w, dscale: max(0, scale), digits: digits, special: 0}
}

fn numeric_round_value(n Numeric, scale i64) Numeric {
	if n.special != 0 { return n }
	return numeric_decimal_rescale(n, scale, true)
}

fn numeric_trunc_value(n Numeric, scale i64) Numeric {
	if n.special != 0 { return n }
	return numeric_decimal_rescale(n, scale, false)
}

fn numeric_decimal_rescale(n Numeric, scale i64, round bool) Numeric {
	let text = format_numeric(n)
	mut magnitude = text
	if n.sign < 0 { magnitude = text[1:] }
	let dot = find_dot(magnitude)
	mut integer = magnitude
	mut fraction = ""
	if dot >= 0 {
		integer = magnitude[:dot]
		fraction = magnitude[dot+1:]
	}
	if scale < 0 {
		let keepCount = max(0, len(integer)+scale)
		mut first = u8('0')
		if keepCount < len(integer) { first = integer[keepCount] }
		mut prefix = integer[:keepCount]
		if round && first >= u8('5') { prefix = increment_decimal_digits(prefix) }
		let out = prefix+zeroes(-scale)
		return parse_numeric_value(signed_numeric_text(n.sign, out, 0)) catch _ { n }
	}
	let missing = max(0, scale+1-len(fraction))
	let padded = fraction+zeroes(missing)
	let first = padded[scale]
	let kept = padded[:scale]
	mut out = integer
	if scale > 0 { out += "."+kept }
	if round && first >= u8('5') { out = increment_decimal_point(out) }
	return parse_numeric_value(signed_numeric_text(n.sign, out, scale)) catch _ { n }
}

fn find_dot(s str) i64 {
	for i in 0..len(s) { if s[i] == '.' { return i } }
	return -1
}

fn signed_numeric_text(sign i64, magnitude str, scale i64) str {
	if all_numeric_zero(magnitude) { return zero_with_scale(scale) }
	if sign < 0 { return "-"+magnitude }
	return magnitude
}

fn all_numeric_zero(s str) bool {
	for c in s { if c >= '1' && c <= '9' { return false } }
	return true
}

fn increment_decimal_digits(s str) str {
	mut digits = []u8{}
	for i in 0..len(s) { digits = append(digits, s[i]) }
	if len(digits) == 0 { return "1" }
	mut at = len(digits)-1
	for at >= 0 {
		if digits[at] < u8('9') {
			digits[at] += 1
			return str(digits)
		}
		digits[at] = u8('0')
		at -= 1
	}
	mut out = []u8{'1'}
	out = append(out, digits...)
	return str(out)
}

fn increment_decimal_point(s str) str {
	mut digits = []u8{}
	for i in 0..len(s) { digits = append(digits, s[i]) }
	mut at = len(digits)-1
	for at >= 0 {
		if digits[at] == u8('.') { at -= 1 } else if digits[at] < u8('9') {
			digits[at] += 1
			return str(digits)
		} else {
			digits[at] = u8('0')
			at -= 1
		}
	}
	mut out = []u8{'1'}
	out = append(out, digits...)
	return str(out)
}

fn NumericRoundDirected(a Datum, scale i64, direction i64) Datum {
	let n = parse_numeric_value(NumericText(a)) catch _ { return a }
	let t = numeric_trunc_value(n, scale)
	if CompareNumeric(a, FromStr(NumericOid, format_numeric(t))) == 0 { return FromStr(NumericOid, format_numeric(t)) }
	if direction < 0 && n.sign < 0 { return FromStr(NumericOid, format_numeric(numeric_add_one(t, -1, scale))) }
	if direction > 0 && n.sign > 0 { return FromStr(NumericOid, format_numeric(numeric_add_one(t, 1, scale))) }
	return FromStr(NumericOid, format_numeric(t))
}

fn numeric_add_one(n Numeric, sign i64, scale i64) Numeric {
	mut unitText = "1"+zeroes(-scale)
	if scale > 0 { unitText = "0."+zeroes(scale-1)+"1" }
	let unit = ParseNumeric(unitText) catch _ { return n }
	mut step = unit
	if sign < 0 { step = NumericNeg(unit) catch _ { unit } }
	let current = FromStr(NumericOid, format_numeric(n))
	let sum = NumericAdd(current, step) catch _ { return n }
	return parse_numeric_value(sum.s) catch _ { n }
}

fn zero_with_scale(scale i64) str {
	if scale <= 0 { return "0" }
	return "0."+zeroes(scale)
}

// with_scale returns n with its display scale forced to scale.
fn with_scale(n Numeric, scale i64) Numeric {
	mut out = n
	out.dscale = scale
	return out
}

fn reverse_i64(values []i64) []i64 {
	mut out = []i64{}
	for i in 0..len(values) { out = append(out, values[len(values)-1-i]) }
	return out
}

fn numeric_special_binary(a Numeric, b Numeric, op i64) !Datum {
	_ = op
	if a.special == 2 || b.special == 2 { return FromStr(NumericOid, "NaN") }
	if a.special != 0 {
		if a.special < 0 { return FromStr(NumericOid, "-Infinity") }
		return FromStr(NumericOid, "Infinity")
	}
	if b.special < 0 { return FromStr(NumericOid, "-Infinity") }
	return FromStr(NumericOid, "Infinity")
}

fn numeric_special_mul(a Numeric, b Numeric) str {
	if a.special == 2 || b.special == 2 { return "NaN" }
	mut sign = ""
	if a.sign*b.sign < 0 { sign = "-" }
	if a.special != 0 || b.special != 0 {
		if a.sign == 0 || b.sign == 0 { return "NaN" }
		return sign+"Infinity"
	}
	return "0"
}

fn numeric_special_div(a Numeric, b Numeric) str {
	if a.special == 2 || b.special == 2 { return "NaN" }
	if a.special != 0 && b.special != 0 { return "NaN" }
	if a.special != 0 {
		if a.special*b.sign < 0 { return "-Infinity" }
		return "Infinity"
	}
	if b.special != 0 { return "0" }
	return "0"
}

// big_append_zero_groups multiplies the little-endian integer a by NBASE^n.
fn big_append_zero_groups(a []i64, n i64) []i64 {
	mut out = []i64{}
	for i in 0..n {
		out = append(out, 0)
		_ = i
	}
	out = append(out, a...)
	return out
}

fn big_trim(a []i64) []i64 {
	mut out = a
	for len(out) > 0 && out[len(out)-1] == 0 { out = out[:len(out)-1] }
	return out
}

fn big_compare(a []i64, b []i64) i64 {
	let x = big_trim(a)
	let y = big_trim(b)
	if len(x) < len(y) { return -1 }
	if len(x) > len(y) { return 1 }
	for k in 0..len(x) {
		let i = len(x)-1-k
		if x[i] < y[i] { return -1 }
		if x[i] > y[i] { return 1 }
	}
	return 0
}

fn big_sub(a []i64, b []i64) []i64 {
	mut out = []i64{}
	out = append(out, a...)
	mut borrow = i64(0)
	for i in 0..len(out) {
		mut bv = i64(0)
		if i < len(b) { bv = b[i] }
		mut v = out[i]-bv-borrow
		borrow = 0
		if v < 0 {
			v += NumericBase
			borrow = 1
		}
		out[i] = v
	}
	return big_trim(out)
}

fn big_mul_base_add(a []i64, digit i64) []i64 {
	mut out = []i64{digit}
	out = append(out, a...)
	return big_trim(out)
}

fn big_divmod(a []i64, b []i64) ([]i64, []i64) {
	mut q = []i64{}
	mut rem = []i64{}
	for i in 0..len(a) {
		q = append(q, 0)
		_ = i
	}
	for k in 0..len(a) {
		let i = len(a)-1-k
		rem = big_mul_base_add(rem, a[i])
		let (digit, next) = big_div_digit(rem, b)
		q[i] = digit
		rem = next
	}
	return big_trim(q), rem
}

fn big_div_digit(a []i64, b []i64) (i64, []i64) {
	mut q = i64(0)
	mut rem = a
	for big_compare(rem, b) >= 0 {
		rem = big_sub(rem, b)
		q += 1
	}
	return q, rem
}
