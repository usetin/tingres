package types

import "glyph"
import "twine"

// LikeMatcher owns a LIKE pattern compiled once for a planned expression.
type LikeMatcher value struct {
	Tokens []LikeToken
	Insensitive bool
	Negated bool
	FastKind u8
	Needle str
}

type LikeToken value struct {
	Kind u8
	Rune i32
}

fn registerLikeFuncs(funcs mut []Func) {
	for _, oid in []Oid{TextOid, VarcharOid, BpcharOid, NameOid} {
		for _, name in []str{"LIKE", "ILIKE", "NOT LIKE", "NOT ILIKE", "~~", "~~*", "!~~", "!~~*"} {
			registerFunc(mut funcs, function2(name, []Oid{oid, oid}, BoolOid, true, false, fn(p1 Datum, p2 Datum) !Datum { return try likeOperator(name, p1.Text(), p2.Text(), "\\") }))
			registerFunc(mut funcs, function3(name, []Oid{oid, oid, oid}, BoolOid, true, false, fn(p1 Datum, p2 Datum, p3 Datum) !Datum { return try likeOperator(name, p1.Text(), p2.Text(), p3.Text()) }))
		}
		registerFunc(mut funcs, function2("SIMILAR TO", []Oid{oid, oid}, BoolOid, true, false, fn(p1 Datum, p2 Datum) !Datum { return try similarTo(p1.Text(), p2.Text(), "\\") }))
		registerFunc(mut funcs, function3("SIMILAR TO", []Oid{oid, oid, oid}, BoolOid, true, false, fn(p1 Datum, p2 Datum, p3 Datum) !Datum { return try similarTo(p1.Text(), p2.Text(), p3.Text()) }))
	}
	for _, name in []str{"~", "~*", "!~", "!~*"} {
		for _, oid in []Oid{TextOid, VarcharOid, BpcharOid, NameOid} {
			registerFunc(mut funcs, function2(name, []Oid{oid, oid}, BoolOid, true, false, fn(a Datum, b Datum) !Datum { return try regexOperator(name, a.Text(), b.Text()) }))
		}
	}
}

fn likeOperator(name str, text str, pattern str, escape str) !Datum {
	let insensitive = name == "ILIKE" || name == "NOT ILIKE" || name == "~~*" || name == "!~~*"
	let negated = name == "NOT LIKE" || name == "NOT ILIKE" || name == "!~~" || name == "!~~*"
	let matcher = try CompileLike(pattern, escape, insensitive, negated)
	let matches = matcher.Matches(text)
	return FromBool(matches)
}

// CompileLike prepares a pattern for repeated matching in the executor.
fn CompileLike(pattern str, escape str, insensitive bool, negated bool) !LikeMatcher {
	mut sourcePattern = pattern
	mut sourceEscape = escape
	if insensitive {
		sourcePattern = twine.ToLower(pattern)
		sourceEscape = twine.ToLower(escape)
	}
	let tokens = try parseLike(sourcePattern, sourceEscape)
	mut matcher = LikeMatcher{Tokens: tokens, Insensitive: insensitive, Negated: negated, FastKind: 0, Needle: ""}
	let n = len(tokens)
	mut literal = ""
	mut allLiteral = true
	for token in tokens {
		if token.Kind != 0 { allLiteral = false } else { literal += glyph.RuneStr(token.Rune) }
	}
	if allLiteral {
		matcher.FastKind = 1
		matcher.Needle = literal
		return matcher
	}
	if n >= 1 && tokens[n-1].Kind == 2 {
		mut prefix = ""
		mut plain = true
		for i in 0..n-1 {
			if tokens[i].Kind != 0 { plain = false } else { prefix += glyph.RuneStr(tokens[i].Rune) }
		}
		if plain {
			matcher.FastKind = 2
			matcher.Needle = prefix
			return matcher
		}
	}
	if n >= 1 && tokens[0].Kind == 2 {
		mut suffix = ""
		mut plain = true
		for i in 1..n {
			if tokens[i].Kind != 0 { plain = false } else { suffix += glyph.RuneStr(tokens[i].Rune) }
		}
		if plain {
			matcher.FastKind = 3
			matcher.Needle = suffix
			return matcher
		}
	}
	if n >= 2 && tokens[0].Kind == 2 && tokens[n-1].Kind == 2 {
		mut contains = ""
		mut plain = true
		for i in 1..n-1 {
			if tokens[i].Kind != 0 { plain = false } else { contains += glyph.RuneStr(tokens[i].Rune) }
		}
		if plain {
			matcher.FastKind = 4
			matcher.Needle = contains
			return matcher
		}
	}
	return matcher
}

// Matches tests a string with the prepared LIKE pattern and its escape rules.
fn (matcher LikeMatcher) Matches(text str) bool {
	mut value = text
	mut needle = matcher.Needle
	if matcher.Insensitive {
		value = twine.ToLower(value)
		needle = twine.ToLower(needle)
	}
	mut matches = false
	if matcher.FastKind == 1 { matches = value == needle
	} else if matcher.FastKind == 2 { matches = twine.HasPrefix(value, needle)
	} else if matcher.FastKind == 3 { matches = twine.HasSuffix(value, needle)
	} else if matcher.FastKind == 4 { matches = twine.Contains(value, needle)
	} else { matches = likeMatchTokens(value, matcher.Tokens) }
	if matcher.Negated { matches = !matches }
	return matches
}

fn textRunes(s str) []i32 {
	mut out = make([]i32, 0, glyph.RuneCount(s))
	mut i = 0
	for i < len(s) {
		let (r, size) = glyph.DecodeRune(s, i)
		out = append(out, r)
		i += size
	}
	return out
}

fn parseLike(pattern str, escape str) ![]LikeToken {
	let esc = textRunes(escape)
	if len(esc) > 1 { try pgRaiseHint("22025", "invalid escape string", "Escape string must be empty or one character.") }
	let chars = textRunes(pattern)
	mut out = make([]LikeToken, 0, len(chars))
	mut i = i64(0)
	for i < len(chars) {
		let c = chars[i]
		if len(esc) == 1 && c == esc[0] {
			i += 1
			if i >= len(chars) { try pgRaise("22025", "LIKE pattern must not end with escape character") }
			out = append(out, LikeToken{Kind: 0, Rune: chars[i]})
		} else if c == '%' {
			if len(out) == 0 || out[len(out)-1].Kind != 2 { out = append(out, LikeToken{Kind: 2, Rune: 0}) }
		} else if c == '_' { out = append(out, LikeToken{Kind: 1, Rune: 0}) } else { out = append(out, LikeToken{Kind: 0, Rune: c}) }
		i += 1
	}
	return out
}

fn likeMatch(text str, pattern str, escape str, insensitive bool) !bool {
	mut sourcePattern = pattern
	mut sourceEscape = escape
	if insensitive {
		text = twine.ToLower(text)
		sourcePattern = twine.ToLower(pattern)
		sourceEscape = twine.ToLower(escape)
	}
	let tokens = try parseLike(sourcePattern, sourceEscape)
	return likeMatchTokens(text, tokens)
}

fn likeMatchTokens(text str, tokens []LikeToken) bool {
	let chars = textRunes(text)
	mut prev = make([]bool, len(chars)+1)
	prev[0] = true
	for token in tokens {
		mut next = make([]bool, len(chars)+1)
		if token.Kind == 2 {
			next[0] = prev[0]
			for j in 1..len(chars)+1 { next[j] = prev[j] || next[j-1] }
		} else {
			for j in 1..len(chars)+1 {
				if token.Kind == 1 || token.Rune == chars[j-1] { next[j] = prev[j-1] }
			}
		}
		prev = next
	}
	return prev[len(chars)]
}

fn similarTo(text str, pattern str, escape str) !Datum {
	return try similarRegexMatch(text, pattern, escape)
}
