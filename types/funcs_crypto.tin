package types

import "glyph"

fn reverseText(s str) str {
	let runes = textRunes(s)
	mut out = ""
	mut i = len(runes)-1
	for i >= 0 {
		out += glyph.RuneStr(runes[i])
		i -= 1
	}
	return out
}

@wrap fn md5Block(state mut []u32, block []u8) {
	let shifts = []u32{7, 12, 17, 22, 5, 9, 14, 20, 4, 11, 16, 23, 6, 10, 15, 21}
	let table = []u32{
		0xd76aa478, 0xe8c7b756, 0x242070db, 0xc1bdceee, 0xf57c0faf, 0x4787c62a, 0xa8304613, 0xfd469501,
		0x698098d8, 0x8b44f7af, 0xffff5bb1, 0x895cd7be, 0x6b901122, 0xfd987193, 0xa679438e, 0x49b40821,
		0xf61e2562, 0xc040b340, 0x265e5a51, 0xe9b6c7aa, 0xd62f105d, 0x02441453, 0xd8a1e681, 0xe7d3fbc8,
		0x21e1cde6, 0xc33707d6, 0xf4d50d87, 0x455a14ed, 0xa9e3e905, 0xfcefa3f8, 0x676f02d9, 0x8d2a4c8a,
		0xfffa3942, 0x8771f681, 0x6d9d6122, 0xfde5380c, 0xa4beea44, 0x4bdecfa9, 0xf6bb4b60, 0xbebfbc70,
		0x289b7ec6, 0xeaa127fa, 0xd4ef3085, 0x04881d05, 0xd9d4d039, 0xe6db99e5, 0x1fa27cf8, 0xc4ac5665,
		0xf4292244, 0x432aff97, 0xab9423a7, 0xfc93a039, 0x655b59c3, 0x8f0ccc92, 0xffeff47d, 0x85845dd1,
		0x6fa87e4f, 0xfe2ce6e0, 0xa3014314, 0x4e0811a1, 0xf7537e82, 0xbd3af235, 0x2ad7d2bb, 0xeb86d391,
	}
	mut words = make([]u32, 16)
	for i in 0..16 {
		let j = i*4
		words[i] = u32(block[j]) | u32(block[j+1])<<8 | u32(block[j+2])<<16 | u32(block[j+3])<<24
	}
	mut a = state[0]
	mut b = state[1]
	mut c = state[2]
	mut d = state[3]
	for i in 0..64 {
		mut f = u32(0)
		mut g = i64(0)
		let round = i/16
		if round == 0 {
			f = (b & c) | (^b & d)
			g = i
		} else if round == 1 {
			f = (d & b) | (^d & c)
			g = (5*i+1)%16
		} else if round == 2 {
			f = b ^ c ^ d
			g = (3*i+5)%16
		} else {
			f = c ^ (b | ^d)
			g = (7*i)%16
		}
		let shift = shifts[round*4+i%4]
		let sum = a+f+table[i]+words[g]
		let rotated = (sum<<shift) | (sum>>(32-shift))
		let next = b+rotated
		a = d
		d = c
		c = b
		b = next
	}
	state[0] += a
	state[1] += b
	state[2] += c
	state[3] += d
}

fn md5Text(s str) str {
	mut data = make([]u8, 0, len(s)+72)
	for i in 0..len(s) { data = append(data, s[i]) }
	let bitLength = u64(len(s))*8
	data = append(data, 0x80)
	for len(data)%64 != 56 { data = append(data, 0) }
	for i in 0..8 { data = append(data, u8(bitLength >> u64(i*8))) }
	mut state = []u32{0x67452301, 0xefcdab89, 0x98badcfe, 0x10325476}
	for offset in (0..len(data)).step(64) { md5Block(mut state, data[offset:offset+64]) }
	let digits = "0123456789abcdef"
	mut out = ""
	for word in state {
		for i in 0..4 {
			let b = u8(word >> u32(i*8))
			out += str(digits[i64(b>>4)])+str(digits[i64(b&15)])
		}
	}
	return out
}
