package types

import "gauge"
import "say"

const UnknownLiteralOid Oid = 705

// Func is one resolved scalar function or operator.
type Func value struct {
	Name str
	Args []u32
	Ret u32
	Strict bool
	Volatile bool
	Call fn([]Datum) !Datum
	Call1 fn(Datum) !Datum
	Call2 fn(Datum, Datum) !Datum
	Call3 fn(Datum, Datum, Datum) !Datum
	Int4Binary fn(i32, i32) !i32
	Int8Binary fn(i64, i64) !i64
	Float8Binary fn(f64, f64) !f64
	Int4Compare fn(i32, i32) !bool
	Int8Compare fn(i64, i64) !bool
	Float8Compare fn(f64, f64) !bool
	TextCompare fn(str, str) !bool
}

// pgFault is the PostgreSQL error payload constructor used by scalar functions.
fn pgFault(code str, message str) PgError {
	return NewError(code, message)
}

fn pgRaise(code str, message str) ! { try PgFault(code, message) }

// pgRaiseHint raises a PostgreSQL error with a hint. It builds the fault payload
// itself and passes it as a say.Fault argument so a percent sign in the message
// or hint is not read as a format verb.
fn pgRaiseHint(code str, message str, hint str) ! {
	let payload = "@PGERR1@"+pg_field(code)+pg_field("ERROR")+pg_field(message)+pg_field("")+pg_field(hint)+pg_field("0")
	fail say.Fault("%s", payload)
}

fn function(name str, args []Oid, ret Oid, strict bool, volatile bool, call fn([]Datum) !Datum) Func {
	return Func{
		Name: name, Args: args, Ret: ret, Strict: strict, Volatile: volatile, Call: call,
		Call1: fn(a Datum) !Datum { return try call([]Datum{a}) },
		Call2: fn(a Datum, b Datum) !Datum { return try call([]Datum{a, b}) },
		Call3: fn(a Datum, b Datum, c Datum) !Datum { return try call([]Datum{a, b, c}) },
		Int4Binary: fn(a i32, b i32) !i32 { fail "function has no int4 fast path" },
		Int8Binary: fn(a i64, b i64) !i64 { fail "function has no int8 fast path" },
		Float8Binary: fn(a f64, b f64) !f64 { fail "function has no float8 fast path" },
		Int4Compare: fn(a i32, b i32) !bool { fail "function has no int4 compare fast path" },
		Int8Compare: fn(a i64, b i64) !bool { fail "function has no int8 compare fast path" },
		Float8Compare: fn(a f64, b f64) !bool { fail "function has no float8 compare fast path" },
		TextCompare: fn(a str, b str) !bool { fail "function has no text compare fast path" },
	}
}

fn function1(name str, args []Oid, ret Oid, strict bool, volatile bool, call1 fn(Datum) !Datum) Func {
	mut f = function(name, args, ret, strict, volatile, fn(values []Datum) !Datum {
		if len(values) != 1 { fail "wrong number of arguments to {name}" }
		return try call1(values[0])
	})
	f.Call1 = call1
	return f
}

fn function2(name str, args []Oid, ret Oid, strict bool, volatile bool, call2 fn(Datum, Datum) !Datum) Func {
	mut f = function(name, args, ret, strict, volatile, fn(values []Datum) !Datum {
		if len(values) != 2 { fail "wrong number of arguments to {name}" }
		return try call2(values[0], values[1])
	})
	f.Call2 = call2
	return f
}

fn function3(name str, args []Oid, ret Oid, strict bool, volatile bool, call3 fn(Datum, Datum, Datum) !Datum) Func {
	mut f = function(name, args, ret, strict, volatile, fn(values []Datum) !Datum {
		if len(values) != 3 { fail "wrong number of arguments to {name}" }
		return try call3(values[0], values[1], values[2])
	})
	f.Call3 = call3
	return f
}

fn registerFunc(funcs mut []Func, f Func) {
	funcs = append(funcs, f)
}

fn bindFunc(f Func) Func {
	return Func{
		Name: f.Name, Args: f.Args, Ret: f.Ret, Strict: f.Strict, Volatile: f.Volatile,
		Call: fn(args []Datum) !Datum {
			if f.Strict {
				for _, arg in args {
					if IsNull(arg) { return Null() }
				}
			}
			if len(args) != len(f.Args) { fail "wrong number of arguments to {f.Name}" }
			mut converted = make([]Datum, 0, len(args))
			for i, arg in args {
				let value = try bindArgument(arg, Oid(f.Args[i]))
				converted = append(converted, value)
			}
			return try f.Call(converted)
		},
		Call1: fn(a Datum) !Datum {
			if len(f.Args) != 1 { fail "wrong number of arguments to {f.Name}" }
			if f.Strict && IsNull(a) { return Null() }
			let aa = try bindArgument(a, Oid(f.Args[0]))
			return try f.Call1(aa)
		},
		Call2: fn(a Datum, b Datum) !Datum {
			if len(f.Args) != 2 { fail "wrong number of arguments to {f.Name}" }
			if f.Strict && (IsNull(a) || IsNull(b)) { return Null() }
			let aa = try bindArgument(a, Oid(f.Args[0]))
			let bb = try bindArgument(b, Oid(f.Args[1]))
			return try f.Call2(aa, bb)
		},
		Call3: fn(a Datum, b Datum, c Datum) !Datum {
			if len(f.Args) != 3 { fail "wrong number of arguments to {f.Name}" }
			if f.Strict && (IsNull(a) || IsNull(b) || IsNull(c)) { return Null() }
			let aa = try bindArgument(a, Oid(f.Args[0]))
			let bb = try bindArgument(b, Oid(f.Args[1]))
			let cc = try bindArgument(c, Oid(f.Args[2]))
			return try f.Call3(aa, bb, cc)
		},
		Int4Binary: f.Int4Binary, Int8Binary: f.Int8Binary, Float8Binary: f.Float8Binary,
		Int4Compare: f.Int4Compare, Int8Compare: f.Int8Compare, Float8Compare: f.Float8Compare, TextCompare: f.TextCompare,
	}
}

fn bindArgument(arg Datum, target Oid) !Datum {
	if IsNull(arg) || arg.Oid() == target { return arg }
	if arg.Oid() == UnknownLiteralOid { return try Parse(target, arg.Text()) }
	return try Cast(arg, target)
}

fn isInteger(oid Oid) bool {
	return oid == Int2Oid || oid == Int4Oid || oid == Int8Oid || oid == OidOid
}

fn isFloat(oid Oid) bool { return oid == Float4Oid || oid == Float8Oid }

fn isNumericType(oid Oid) bool { return isInteger(oid) || isFloat(oid) || oid == NumericOid }

fn isStringType(oid Oid) bool { return oid == TextOid || oid == VarcharOid || oid == BpcharOid || oid == NameOid }

fn typeCategory(oid Oid) i64 {
	if oid == BoolOid { return 1 }
	if isNumericType(oid) { return 2 }
	if isStringType(oid) || oid == ByteaOid || oid == UuidOid { return 3 }
	if oid == DateOid || oid == TimeOid || oid == TimestampOid || oid == TimestamptzOid || oid == IntervalOid { return 4 }
	return 0
}

fn preferredType(category i64) Oid {
	if category == 1 { return BoolOid }
	if category == 2 { return Float8Oid }
	if category == 3 { return TextOid }
	if category == 4 { return TimestampOid }
	return 0
}

fn resolveCandidate(f Func, argOids []Oid) (bool, i64, i64) {
	if len(f.Args) != len(argOids) { return false, 0, 0 }
	mut cost = 0
	mut exact = 0
	for i, actual in argOids {
		let formal = Oid(f.Args[i])
		if actual == formal {
			exact += 1
		} else if actual == UnknownLiteralOid {
			cost += 2
		} else if canImplicitFunctionCast(actual, formal) {
			cost += implicitFunctionCastCost(actual, formal)
		} else {
			return false, 0, 0
		}
	}
	return true, cost, exact
}

fn chooseUnknowns(f Func, argOids []Oid) bool {
	for i, actual in argOids {
		if actual == UnknownLiteralOid {
			if Oid(f.Args[i]) == UnknownLiteralOid { continue }
			let category = typeCategory(Oid(f.Args[i]))
			if category == 0 { return false }
			let preferred = preferredType(category)
			if preferred != 0 && preferred != Oid(f.Args[i]) { return false }
		}
	}
	return true
}

fn unknownPreferredCount(f Func, argOids []Oid, category i64) i64 {
	if category <= 0 { return 0 }
	let preferred = preferredType(category)
	if preferred == 0 { return 0 }
	mut count = i64(0)
	for i, actual in argOids {
		if actual == UnknownLiteralOid && Oid(f.Args[i]) == preferred { count += 1 }
	}
	return count
}

fn resolveUnknownCategory(name str, funcs []Func, argOids []Oid) i64 {
	if !anyUnknown(argOids) { return 0 }
	mut category = i64(0)
	for candidate in funcs {
		if candidate.Name != name || len(candidate.Args) != len(argOids) { continue }
		let (ok, _, _) = resolveCandidate(candidate, argOids)
		if !ok { continue }
		for i, actual in argOids {
			if actual != UnknownLiteralOid { continue }
			let current = typeCategory(Oid(candidate.Args[i]))
			if current == 3 { return 3 }
			if category == 0 { category = current } else if category != current { return -1 }
		}
	}
	return category
}

fn anyUnknown(argOids []Oid) bool {
	for oid in argOids { if oid == UnknownLiteralOid { return true } }
	return false
}

fn matchesUnknownCategory(f Func, argOids []Oid, category i64) bool {
	if category <= 0 { return true }
	for i, actual in argOids {
		if actual == UnknownLiteralOid && Oid(f.Args[i]) != UnknownLiteralOid && typeCategory(Oid(f.Args[i])) != category { return false }
	}
	return true
}

fn commonType(a Oid, b Oid) Oid {
	if a == 0 { return b }
	if b == 0 { return a }
	if a == UnknownLiteralOid {
		if b == UnknownLiteralOid { return TextOid }
		return b
	}
	if b == UnknownLiteralOid { return a }
	if a == b { return a }
	if isNumericType(a) && isNumericType(b) {
		if a == NumericOid || b == NumericOid { return NumericOid }
		if a == Float8Oid || b == Float8Oid { return Float8Oid }
		if a == Float4Oid || b == Float4Oid {
			if a == Int8Oid || b == Int8Oid { return Float8Oid }
			return Float4Oid
		}
		if a == Int8Oid || b == Int8Oid { return Int8Oid }
		if a == Int4Oid || b == Int4Oid { return Int4Oid }
		return Int2Oid
	}
	if isStringType(a) && isStringType(b) { return TextOid }
	if CanCast(a, b, true) { return b }
	if CanCast(b, a, true) { return a }
	return 0
}

fn lookupSpecial(name str, argOids []Oid) ?Func {
	if (name == "coalesce" || name == "greatest" || name == "least") && len(argOids) > 0 {
		mut ret = argOids[0]
		for i in 1..len(argOids) {
			ret = commonType(ret, argOids[i])
			if ret == 0 { return nil }
		}
		let strict = name != "coalesce" && name != "greatest" && name != "least"
		return bindFunc(function(name, argOids, ret, strict, false, fn(args []Datum) !Datum { return try callSpecial(name, ret, args) }))
	}
	if name == "nullif" && len(argOids) == 2 {
		let ret = commonType(argOids[0], argOids[1])
		if ret == 0 { return nil }
		return bindFunc(function(name, []Oid{ret, ret}, ret, false, false, fn(args []Datum) !Datum { return try callSpecial(name, ret, args) }))
	}
	if name == "concat" && len(argOids) >= 0 {
		return bindFunc(function(name, argOids, TextOid, false, false, fn(args []Datum) !Datum { return try callStringSpecial(name, args) }))
	}
	if name == "concat_ws" && len(argOids) >= 1 {
		return bindFunc(function(name, argOids, TextOid, false, false, fn(args []Datum) !Datum { return try callStringSpecial(name, args) }))
	}
	if name == "format" && len(argOids) >= 1 && (isStringType(argOids[0]) || argOids[0] == UnknownLiteralOid) {
		return bindFunc(function(name, argOids, TextOid, false, false, fn(args []Datum) !Datum { return try callStringSpecial(name, args) }))
	}
	return nil
}

fn canImplicitFunctionCast(from Oid, to Oid) bool {
	if from == to { return true }
	if from == UnknownLiteralOid { return true }
	if isStringType(from) && isStringType(to) { return true }
	if isInteger(from) && isNumericType(to) {
		if from == Int2Oid { return to == Int4Oid || to == Int8Oid || to == Float4Oid || to == Float8Oid || to == NumericOid }
		if from == Int4Oid { return to == Int8Oid || to == Float4Oid || to == Float8Oid || to == NumericOid }
		return from == Int8Oid && (to == Float8Oid || to == NumericOid)
	}
	if from == Float4Oid && to == Float8Oid { return true }
	return CanCast(from, to, true) && isStringType(from) && isStringType(to)
}

fn implicitFunctionCastCost(from Oid, to Oid) i64 {
	if from == to { return 0 }
	if isInteger(from) && isInteger(to) {
		let rank = fn(oid Oid) i64 {
			if oid == Int2Oid { return 0 }
			if oid == Int4Oid { return 1 }
			if oid == Int8Oid { return 2 }
			return 3
		}
		return max(1, rank(to)-rank(from))
	}
	if isInteger(from) && isFloat(to) {
		mut base = i64(0)
		if from == Int2Oid { base = 2 } else if from == Int4Oid { base = 1 }
		mut target = i64(4)
		if to == Float4Oid { target = 3 }
		return target-base
	}
	if from == Float4Oid && to == Float8Oid { return 1 }
	if isStringType(from) && isStringType(to) {
		if to == TextOid { return 1 }
		if from == TextOid { return 3 }
		return 2
	}
	return 1
}

fn LookupFunc(name str, argOids []Oid) ?Func {
	if let f = lookupSpecial(name, argOids) { return f }
	let funcs = builtinFuncRegistry
	let unknownCategory = resolveUnknownCategory(name, funcs, argOids)
	if hasOnlyUnknowns(argOids) && unknownCategory == 2 && isOperatorName(name) {
		mut distinct = []Oid{}
		for candidate in funcs {
			if candidate.Name != name || len(candidate.Args) != len(argOids) { continue }
			let (ok, _, _) = resolveCandidate(candidate, argOids)
			if !ok { continue }
			let typ = Oid(candidate.Args[0])
			mut seen = false
			for prior in distinct { if prior == typ { seen = true } }
			if !seen { distinct = append(distinct, typ) }
		}
		if len(distinct) > 1 { return nil }
	}
	mut best ?Func = nil
	mut bestCost = i64(9223372036854775807)
	mut bestExact = -1
	mut bestPreferred = -1
	mut bestFit = -1
	mut tied = false
	for candidate in funcs {
		if candidate.Name != name { continue }
		let (ok, cost, exact) = resolveCandidate(candidate, argOids)
		if !ok { continue }
		if !matchesUnknownCategory(candidate, argOids, unknownCategory) { continue }
		let preferred = unknownPreferredCount(candidate, argOids, unknownCategory)
		let fit = preferredTypeFit(candidate, argOids)
		let better = exact > bestExact || (exact == bestExact && cost < bestCost) || (exact == bestExact && cost == bestCost && preferred > bestPreferred) || (exact == bestExact && cost == bestCost && preferred == bestPreferred && fit > bestFit)
		if better {
			best = candidate
			bestCost = cost
			bestExact = exact
			bestPreferred = preferred
			bestFit = fit
			tied = false
		} else if exact == bestExact && cost == bestCost && preferred == bestPreferred && fit == bestFit {
			tied = true
		}
	}
	if tied || best == nil { return nil }
	return bindFunc(best)
}

// preferredTypeFit counts arguments that PostgreSQL would coerce to the preferred
// type of their category, which resolves float8/numeric ties (round(5) is float8).
fn preferredTypeFit(f Func, argOids []Oid) i64 {
	mut count = i64(0)
	for i, actual in argOids {
		if actual == UnknownLiteralOid || i >= len(f.Args) { continue }
		let formal = Oid(f.Args[i])
		if formal == actual { continue }
		if formal == preferredType(typeCategory(actual)) { count += 1 }
	}
	return count
}

fn hasOnlyUnknowns(argOids []Oid) bool {
	if len(argOids) == 0 { return false }
	for oid in argOids { if oid != UnknownLiteralOid { return false } }
	return true
}

fn isOperatorName(name str) bool {
	for op in []str{"=", "<>", "<", "<=", ">", ">=", "+", "-", "*", "/", "%", "^", "&", "|", "#", "<<", ">>", "||", "LIKE", "ILIKE", "NOT LIKE", "NOT ILIKE", "~~", "~~*", "!~~", "!~~*", "SIMILAR TO", "~", "~*", "!~", "!~*", "AND", "OR", "NOT", "IS TRUE", "IS FALSE", "IS UNKNOWN", "IS NOT TRUE", "IS NOT FALSE", "IS NOT UNKNOWN", "IS DISTINCT FROM", "IS NOT DISTINCT FROM"} {
		if name == op { return true }
	}
	return false
}

fn LookupOperator(name str, left Oid, right Oid) ?Func {
	return LookupFunc(name, []Oid{left, right})
}

fn CanCompare(a Oid, b Oid) bool {
	return a == b && (isNumericType(a) || isStringType(a) || a == BoolOid || a == ByteaOid || a == UuidOid)
}

fn numericAsFloat(d Datum) f64 {
	if isInteger(d.Oid()) { return f64(d.i) }
	return d.f
}

fn numericFromFloat(oid Oid, x f64) Datum {
	if oid == Float4Oid { return FromF64(oid, f64(f32(x))) }
	return FromF64(oid, x)
}

fn numericFromInt(oid Oid, x i64) !Datum {
	if oid == Int2Oid && (x < -32768 || x > 32767) { try pgRaise("22003", "smallint out of range") }
	if oid == Int4Oid && (x < -2147483648 || x > 2147483647) { try pgRaise("22003", "integer out of range") }
	return FromI64(oid, x)
}

fn maxInt(oid Oid) i64 {
	if oid == Int2Oid { return 32767 }
	if oid == Int4Oid { return 2147483647 }
	return 9223372036854775807
}

fn minInt(oid Oid) i64 {
	if oid == Int2Oid { return -32768 }
	if oid == Int4Oid { return -2147483648 }
	return -9223372036854775807-1
}

fn checkedInteger(op str, a i64, b i64, oid Oid) !Datum {
	let value = try checkedIntegerValue(op, a, b, oid)
	return FromI64(oid, value)
}

fn checkedIntegerValue(op str, a i64, b i64, oid Oid) !i64 {
	let hi = maxInt(oid)
	let lo = minInt(oid)
	mut result = i64(0)
	if op == "+" {
		if (b > 0 && a > hi-b) || (b < 0 && a < lo-b) { try pgRaise("22003", integerRangeMessage(oid)) }
		result = a+b
	} else if op == "-" {
		if (b < 0 && a > hi+b) || (b > 0 && a < lo+b) { try pgRaise("22003", integerRangeMessage(oid)) }
		result = a-b
	} else if op == "*" {
		if a != 0 && b != 0 {
			if (a == -1 && b == lo) || (b == -1 && a == lo) || (a > 0 && b > 0 && a > hi/b) || (a > 0 && b < 0 && b < lo/a) || (a < 0 && b > 0 && a < lo/b) || (a < 0 && b < 0 && a < hi/b) { try pgRaise("22003", integerRangeMessage(oid)) }
			result = a*b
		} else { result = 0 }
	} else if op == "/" || op == "%" {
		if b == 0 { try pgRaise("22012", "division by zero") }
		if a == lo && b == -1 {
			if op == "%" { result = 0 } else { try pgRaise("22003", integerRangeMessage(oid)) }
		} else if op == "/" { result = a/b } else { result = a%b }
	} else if op == "&" { result = a & b
	} else if op == "|" { result = a | b
	} else if op == "#" { result = a ^ b
	} else if op == "<<" || op == ">>" {
		if b < 0 || b >= 64 { result = 0 } else if op == "<<" { result = a << b } else { result = a >> b }
	}
	return result
}

fn integerRangeMessage(oid Oid) str {
	if oid == Int2Oid { return "smallint out of range" }
	if oid == Int4Oid { return "integer out of range" }
	if oid == OidOid { return "value out of range for type oid" }
	return "bigint out of range"
}

fn arithmeticValues(op str, left Datum, right Datum) !Datum {
	let oid = left.Oid()
	if oid == NumericOid { return try numericArithmetic(op, left, right) }
	if isInteger(oid) {
		let value = try checkedIntegerValue(op, left.i, right.i, oid)
		return FromI64(oid, value)
	}
	let value = try arithmeticFloat(op, numericAsFloat(left), numericAsFloat(right))
	return numericFromFloat(oid, value)
}

fn numericArithmetic(op str, left Datum, right Datum) !Datum {
	if op == "+" { return try NumericAdd(left, right) }
	if op == "-" { return try NumericSub(left, right) }
	if op == "*" { return try NumericMul(left, right) }
	if op == "/" { return try NumericDiv(left, right) }
	if op == "%" { return try NumericMod(left, right) }
	fail "numeric operator {op} is not supported"
}

fn arithmeticFloat(op str, a f64, b f64) !f64 {
	if op == "/" && b == 0.0 { try pgRaise("22012", "division by zero") }
	let value = match op {
		"+" => a+b
		"-" => a-b
		"*" => a*b
		"/" => a/b
		"%" => a-b*gauge.Trunc(a/b)
		"^" => gauge.Pow(a, b)
		_ => 0.0
	}
	return value
}

fn callSpecial(name str, ret Oid, args []Datum) !Datum {
	if name == "coalesce" {
		for arg in args { if !IsNull(arg) { return try Cast(arg, ret) } }
		return Null()
	}
	if name == "nullif" {
		if IsNull(args[0]) { return Null() }
		if !IsNull(args[1]) {
			let a = try Cast(args[0], ret)
			let b = try Cast(args[1], ret)
			if Compare(a, b) == 0 { return Null() }
		}
		return try Cast(args[0], ret)
	}
	mut chosen = Null()
	for arg in args {
		if IsNull(arg) { continue }
		let v = try Cast(arg, ret)
		if IsNull(chosen) || name == "greatest" && Compare(v, chosen) > 0 || name == "least" && Compare(v, chosen) < 0 { chosen = v }
	}
	return chosen
}

// Coalesce returns the first non-NULL value after resolving the arguments to a common type.
fn Coalesce(args []Datum) !Datum {
	let ret = datumCommonType(args)
	if ret == 0 { return Null() }
	for arg in args { if !IsNull(arg) { return try Cast(arg, ret) } }
	return Null()
}

// NullIf returns NULL when its non-NULL arguments compare equal.
fn NullIf(a Datum, b Datum) !Datum {
	if IsNull(a) { return Null() }
	if IsNull(b) { return a }
	let ret = commonType(a.Oid(), b.Oid())
	if ret == 0 { fail "could not determine common type for NULLIF" }
	let left = try Cast(a, ret)
	let right = try Cast(b, ret)
	if Compare(left, right) == 0 { return Null() }
	return left
}

// Greatest returns the greatest non-NULL value or NULL when every value is NULL.
fn Greatest(args []Datum) !Datum { return try greatestLeast(args, true) }

// Least returns the least non-NULL value or NULL when every value is NULL.
fn Least(args []Datum) !Datum { return try greatestLeast(args, false) }

fn greatestLeast(args []Datum, greatest bool) !Datum {
	let ret = datumCommonType(args)
	if ret == 0 { return Null() }
	mut chosen = Null()
	for arg in args {
		if IsNull(arg) { continue }
		let value = try Cast(arg, ret)
		if IsNull(chosen) || greatest && Compare(value, chosen) > 0 || !greatest && Compare(value, chosen) < 0 { chosen = value }
	}
	return chosen
}

// CaseWhen picks thenValue only for SQL TRUE; FALSE and NULL pick elseValue.
fn CaseWhen(condition Datum, thenValue Datum, elseValue Datum) !Datum {
	if !IsNull(condition) && condition.b { return thenValue }
	return elseValue
}

// CaseSimple returns the matching branch, with NULL = NULL remaining unknown.
fn CaseSimple(test Datum, whenValue Datum, thenValue Datum, elseValue Datum) !Datum {
	if !IsNull(test) && !IsNull(whenValue) && Compare(test, whenValue) == 0 { return thenValue }
	return elseValue
}

fn datumCommonType(args []Datum) Oid {
	mut ret = Oid(0)
	for arg in args {
		if IsNull(arg) { continue }
		if arg.Oid() == UnknownLiteralOid { continue }
		ret = commonType(ret, arg.Oid())
		if ret == 0 { return 0 }
	}
	if ret == 0 { return TextOid }
	return ret
}

fn callStringSpecial(name str, args []Datum) !Datum {
	mut out = ""
	if name == "concat" {
		for arg in args { if !IsNull(arg) { out += arg.Text() } }
	} else if name == "concat_ws" {
		if IsNull(args[0]) { return Null() }
		let sep = args[0].Text()
		mut first = true
		for i in 1..len(args) {
			if IsNull(args[i]) { continue }
			if !first { out += sep }
			out += args[i].Text()
			first = false
		}
	} else {
		out = try formatString(args)
	}
	return FromStr(TextOid, out)
}

fn builtinFuncs() []Func {
	mut funcs = []Func{}
	RegisterTypeFuncs(mut funcs)
	registerBasicFuncs(mut funcs)
	registerMathFuncs(mut funcs)
	registerStringFuncs(mut funcs)
	registerByteaUuidFuncs(mut funcs)
	registerLikeFuncs(mut funcs)
	registerRegexFuncs(mut funcs)
	return funcs
}

let builtinFuncRegistry = builtinFuncs()

fn registerBasicFuncs(funcs mut []Func) {
	registerOperators(mut funcs)
	for _, oid in []Oid{BoolOid, Int2Oid, Int4Oid, Int8Oid, OidOid, Float4Oid, Float8Oid, TextOid, VarcharOid, BpcharOid, NameOid, ByteaOid, UuidOid, NumericOid, DateOid, TimeOid, TimestampOid, TimestamptzOid, IntervalOid, UnknownLiteralOid} {
		registerFunc(mut funcs, function1("pg_typeof", []Oid{oid}, TextOid, true, false, fn(p1 Datum) !Datum { return try pgTypeName(p1.Oid()) }))
	}
}

fn pgTypeName(oid Oid) !Datum {
	let name = match oid {
		BoolOid => "boolean"
		ByteaOid => "bytea"
		Int2Oid => "smallint"
		Int4Oid => "integer"
		Int8Oid => "bigint"
		OidOid => "oid"
		Float4Oid => "real"
		Float8Oid => "double precision"
		TextOid => "text"
		VarcharOid => "character varying"
		BpcharOid => "character"
		NameOid => "name"
		NumericOid => "numeric"
		DateOid => "date"
		TimeOid => "time without time zone"
		TimestampOid => "timestamp without time zone"
		TimestamptzOid => "timestamp with time zone"
		IntervalOid => "interval"
		UuidOid => "uuid"
		UnknownLiteralOid => "unknown"
		_ => "unknown"
	}
	return FromStr(TextOid, name)
}
