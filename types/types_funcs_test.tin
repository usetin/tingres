package types

import "crucible"

fn TestLookupFunctionResolution(t mut crucible.T) {
	if let f = LookupFunc("abs", []Oid{Int4Oid}) {
		crucible.Equal(mut t, "exact abs overload", f.Ret, u32(Int4Oid))
		crucible.Equal(mut t, "abs strict", f.Strict, true)
		let got = f.Call([]Datum{FromI64(Int4Oid, -19)}) catch err {
			t.Error("abs call failed: {err}")
			return
		}
		crucible.Equal(mut t, "abs value", got.Text(), "19")
	} else {
		t.Error("missing int4 abs overload")
	}

	if let f = LookupFunc("+", []Oid{Int2Oid, Int4Oid}) {
		crucible.Equal(mut t, "widened integer result", f.Ret, u32(Int4Oid))
		let got = f.Call([]Datum{FromI64(Int2Oid, 3), FromI64(Int4Oid, 7)}) catch err {
			t.Error("mixed integer operator failed: {err}")
			return
		}
		crucible.Equal(mut t, "mixed integer operator value", got.Text(), "10")
	} else {
		t.Error("missing implicit-cast integer operator")
	}
	if let f = LookupFunc("+", []Oid{Int4Oid, UnknownLiteralOid}) {
		crucible.Equal(mut t, "known integer guides unknown literal", f.Ret, u32(Int4Oid))
	} else {
		t.Error("typed integer operator rejected an unknown literal")
	}
	t.True("two unknown numeric operator inputs stay ambiguous", LookupFunc("+", []Oid{UnknownLiteralOid, UnknownLiteralOid}) == nil)

	if let f = LookupFunc("lower", []Oid{UnknownLiteralOid}) {
		crucible.Equal(mut t, "unknown literal resolves to text", f.Args[0], u32(TextOid))
		let got = f.Call([]Datum{FromStr(UnknownLiteralOid, "HELLO")}) catch err {
			t.Error("unknown string call failed: {err}")
			return
		}
		crucible.Equal(mut t, "unknown string value", got.Text(), "hello")
	} else {
		t.Error("unknown string did not resolve")
	}

	if let f = LookupOperator("=", Int4Oid, Int4Oid) {
		crucible.Equal(mut t, "operator lookup name", f.Name, "=")
		crucible.Equal(mut t, "operator lookup result", f.Ret, u32(BoolOid))
	} else {
		t.Error("operator lookup missed equality")
	}

	t.True("unknown overload is rejected", LookupFunc("does_not_exist", []Oid{}) == nil)
}

fn TestStrictNullAndBooleanTruthTables(t mut crucible.T) {
	if let f = LookupFunc("abs", []Oid{Int4Oid}) {
		let got = f.Call([]Datum{Null()}) catch err {
			t.Error("strict null call failed: {err}")
			return
		}
		t.True("strict function propagates NULL", IsNull(got))
	}

	let andFunc = LookupFunc("AND", []Oid{BoolOid, BoolOid})
	if let f = andFunc {
		let got = f.Call([]Datum{Null(), FromBool(false)}) catch err {
			t.Error("three-valued AND failed: {err}")
			return
		}
		crucible.Equal(mut t, "NULL AND FALSE", got.Text(), "false")
		let unknown = f.Call([]Datum{Null(), FromBool(true)}) catch err {
			t.Error("three-valued AND failed: {err}")
			return
		}
		t.True("NULL AND TRUE is NULL", IsNull(unknown))
	} else {
		t.Error("missing AND")
	}

	if let f = LookupFunc("IS NOT TRUE", []Oid{BoolOid}) {
		let got = f.Call([]Datum{Null()}) catch err {
			t.Error("IS NOT TRUE failed: {err}")
			return
		}
		crucible.Equal(mut t, "NULL IS NOT TRUE", got.Text(), "true")
	} else {
		t.Error("missing IS NOT TRUE")
	}

	if let f = LookupFunc("IS DISTINCT FROM", []Oid{Int4Oid, Int4Oid}) {
		let got = f.Call([]Datum{Null(), FromI64(Int4Oid, 1)}) catch err {
			t.Error("IS DISTINCT FROM failed: {err}")
			return
		}
		crucible.Equal(mut t, "NULL distinct from value", got.Text(), "true")
	} else {
		t.Error("missing IS DISTINCT FROM")
	}
}

fn TestPostgreSqlArithmeticErrors(t mut crucible.T) {
	if let f = LookupOperator("/", Int4Oid, Int4Oid) {
		let (_, err) = f.Call2(FromI64(Int4Oid, 7), FromI64(Int4Oid, 0))
		t.HasFault("integer division by zero", err)
		if err != nil {
			crucible.Equal(mut t, "division SQLSTATE", ErrorCode(err), "22012")
			crucible.Equal(mut t, "division message", ErrorMessage(err), "division by zero")
		}
	} else {
		t.Error("missing integer division")
	}
	if let f = LookupOperator("+", Int4Oid, Int4Oid) {
		let (_, err) = f.Call2(FromI64(Int4Oid, 2147483647), FromI64(Int4Oid, 1))
		t.HasFault("int4 addition overflow", err)
		if err != nil {
			crucible.Equal(mut t, "overflow SQLSTATE", ErrorCode(err), "22003")
			crucible.Equal(mut t, "overflow message", ErrorMessage(err), "integer out of range")
		}
	} else {
		t.Error("missing int4 addition")
	}
}

fn TestLikeAndRegexFunctions(t mut crucible.T) {
	let prefix = CompileLike("abc%", "\\", false, false) catch err {
		t.Error("LIKE compilation failed: {err}")
		return
	}
	t.True("precompiled LIKE prefix", prefix.Matches("abcdef"))
	t.False("precompiled LIKE prefix rejects mismatch", prefix.Matches("zabcdef"))
	let contains = CompileLike("%AbC%", "\\", true, false) catch err {
		t.Error("ILIKE compilation failed: {err}")
		return
	}
	t.True("precompiled ILIKE contains", contains.Matches("xabcY"))

	if let f = LookupOperator("~", TextOid, TextOid) {
		let got = f.Call2(FromStr(TextOid, "abbbc"), FromStr(TextOid, "^ab+c$")) catch err {
			t.Error("regular expression operator failed: {err}")
			return
		}
		crucible.Equal(mut t, "POSIX regex operator", got.Text(), "true")
	} else {
		t.Error("missing regex operator")
	}
	if let f = LookupOperator("SIMILAR TO", TextOid, TextOid) {
		let got = f.Call2(FromStr(TextOid, "abc123"), FromStr(TextOid, "abc%")) catch err {
			t.Error("SIMILAR TO failed: {err}")
			return
		}
		crucible.Equal(mut t, "SIMILAR TO wildcard", got.Text(), "true")
	} else {
		t.Error("missing SIMILAR TO")
	}
	if let f = LookupFunc("regexp_replace", []Oid{TextOid, TextOid, TextOid}) {
		let got = f.Call3(FromStr(TextOid, "a1 b2"), FromStr(TextOid, "[0-9]"), FromStr(TextOid, "X")) catch err {
			t.Error("regexp_replace failed: {err}")
			return
		}
		crucible.Equal(mut t, "regexp_replace defaults to first match", got.Text(), "aX b2")
	} else {
		t.Error("missing regexp_replace")
	}
	if let f = LookupFunc("regexp_replace", []Oid{TextOid, TextOid, TextOid, TextOid}) {
		let got = f.Call([]Datum{FromStr(TextOid, "a1 b2"), FromStr(TextOid, "[0-9]"), FromStr(TextOid, "X"), FromStr(TextOid, "g")}) catch err {
			t.Error("global regexp_replace failed: {err}")
			return
		}
		crucible.Equal(mut t, "regexp_replace global flag", got.Text(), "aX bX")
	} else {
		t.Error("missing flagged regexp_replace")
	}
	if let f = LookupOperator("~", TextOid, TextOid) {
		let (_, err) = f.Call2(FromStr(TextOid, "a1"), FromStr(TextOid, "(a)\\1"))
		t.HasFault("unsupported regex backreference", err)
		if err != nil { crucible.Equal(mut t, "unsupported regex SQLSTATE", ErrorCode(err), "0A000") }
	}
}

// TestNumericOperatorsDifferential pins PostgreSQL 17's exact numeric operator
// results (including the division result scale) and the temporal comparisons.
fn TestNumericOperatorsDifferential(t mut crucible.T) {
	goldenCheck(mut t, "1.5::numeric + 2", "3.5")
	goldenCheck(mut t, "1.5::numeric * 2", "3.0")
	goldenCheck(mut t, "1.50::numeric + 2.5", "4.00")
	goldenCheck(mut t, "7.5::numeric / 2", "3.7500000000000000")
	goldenCheck(mut t, "5.5::numeric % 2", "1.5")
	goldenCheck(mut t, "1.0::numeric / 3", "0.33333333333333333333")
	goldenCheck(mut t, "2.50::numeric % 0.7", "0.40")
	goldenCheck(mut t, "-7.5::numeric / 2", "-3.7500000000000000")
	goldenCheck(mut t, "7.5::numeric % -2", "1.5")
	goldenCheck(mut t, "0.001::numeric / 3", "0.00033333333333333333")
	goldenCheck(mut t, "0.0::numeric / 0.5", "0.0000000000000000")
	goldenCheck(mut t, "1.5::numeric % 0.4", "0.3")
	goldenCheck(mut t, "0.00000001::numeric / 3", "0.0000000033333333333333333333")
	goldenCheck(mut t, "mod(5.5::numeric, 2::numeric)", "1.5")
	goldenCheck(mut t, "div(5.5::numeric, 2::numeric)", "2")
	goldenCheck(mut t, "-5.5::numeric % 2", "-1.5")
	goldenCheck(mut t, "round(1.5::numeric)", "2")
	goldenCheck(mut t, "round(-1.5::numeric)", "-2")
	goldenCheck(mut t, "round(1.55::numeric, 1)", "1.6")
	goldenCheck(mut t, "trunc(1.99::numeric)", "1")
	goldenCheck(mut t, "trunc(2.55::numeric, 1)", "2.5")
	goldenCheck(mut t, "ceil(1.2::numeric)", "2")
	goldenCheck(mut t, "floor(-1.2::numeric)", "-2")
	goldenCheck(mut t, "sign(-3.5::numeric)", "-1")
	goldenCheck(mut t, "abs(-1.5::numeric)", "1.5")
	goldenCheck(mut t, "1.5::numeric = 1.50", "true")
	goldenCheck(mut t, "1.5::numeric < 2::numeric", "true")
	goldenCheck(mut t, "'2024-01-02'::date < '2024-01-03'::date", "true")
	goldenCheck(mut t, "'2024-01-02 10:00'::timestamp <= '2024-01-03'::timestamp", "true")
	goldenCheck(mut t, "'10:00'::time < '12:00'::time", "true")
	goldenCheck(mut t, "'1 day'::interval < '2 days'::interval", "true")
	goldenCheck(mut t, "1.5::numeric / 0", "ERROR: division by zero")
	goldenCheck(mut t, "1::int2 + 32767::int2", "ERROR: smallint out of range")
}

// TestFloatRoundingIsRint pins PostgreSQL's round(double precision) ties-to-even.
fn TestFloatRoundingIsRint(t mut crucible.T) {
	goldenCheck(mut t, "round(0.5::float8)", "0")
	goldenCheck(mut t, "round(1.5::float8)", "2")
	goldenCheck(mut t, "round(2.5::float8)", "2")
	goldenCheck(mut t, "round(3.5::float8)", "4")
	goldenCheck(mut t, "round(-1.5::float8)", "-2")
	goldenCheck(mut t, "round(-2.5::float8)", "-2")
	goldenCheck(mut t, "trunc(1.99::float8)", "1")
	goldenCheck(mut t, "trunc(-1.99::float8)", "-1")
	goldenCheck(mut t, "ceil(1.2::float8)", "2")
	goldenCheck(mut t, "floor(-1.2::float8)", "-2")
	goldenCheck(mut t, "to_hex(255)", "ff")
	goldenCheck(mut t, "to_hex(-1::int4)", "ffffffff")
	goldenCheck(mut t, "to_hex(-1::int8)", "ffffffffffffffff")
}

fn goldenCheck(t mut crucible.T, expression str, want str) {
	let got = evalGoldenExpression(expression) catch err {
		let text = "ERROR: " + ErrorMessage(err)
		if text != want { t.Error("{expression}: got {text}, want {want}") }
		return
	}
	let text = got.Text()
	if IsNull(got) {
		if "NULL" != want { t.Error("{expression}: got NULL, want {want}") }
		return
	}
	if text != want { t.Error("{expression}: got {text}, want {want}") }
}

// TestFixedArityFastPaths checks that the arity-specific entry points agree with
// the generic slice call, so exec can resolve once at plan time.
fn TestFixedArityFastPaths(t mut crucible.T) {
	if let g = LookupFunc("substr", []Oid{TextOid, Int4Oid, Int4Oid}) {
		let generic = g.Call([]Datum{FromStr(TextOid, "abcdef"), FromI64(Int4Oid, 2), FromI64(Int4Oid, 3)}) catch _ {
			t.Error("generic substr failed")
			return
		}
		let fast = g.Call3(FromStr(TextOid, "abcdef"), FromI64(Int4Oid, 2), FromI64(Int4Oid, 3)) catch _ {
			t.Error("fast substr failed")
			return
		}
		crucible.Equal(mut t, "substr Call3 matches Call", fast.Text(), generic.Text())
		crucible.Equal(mut t, "substr value", fast.Text(), "bcd")
	}
	if let g = LookupFunc("strpos", []Oid{TextOid, TextOid}) {
		let fast = g.Call2(FromStr(TextOid, "abc"), FromStr(TextOid, "b")) catch _ {
			t.Error("fast strpos failed")
			return
		}
		crucible.Equal(mut t, "strpos Call2", fast.Text(), "2")
	}
	if let g = LookupFunc("lower", []Oid{TextOid}) {
		let fast = g.Call1(FromStr(TextOid, "ABC")) catch _ {
			t.Error("fast lower failed")
			return
		}
		crucible.Equal(mut t, "lower Call1", fast.Text(), "abc")
	}
	if let g = LookupOperator("LIKE", TextOid, TextOid) {
		let fast = g.Call2(FromStr(TextOid, "abc"), FromStr(TextOid, "a%")) catch _ {
			t.Error("fast LIKE failed")
			return
		}
		crucible.Equal(mut t, "LIKE Call2", fast.Text(), "true")
	}
	if let g = LookupOperator("+", Int4Oid, Int4Oid) {
		let fast = g.Call2(FromI64(Int4Oid, 2), FromI64(Int4Oid, 3)) catch _ {
			t.Error("fast + failed")
			return
		}
		crucible.Equal(mut t, "int4 + Call2", fast.Text(), "5")
	}
}

// TestStringFunctionErrorsDifferential pins PostgreSQL 17's SQLSTATE-backed
// messages for the string and format functions.
fn TestStringFunctionErrorsDifferential(t mut crucible.T) {
	goldenCheck(mut t, "chr(0)", "ERROR: null character not permitted")
	goldenCheck(mut t, "chr(-1)", "ERROR: character number must be positive")
	goldenCheck(mut t, "chr(1114112)", "ERROR: requested character too large for encoding: 1114112")
	goldenCheck(mut t, "chr(55296)", "ERROR: requested character not valid for encoding: 55296")
	goldenCheck(mut t, "split_part('a,b', ',', 0)", "ERROR: field position must not be zero")
	goldenCheck(mut t, "decode('zz', 'hex')", `ERROR: invalid hexadecimal digit: "z"`)
	goldenCheck(mut t, "decode('!!', 'base64')", `ERROR: invalid symbol "!" found while decoding base64 sequence`)
	goldenCheck(mut t, "encode('\\x01'::bytea, 'nope')", `ERROR: unrecognized encoding: "nope"`)
	goldenCheck(mut t, "format('%s')", "ERROR: too few arguments for format()")
	goldenCheck(mut t, "format('%d', 1)", `ERROR: unrecognized format() type specifier "d"`)
	goldenCheck(mut t, "format('%')", "ERROR: unterminated format() type specifier")
	goldenCheck(mut t, "lpad('hi', 5)", "   hi")
	goldenCheck(mut t, "rpad('hi', 5)", "hi   ")
	goldenCheck(mut t, "trim('  x  ')", "x")
	goldenCheck(mut t, "left('abc', -1)", "ab")
	goldenCheck(mut t, "right('abc', -1)", "bc")
	goldenCheck(mut t, "repeat('ab', 3)", "ababab")
	goldenCheck(mut t, "substring('abcdef', 2, 3)", "bcd")
	goldenCheck(mut t, "to_hex(255)", "ff")
	goldenCheck(mut t, "quote_ident('')", `""`)
	goldenCheck(mut t, "quote_nullable(NULL)", "NULL")
	goldenCheck(mut t, "pg_typeof(NULL)", "unknown")
	goldenCheck(mut t, "pg_typeof(NULL::int4)", "integer")
	goldenCheck(mut t, "quote_ident('A')", `"A"`)
}

// TestRegexNewlineSensitivity pins PostgreSQL's default non-newline-sensitive
// matching (dot matches newline) and the 'n' option.
fn TestRegexNewlineSensitivity(t mut crucible.T) {
	let twoLines = "a\nb"
	goldenCheck(mut t, "regexp_match('a\nb', 'a.b')", "{{\"a\nb\"}}")
	goldenCheck(mut t, "regexp_match('a\nb', 'a.b', 'n')", "NULL")
	goldenCheck(mut t, "regexp_match('a\nb', '^b')", "NULL")
	goldenCheck(mut t, "regexp_match('a\nb', '^b', 'n')", `{b}`)
	goldenCheck(mut t, "regexp_match('a', 'a', 'z')", `ERROR: invalid regular expression option: "z"`)
	goldenCheck(mut t, "regexp_match('a', 'a', 'g')", `ERROR: regexp_match() does not support the "global" option`)
	goldenCheck(mut t, "regexp_split_to_array('a', 'a', 'g')", `ERROR: regexp_split_to_array() does not support the "global" option`)
	goldenCheck(mut t, "regexp_like('a', 'a', 'g')", `ERROR: regexp_like() does not support the "global" option`)
	_ = twoLines
}

// TestRegexUnsupportedOptions documents the options PostgreSQL accepts but this
// engine refuses with 0A000 (it never silently changes semantics).
fn TestRegexUnsupportedOptions(t mut crucible.T) {
	regexFault(mut t, "regexp_match('a b', 'a x b', 'x')", "0A000")
	regexFault(mut t, "regexp_match('ab', 'a(?:b)', 'e')", "0A000")
}

fn regexFault(t mut crucible.T, expression str, wantCode str) {
	let got = evalGoldenExpression(expression) catch err {
		if ErrorCode(err) != wantCode { t.Error("{expression}: got SQLSTATE {ErrorCode(err)} ({ErrorMessage(err)}), want {wantCode}") }
		return
	}
	t.Error("{expression}: got {got.Text()}, want SQLSTATE {wantCode}")
}

// TestBuiltinRegistryHasNoDuplicateSignatures guards the single registry: a
// duplicate name/argument signature makes overload resolution return nil.
fn TestBuiltinRegistryHasNoDuplicateSignatures(t mut crucible.T) {
	let funcs = builtinFuncRegistry
	for i, a in funcs {
		for j in i+1..len(funcs) {
			let b = funcs[j]
			if a.Name != b.Name || len(a.Args) != len(b.Args) { continue }
			mut same = true
			for k in 0..len(a.Args) {
				if a.Args[k] != b.Args[k] { same = false }
			}
			if same { t.Error("duplicate function signature {a.Name}/{a.Args} at {i} and {j}") }
		}
	}
}

// TestTypeRegistryIsUnified checks the numeric/temporal entries are visible
// through the one registry LookupFunc uses.
fn TestTypeRegistryIsUnified(t mut crucible.T) {
	t.True("numeric =", LookupOperator("=", NumericOid, NumericOid) != nil)
	t.True("numeric +", LookupOperator("+", NumericOid, NumericOid) != nil)
	t.True("numeric @", LookupOperator("@", NumericOid, NumericOid) == nil)
	if let f = LookupFunc("@", []Oid{NumericOid}) {
		let got = f.Call1(FromStr(NumericOid, "-1.5")) catch _ {
			t.Error("@ numeric failed")
			return
		}
		crucible.Equal(mut t, "numeric @ value", got.Text(), "1.5")
	} else {
		t.Error("numeric @ is missing")
	}
	t.True("date =", LookupOperator("=", DateOid, DateOid) != nil)
	t.True("interval <", LookupOperator("<", IntervalOid, IntervalOid) != nil)
	t.True("numeric div", LookupFunc("div", []Oid{NumericOid, NumericOid}) != nil)
	t.True("numeric log", LookupFunc("log", []Oid{NumericOid}) != nil)
	if let f = LookupFunc("div", []Oid{NumericOid, NumericOid}) {
		let got = f.Call2(FromStr(NumericOid, "5.5"), FromStr(NumericOid, "2")) catch _ {
			t.Error("numeric div failed")
			return
		}
		crucible.Equal(mut t, "numeric div value", got.Text(), "2")
	}
	if let f = LookupOperator("/", NumericOid, NumericOid) {
		let got = f.Call2(FromStr(NumericOid, "7.5"), FromStr(NumericOid, "2")) catch _ {
			t.Error("numeric / failed")
			return
		}
		crucible.Equal(mut t, "numeric / value", got.Text(), "3.7500000000000000")
	}
}
