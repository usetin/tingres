package types

import "mint"

// This file implements PostgreSQL's numeric division and modulo on the decimal
// text form of a value. types/numeric.tin's div_var/select_div_scale are not yet
// PG-compatible (a fractional numerator gives a wrong magnitude and the result
// scale is fixed at 20), so the operators / and % use the exact long division
// here until the numeric engine lands a compatible implementation.

// Decimal is a finite decimal in sign/magnitude form: Digits holds the
// significant digits without leading zeroes and Scale is how many of them lie
// after the decimal point.
type Decimal value struct {
	Negative bool
	Digits str
	Scale i64
	Zero bool
	Special bool
}

fn decimalParse(text str) Decimal {
	mut t = text
	mut negative = false
	if len(t) > 0 && (t[0] == '-' || t[0] == '+') {
		negative = t[0] == '-'
		t = t[1:]
	}
	if t == "NaN" || t == "Infinity" { return Decimal{Negative: false, Digits: "", Scale: 0, Zero: false, Special: true} }
	mut scale = i64(0)
	mut digits = ""
	mut seenDot = false
	for i in 0..len(t) {
		let c = t[i]
		if c == '.' { seenDot = true } else {
			digits += str(c)
			if seenDot { scale += 1 }
		}
	}
	digits = bigTrim(digits)
	return Decimal{Negative: negative, Digits: digits, Scale: scale, Zero: bigIsZero(digits), Special: false}
}

fn bigIsZero(s str) bool {
	for i in 0..len(s) { if s[i] != '0' { return false } }
	return true
}

fn bigTrim(s str) str {
	mut i = i64(0)
	for i < len(s) && s[i] == '0' { i += 1 }
	if i == len(s) { return "" }
	return s[i:]
}

fn bigZeros(n i64) str {
	mut out = ""
	for i in 0..n {
		out += "0"
		_ = i
	}
	return out
}

fn bigCmp(a str, b str) i64 {
	let x = bigTrim(a)
	let y = bigTrim(b)
	if len(x) < len(y) { return -1 }
	if len(x) > len(y) { return 1 }
	if x < y { return -1 }
	if x > y { return 1 }
	return 0
}

fn bigSub(a str, b str) str {
	mut i = len(a)-1
	mut j = len(b)-1
	mut borrow = i64(0)
	mut out = ""
	for i >= 0 {
		mut value = i64(a[i]-'0')-borrow
		if j >= 0 {
			value -= i64(b[j]-'0')
			j -= 1
		}
		borrow = 0
		if value < 0 {
			value += 10
			borrow = 1
		}
		out = str(u8(i64('0')+value))+out
		i -= 1
	}
	return bigTrim(out)
}

fn bigAddSmall(a str, d i64) str {
	mut i = len(a)-1
	mut carry = d
	mut out = ""
	for i >= 0 || carry > 0 {
		mut value = carry
		if i >= 0 {
			value += i64(a[i]-'0')
			i -= 1
		}
		out = str(u8(i64('0')+value%10))+out
		carry = value/10
	}
	return bigTrim(out)
}

fn bigMulSmall(a str, d i64) str {
	if d == 0 || bigIsZero(a) { return "" }
	mut i = len(a)-1
	mut carry = i64(0)
	mut out = ""
	for i >= 0 || carry > 0 {
		mut value = carry
		if i >= 0 {
			value += i64(a[i]-'0')*d
			i -= 1
		}
		out = str(u8(i64('0')+value%10))+out
		carry = value/10
	}
	return bigTrim(out)
}

fn bigDivMod(a str, b str) (str, str) {
	if bigIsZero(b) { return "", bigTrim(a) }
	mut quotient = ""
	mut remainder = ""
	for i in 0..len(a) {
		remainder = bigTrim(remainder+str(a[i]))
		mut digit = i64(0)
		for k in 1..10 {
			if bigCmp(bigMulSmall(b, k), remainder) <= 0 { digit = k } else { break }
		}
		if digit > 0 { remainder = bigSub(remainder, bigMulSmall(b, digit)) }
		quotient += str(u8(i64('0')+digit))
	}
	return bigTrim(quotient), remainder
}

// decimalText renders a sign/magnitude decimal with exactly scale fractional
// digits, padding with zeroes as PostgreSQL does.
fn decimalText(negative bool, digits str, scale i64) str {
	mut body = digits
	if bigIsZero(body) { body = "0" }
	mut padded = body
	for len(padded) <= scale { padded = "0"+padded }
	mut out = padded[:len(padded)-scale]+"."+padded[len(padded)-scale:]
	if scale == 0 {
		if bigIsZero(body) { out = "0" } else { out = body }
	}
	if negative && !bigIsZero(body) { out = "-"+out }
	return out
}

// numericDivScale is PostgreSQL's select_div_scale (numeric.c): the quotient
// keeps at least 16 significant digits and never fewer than either input's scale.
fn numericDivScale(left str, right str) i64 {
	let (weight1, first1) = decimalWeight(decimalParse(left))
	let (weight2, first2) = decimalWeight(decimalParse(right))
	mut qweight = weight1-weight2
	if first1 <= first2 { qweight -= 1 }
	mut rscale = 16-qweight*4
	rscale = max(rscale, decimalParse(left).Scale)
	rscale = max(rscale, decimalParse(right).Scale)
	rscale = max(rscale, i64(0))
	return min(rscale, i64(1000))
}

// decimalWeight returns PostgreSQL's base-10000 weight and leading digit group.
fn decimalWeight(d Decimal) (i64, i64) {
	if d.Zero || d.Special { return 0, 0 }
	let lead = i64(len(d.Digits))-1-d.Scale
	let weight = floor_div(lead, 4)
	let shift = lead-weight*4
	mut group = ""
	for i in 0..shift+1 {
		if i < len(d.Digits) { group += str(d.Digits[i]) } else { group += "0" }
	}
	let first = mint.Atoi(group) catch _ { 0 }
	return weight, first
}

// NumericDivide divides two numeric Datums with PostgreSQL's rounding and result scale.
fn NumericDivide(a Datum, b Datum) !Datum {
	let left = NumericText(a)
	let right = NumericText(b)
	let da = decimalParse(left)
	let db = decimalParse(right)
	if da.Special || db.Special || !isPlainDecimal(left) || !isPlainDecimal(right) { return try NumericDiv(a, b) }
	if db.Zero { try pgRaise("22012", "division by zero") }
	let rscale = numericDivScale(left, right)
	if da.Zero { return FromStr(NumericOid, decimalText(false, "", rscale)) }
	let scale = max(da.Scale, db.Scale)
	let numerator = da.Digits+bigZeros(scale-da.Scale)
	let denominator = db.Digits+bigZeros(scale-db.Scale)
	let padded = numerator+bigZeros(rscale)
	let (quotient, remainder) = bigDivMod(padded, denominator)
	mut rounded = quotient
	let twice = bigMulSmall(remainder, 2)
	if bigCmp(twice, denominator) >= 0 { rounded = bigAddSmall(quotient, 1) }
	return FromStr(NumericOid, decimalText(da.Negative != db.Negative, rounded, rscale))
}

// NumericModulo returns a - trunc(a/b)*b with PostgreSQL's sign and scale.
fn NumericModulo(a Datum, b Datum) !Datum {
	let left = NumericText(a)
	let right = NumericText(b)
	let da = decimalParse(left)
	let db = decimalParse(right)
	if da.Special || db.Special || !isPlainDecimal(left) || !isPlainDecimal(right) { return try NumericMod(a, b) }
	if db.Zero { try pgRaise("22012", "division by zero") }
	let scale = max(da.Scale, db.Scale)
	if da.Zero { return FromStr(NumericOid, decimalText(false, "", scale)) }
	let numerator = da.Digits+bigZeros(scale-da.Scale)
	let denominator = db.Digits+bigZeros(scale-db.Scale)
	let (quotient, remainder) = bigDivMod(numerator, denominator)
	if bigIsZero(remainder) { return FromStr(NumericOid, decimalText(false, "", scale)) }
	_ = quotient
	return FromStr(NumericOid, decimalText(da.Negative, remainder, scale))
}

fn isPlainDecimal(text str) bool {
	if text == "NaN" || text == "Infinity" || text == "-Infinity" { return false }
	return true
}
