package types

import "gauge"
import "dice"
import "mint"

const VoidOid Oid = 2278

fn registerMathFuncs(funcs mut []Func) {
	for _, oid in []Oid{Int2Oid, Int4Oid, Int8Oid, Float4Oid, Float8Oid} {
		registerFunc(mut funcs, function1("abs", []Oid{oid}, oid, true, false, fn(p1 Datum) !Datum { return try mathUnary("abs", p1) }))
	}
	registerFunc(mut funcs, function1("sign", []Oid{Float8Oid}, Float8Oid, true, false, fn(p1 Datum) !Datum { return try mathUnary("sign", p1) }))
	for _, oid in []Oid{Int2Oid, Int4Oid, Int8Oid} {
		registerFunc(mut funcs, function2("mod", []Oid{oid, oid}, oid, true, false, fn(p1 Datum, p2 Datum) !Datum { return try arithmeticValues("%", p1, p2) }))
	}
	for _, oid in []Oid{Int4Oid, Int8Oid} {
		registerFunc(mut funcs, function1("to_hex", []Oid{oid}, TextOid, true, false, fn(p1 Datum) !Datum { return try toHex(oid, p1.i) }))
	}
	registerFunc(mut funcs, function2("mod", []Oid{Float8Oid, Float8Oid}, Float8Oid, true, false, fn(p1 Datum, p2 Datum) !Datum { return try arithmeticValues("%", p1, p2) }))
	for _, name in []str{"sqrt", "cbrt", "exp", "ln", "log", "ceil", "ceiling", "floor", "round", "trunc", "sin", "cos", "tan", "asin", "acos", "atan", "sinh", "cosh", "tanh", "asinh", "acosh", "atanh", "degrees", "radians"} {
		if name == "log" { continue }
		registerFunc(mut funcs, function1(name, []Oid{Float8Oid}, Float8Oid, true, false, fn(p1 Datum) !Datum { return try mathUnary(name, p1) }))
	}
	registerFunc(mut funcs, function1("log", []Oid{Float8Oid}, Float8Oid, true, false, fn(p1 Datum) !Datum { return try mathUnary("log10", p1) }))
	registerFunc(mut funcs, function2("log", []Oid{Float8Oid, Float8Oid}, Float8Oid, true, false, fn(p1 Datum, p2 Datum) !Datum { return try mathBinary("log", p1, p2) }))
	registerFunc(mut funcs, function2("power", []Oid{Float8Oid, Float8Oid}, Float8Oid, true, false, fn(p1 Datum, p2 Datum) !Datum { return try mathBinary("power", p1, p2) }))
	registerFunc(mut funcs, function2("atan2", []Oid{Float8Oid, Float8Oid}, Float8Oid, true, false, fn(p1 Datum, p2 Datum) !Datum { return try mathBinary("atan2", p1, p2) }))
	registerFunc(mut funcs, function("pi", []Oid{}, Float8Oid, false, false, fn(args []Datum) !Datum { return try mathConstant("pi") }))
	registerFunc(mut funcs, function("random", []Oid{}, Float8Oid, false, true, fn(args []Datum) !Datum { return try mathConstant("random") }))
	registerFunc(mut funcs, function1("setseed", []Oid{Float8Oid}, VoidOid, true, true, fn(p1 Datum) !Datum { return try mathSeed(p1) }))
}

fn mathUnary(name str, arg Datum) !Datum {
	let oid = arg.Oid()
	if isInteger(oid) {
		let v = arg.i
		if name == "sign" {
			if v < 0 { return FromI64(oid, -1) }
			if v > 0 { return FromI64(oid, 1) }
			return FromI64(oid, 0)
		}
		if name == "abs" {
			if v == minInt(oid) { try pgRaise("22003", integerRangeMessage(oid)) }
			if v < 0 { return FromI64(oid, -v) }
			return arg
		}
	}
	let x = numericAsFloat(arg)
	if name == "abs" { return numericFromFloat(oid, gauge.Abs(x)) }
	if name == "sign" {
		if x < 0 { return numericFromFloat(oid, -1.0) }
		if x > 0 { return numericFromFloat(oid, 1.0) }
		return numericFromFloat(oid, x)
	}
	if name == "sqrt" && x < 0.0 { try pgRaise("2201F", "cannot take square root of a negative number") }
	if (name == "ln" || name == "log10") && x < 0.0 { try pgRaise("2201E", "cannot take logarithm of a negative number") }
	if (name == "ln" || name == "log10") && x == 0.0 { try pgRaise("2201E", "cannot take logarithm of zero") }
	let y = match name {
		"sqrt" => gauge.Sqrt(x)
		"cbrt" => gauge.Cbrt(x)
		"exp" => gauge.Exp(x)
		"ln" => gauge.Log(x)
		"log10" => gauge.Log10(x)
		"ceil", "ceiling" => gauge.Ceil(x)
		"floor" => gauge.Floor(x)
		"round" => roundEven(x)
		"trunc" => gauge.Trunc(x)
		"sin" => gauge.Sin(x)
		"cos" => gauge.Cos(x)
		"tan" => gauge.Tan(x)
		"asin" => gauge.Asin(x)
		"acos" => gauge.Acos(x)
		"atan" => gauge.Atan(x)
		"sinh" => gauge.Sinh(x)
		"cosh" => gauge.Cosh(x)
		"tanh" => gauge.Tanh(x)
		"asinh" => gauge.Asinh(x)
		"acosh" => gauge.Acosh(x)
		"atanh" => gauge.Atanh(x)
		"degrees" => x*180.0/gauge.Pi
		"radians" => x*gauge.Pi/180.0
		_ => x
	}
	return numericFromFloat(oid, y)
}

fn mathBinary(name str, left Datum, right Datum) !Datum {
	let a = numericAsFloat(left)
	let b = numericAsFloat(right)
	if name == "power" && a < 0.0 && b != gauge.Trunc(b) { try pgRaise("2201F", "a negative number raised to a non-integer power yields a complex result") }
	if name == "log" && (a <= 0.0 || b <= 0.0 || b == 1.0) { try pgRaise("2201E", "cannot take logarithm of a value less than or equal to zero") }
	mut y = gauge.Log(a)/gauge.Log(b)
	if name == "power" { y = gauge.Pow(a, b) } else if name == "atan2" { y = gauge.Atan2(a, b) }
	return FromF64(Float8Oid, y)
}

fn mathConstant(name str) !Datum {
	if name == "pi" { return FromF64(Float8Oid, gauge.Pi) }
	return FromF64(Float8Oid, dice.F64())
}

fn mathSeed(seed Datum) !Datum {
	let bits = gauge.F64bits(seed.f)
	dice.Seed(bits)
	return Null()
}

// roundEven is PostgreSQL's round(double precision): the nearest integer,
// halves to even (C rint), so round(2.5) is 2 and round(-0.5) is -0.
fn roundEven(x f64) f64 {
	let whole = gauge.Trunc(x)
	let fraction = x-whole
	if fraction > 0.5 { return whole+1.0 }
	if fraction < -0.5 { return whole-1.0 }
	if fraction == 0.5 || fraction == -0.5 {
		let half = whole/2.0
		if gauge.Trunc(half) == half { return whole }
		if fraction > 0.0 { return whole+1.0 }
		return whole-1.0
	}
	return whole
}

fn toHex(oid Oid, v i64) !Datum {
	let digits = "0123456789abcdef"
	mut x = u64(v)
	if oid == Int4Oid { x = u64(u32(v)) } else if oid == Int2Oid { x = u64(u16(v)) }
	if x == 0 { return FromStr(TextOid, "0") }
	mut out = ""
	for x > 0 {
		out = str(digits[i64(x&15)]) + out
		x >>= 4
	}
	return FromStr(TextOid, out)
}
