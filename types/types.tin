package types

import "gauge"
import "mint"
import "fault"
import "twine"
import "tide"

// Oid is PostgreSQL's stable type identifier.
type Oid = u32

const BoolOid Oid = 16
const ByteaOid Oid = 17
const Int8Oid Oid = 20
const Int2Oid Oid = 21
const Int4Oid Oid = 23
const TextOid Oid = 25
const OidOid Oid = 26
const Float4Oid Oid = 700
const Float8Oid Oid = 701
const VarcharOid Oid = 1043
const BpcharOid Oid = 1042
const NameOid Oid = 19
const DateOid Oid = 1082
const TimeOid Oid = 1083
const TimetzOid Oid = 1266
const TimestampOid Oid = 1114
const TimestamptzOid Oid = 1184
const IntervalOid Oid = 1186
const NumericOid Oid = 1700
const UuidOid Oid = 2950

// Datum is a compact tagged SQL value. Numeric and temporal values retain their canonical text.
type Datum value struct {
	oid u32
	null bool
	i i64
	f f64
	b bool
	s str
	bytes []u8
	months i64
	days i64
	offset i64
}

// Null returns an SQL NULL datum.
fn Null() Datum {
	return Datum{oid: 0, null: true, i: 0, f: 0.0, b: false, s: "", bytes: []u8{}}
}

// IsNull reports whether d is SQL NULL.
fn IsNull(d Datum) bool { return d.null }

fn FromI64(oid Oid, v i64) Datum {
	return Datum{oid: oid, null: false, i: v, f: 0.0, b: false, s: "", bytes: []u8{}}
}

fn FromF64(oid Oid, v f64) Datum {
	return Datum{oid: oid, null: false, i: 0, f: v, b: false, s: "", bytes: []u8{}}
}

fn FromBool(v bool) Datum {
	return Datum{oid: BoolOid, null: false, i: 0, f: 0.0, b: v, s: "", bytes: []u8{}}
}

fn FromStr(oid Oid, v str) Datum {
	return Datum{oid: oid, null: false, i: 0, f: 0.0, b: false, s: v, bytes: []u8{}}
}

fn FromBytes(oid Oid, v []u8) Datum {
	return Datum{oid: oid, null: false, i: 0, f: 0.0, b: false, s: "", bytes: v}
}

fn (d Datum) Oid() Oid { return d.oid }


fn append_str_bytes(out mut []u8, s str) {
	for i in 0..len(s) {
		out = append(out, s[i])
	}
}

fn append_u64(out mut []u8, u u64) {
	if u == 0 {
		out = append(out, '0')
		return
	}
	mut tmp [32]u8 = [32]u8{}
	mut pos = 31
	mut v = u
	for v > 0 {
		tmp[pos] = u8(48 + v%10)
		v = v/10
		pos -= 1
	}
	for i in (pos+1)..32 {
		out = append(out, tmp[i])
	}
}

fn append_i64(out mut []u8, v i64) {
	if v < 0 {
		out = append(out, '-')
		append_u64(mut out, u64(0-%v))
	} else {
		append_u64(mut out, u64(v))
	}
}

fn append_fast_numeric(m i64, scale i64, out mut []u8) {
	if m < 0 { out = append(out, '-') }
	let u = fast_abs_u64(m)
	if scale <= 0 {
		append_u64(mut out, u)
		return
	}
	mut tmp [32]u8 = [32]u8{}
	mut pos = 31
	mut v = u
	for v > 0 {
		tmp[pos] = u8(48 + v%10)
		v = v/10
		pos -= 1
	}
	let numDigits = 31-pos
	if numDigits == 0 {
		out = append(out, '0')
		out = append(out, '.')
		for idx in 0..scale {
			out = append(out, '0')
			_ = idx
		}
		return
	}
	if numDigits <= scale {
		out = append(out, '0')
		out = append(out, '.')
		for idx in 0..(scale-numDigits) {
			out = append(out, '0')
			_ = idx
		}
		for i in (pos+1)..32 { out = append(out, tmp[i]) }
	} else {
		let cut = numDigits-scale
		for i in (pos+1)..(pos+1+cut) { out = append(out, tmp[i]) }
		out = append(out, '.')
		for i in (pos+1+cut)..32 { out = append(out, tmp[i]) }
	}
}

fn append_two_digits(out mut []u8, v i64) {
	out = append(out, u8(48+(v/10)%10))
	out = append(out, u8(48+v%10))
}

fn append_year(out mut []u8, y i64) {
	mut v = y
	if y < 0 {
		out = append(out, '-')
		v = 0-y
	}
	if v < 10 {
		out = append(out, '0')
		out = append(out, '0')
		out = append(out, '0')
		out = append(out, u8(48+v))
	} else if v < 100 {
		out = append(out, '0')
		out = append(out, '0')
		out = append(out, u8(48+v/10))
		out = append(out, u8(48+v%10))
	} else if v < 1000 {
		out = append(out, '0')
		out = append(out, u8(48+v/100))
		out = append(out, u8(48+(v/10)%10))
		out = append(out, u8(48+v%10))
	} else if v < 10000 {
		out = append(out, u8(48+v/1000))
		out = append(out, u8(48+(v/100)%10))
		out = append(out, u8(48+(v/10)%10))
		out = append(out, u8(48+v%10))
	} else {
		append_u64(mut out, u64(v))
	}
}

fn append_date_days(days i64, out mut []u8) {
	let (year, month, day) = tide.CivilFromDays(days+pgEpochDays)
	append_year(mut out, year)
	out = append(out, '-')
	append_two_digits(mut out, month)
	out = append(out, '-')
	append_two_digits(mut out, day)
}

fn append_time_micros(value i64, withZone bool, offset i64, out mut []u8) {
	if value == microsPerDay {
		append_str_bytes(mut out, "24:00:00")
		if withZone { append_zone(offset, mut out) }
		return
	}
	let normalized = floor_mod(value, microsPerDay)
	let hour = normalized/microsPerHour
	let minute = (normalized%microsPerHour)/microsPerMinute
	let second = (normalized%microsPerMinute)/microsPerSecond
	let micro = normalized%microsPerSecond
	append_two_digits(mut out, hour)
	out = append(out, ':')
	append_two_digits(mut out, minute)
	out = append(out, ':')
	append_two_digits(mut out, second)
	if micro != 0 {
		out = append(out, '.')
		mut fracDigits [6]u8 = [6]u8{}
		mut m = micro
		for idx in 0..6 {
			let p = 5-idx
			fracDigits[p] = u8(48 + m%10)
			m = m/10
		}
		mut end = 6
		for end > 0 && fracDigits[end-1] == '0' { end -= 1 }
		for i in 0..end { out = append(out, fracDigits[i]) }
	}
	if withZone { append_zone(offset, mut out) }
}

fn append_zone(offset i64, out mut []u8) {
	mut value = offset
	if offset < 0 {
		out = append(out, '-')
		value = 0-offset
	} else {
		out = append(out, '+')
	}
	let hours = value/3600
	let minutes = (value%3600)/60
	append_two_digits(mut out, hours)
	if minutes != 0 {
		out = append(out, ':')
		append_two_digits(mut out, minutes)
	}
}

fn append_timestamp_micros(micros i64, out mut []u8) {
	let days = floor_div(micros, microsPerDay)
	let time = floor_mod(micros, microsPerDay)
	append_date_days(days, mut out)
	out = append(out, ' ')
	append_time_micros(time, false, 0, mut out)
}

// AppendText appends the exact PostgreSQL text representation of d into out,
// without intermediate str allocations for numbers, bools, and dates.
fn AppendText(d Datum, out mut []u8) {
	if isArrayOid(d.oid) {
		append_str_bytes(mut out, d.s)
		return
	}
	if d.null { return }
	match d.oid {
		BoolOid => {
			if d.b {
				append_str_bytes(mut out, "true")
			} else {
				append_str_bytes(mut out, "false")
			}
		}
		Int2Oid, Int4Oid, Int8Oid, OidOid => {
			append_i64(mut out, d.i)
		}
		Float4Oid, Float8Oid => {
			append_str_bytes(mut out, float_text(d))
		}
		NumericOid => {
			let (m, s, ok) = numeric_fast_pair(d)
			if ok {
				append_fast_numeric(m, s, mut out)
			} else {
				append_str_bytes(mut out, NumericText(d))
			}
		}
		DateOid => {
			if d.i == pgInfinity {
				append_str_bytes(mut out, "infinity")
			} else if d.i == 0-pgInfinity {
				append_str_bytes(mut out, "-infinity")
			} else {
				append_date_days(d.i, mut out)
			}
		}
		TimeOid => {
			append_time_micros(d.i, false, 0, mut out)
		}
		TimetzOid => {
			append_time_micros(d.i, true, d.offset, mut out)
		}
		TimestampOid => {
			if d.i == pgInfinity {
				append_str_bytes(mut out, "infinity")
			} else if d.i == 0-pgInfinity {
				append_str_bytes(mut out, "-infinity")
			} else {
				append_timestamp_micros(d.i, mut out)
			}
		}
		TimestamptzOid => {
			if d.i == pgInfinity {
				append_str_bytes(mut out, "infinity")
			} else if d.i == 0-pgInfinity {
				append_str_bytes(mut out, "-infinity")
			} else {
				let offset = session_offset(d.i)
				let local = d.i+offset*microsPerSecond
				append_timestamp_micros(local, mut out)
				append_zone(offset, mut out)
			}
		}
		IntervalOid => {
			append_str_bytes(mut out, IntervalText(d))
		}
		ByteaOid => {
			out = append(out, '\\')
			out = append(out, 'x')
			let h = hex(d.bytes)
			append_str_bytes(mut out, h)
		}
		BpcharOid => {
			let trimmed = twine.TrimRight(d.s, " ")
			append_str_bytes(mut out, trimmed)
		}
		_ => {
			append_str_bytes(mut out, d.s)
		}
	}
}

fn (d Datum) AppendText(out mut []u8) {
	AppendText(d, mut out)
}

fn (d Datum) Text() str {
	if isArrayOid(d.oid) { return d.s }
	if d.null { return "" }
	mut buf = make([]u8, 0, 32)
	AppendText(d, mut buf)
	return str(buf)
}

fn trim_ascii_spaces(b []u8) []u8 {
	mut start = 0
	for start < len(b) && (b[start] == 32 || b[start] == 9 || b[start] == 10 || b[start] == 13) {
		start += 1
	}
	mut end = len(b)
	for end > start && (b[end-1] == 32 || b[end-1] == 9 || b[end-1] == 10 || b[end-1] == 13) {
		end -= 1
	}
	return b[start:end]
}

// ParseIntBytes parses a decimal integer from b without allocations.
fn ParseIntBytes(b []u8, oid Oid) !i64 {
	let trimmed = trim_ascii_spaces(b)
	if len(trimmed) == 0 { fail PgFault("22P02", "invalid input syntax for type {sql_type_name(oid)}: \"{str(b)}\"") }
	mut neg = false
	mut start = 0
	if trimmed[0] == '-' {
		neg = true
		start = 1
	} else if trimmed[0] == '+' {
		start = 1
	}
	mut base = i64(10)
	if start+1 < len(trimmed) && trimmed[start] == '0' {
		let prefix = trimmed[start+1]
		if prefix == 'x' || prefix == 'X' {
			base = 16
			start += 2
		}
		if prefix == 'o' || prefix == 'O' {
			base = 8
			start += 2
		}
		if prefix == 'b' || prefix == 'B' {
			base = 2
			start += 2
		}
	}
	if start >= len(trimmed) { fail PgFault("22P02", "invalid input syntax for type {sql_type_name(oid)}: \"{str(b)}\"") }
	mut u = u64(0)
	mut haveDigit = false
	mut afterUnderscore = false
	for i in start..len(trimmed) {
		let c = trimmed[i]
		if c == '_' {
			let nextIsDigit = i+1 < len(trimmed) && int_digit_value(trimmed[i+1]) >= 0 && int_digit_value(trimmed[i+1]) < base
			let prefixSeparator = base != 10 && !haveDigit && i == start
			if afterUnderscore || !nextIsDigit || (!haveDigit && !prefixSeparator) {
				fail PgFault("22P02", "invalid input syntax for type {sql_type_name(oid)}: \"{str(b)}\"")
			}
			afterUnderscore = true
			continue
		}
		let digitValue = int_digit_value(c)
		if digitValue < 0 || digitValue >= base { fail PgFault("22P02", "invalid input syntax for type {sql_type_name(oid)}: \"{str(b)}\"") }
		let digit = u64(digitValue)
		if u > (18446744073709551615-digit)/u64(base) {
			fail PgFault("22003", "value \"" + str(b) + "\" is out of range for type " + sql_type_name(oid))
		}
		u = u*u64(base)+digit
		haveDigit = true
		afterUnderscore = false
	}
	if !haveDigit || afterUnderscore { fail PgFault("22P02", "invalid input syntax for type {sql_type_name(oid)}: \"{str(b)}\"") }
	if neg {
		if u > 9223372036854775808 { fail PgFault("22003", "value \"" + str(b) + "\" is out of range for type " + sql_type_name(oid)) }
		if u == 9223372036854775808 { return -9223372036854775808 }
		return 0-i64(u)
	}
	if u > 9223372036854775807 { fail PgFault("22003", "value \"" + str(b) + "\" is out of range for type " + sql_type_name(oid)) }
	return i64(u)
}

fn int_digit_value(c u8) i64 {
	if c >= '0' && c <= '9' { return i64(c-'0') }
	if c >= 'a' && c <= 'f' { return i64(c-'a')+10 }
	if c >= 'A' && c <= 'F' { return i64(c-'A')+10 }
	return -1
}

// ParseBoolBytes parses boolean text without allocations.
fn ParseBoolBytes(b []u8) !bool {
	let s = trim_ascii_spaces(b)
	if len(s) == 1 {
		let c = s[0]
		if c == 't' || c == 'T' || c == '1' || c == 'y' || c == 'Y' { return true }
		if c == 'f' || c == 'F' || c == '0' || c == 'n' || c == 'N' { return false }
	} else if len(s) == 2 {
		if (s[0] == 'o' || s[0] == 'O') && (s[1] == 'n' || s[1] == 'N') { return true }
		if (s[0] == 'n' || s[0] == 'N') && (s[1] == 'o' || s[1] == 'O') { return false }
	} else if len(s) == 3 {
		if (s[0] == 'y' || s[0] == 'Y') && (s[1] == 'e' || s[1] == 'E') && (s[2] == 's' || s[2] == 'S') { return true }
		if (s[0] == 'o' || s[0] == 'O') && (s[1] == 'f' || s[1] == 'F') && (s[2] == 'f' || s[2] == 'F') { return false }
	} else if len(s) == 4 {
		if (s[0] == 't' || s[0] == 'T') && (s[1] == 'r' || s[1] == 'R') && (s[2] == 'u' || s[2] == 'U') && (s[3] == 'e' || s[3] == 'E') { return true }
	} else if len(s) == 5 {
		if (s[0] == 'f' || s[0] == 'F') && (s[1] == 'a' || s[1] == 'A') && (s[2] == 'l' || s[2] == 'L') && (s[3] == 's' || s[3] == 'S') && (s[4] == 'e' || s[4] == 'E') { return false }
	}
	fail PgFault("22P02", "invalid input syntax for type boolean: \"{str(b)}\"")
}

// ParseFloatBytes parses floating-point text without allocating for standard numbers.
fn ParseFloatBytes(b []u8, oid Oid) !f64 {
	let trimmed = trim_ascii_spaces(b)
	let text = str(trimmed)
	let f = mint.ParseFloat(text) catch err {
		if fault.Is(err, mint.ErrRange) { fail PgFault("22003", "value out of range for type " + sql_type_name(oid)) }
		fail PgFault("22P02", "invalid input syntax for type {sql_type_name(oid)}: \"{str(b)}\"")
	}
	return f
}


fn set_datum(target mut Datum, src Datum) {
	target.oid = src.oid
	target.null = src.null
	target.i = src.i
	target.f = src.f
	target.b = src.b
	target.s = src.s
	target.bytes = src.bytes
	target.months = src.months
	target.days = src.days
	target.offset = src.offset
}

// ParseBytes parses a Datum directly from bytes.
fn ParseBytes(oid Oid, b []u8) !Datum {
	if isArrayOid(oid) { return FromStr(oid, str(b)) }
	match oid {
		BoolOid => {
			let v = try ParseBoolBytes(b)
			return FromBool(v)
		}
		Int2Oid => {
			let n = try ParseIntBytes(b, oid)
			if n < -32768 || n > 32767 { fail PgFault("22003", "value \"" + str(b) + "\" is out of range for type smallint") }
			return FromI64(Int2Oid, n)
		}
		Int4Oid => {
			let n = try ParseIntBytes(b, oid)
			if n < -2147483648 || n > 2147483647 { fail PgFault("22003", "value \"" + str(b) + "\" is out of range for type integer") }
			return FromI64(Int4Oid, n)
		}
		Int8Oid => {
			let n = try ParseIntBytes(b, oid)
			return FromI64(Int8Oid, n)
		}
		OidOid => {
			let n = try ParseIntBytes(b, oid)
			if n < 0 || u64(n) > 4294967295 { fail PgFault("22003", "value \"" + str(b) + "\" is out of range for type oid") }
			return FromI64(OidOid, n)
		}
		Float4Oid => {
			let f = try ParseFloatBytes(b, oid)
			return FromF64(Float4Oid, f64(f32(f)))
		}
		Float8Oid => {
			let f = try ParseFloatBytes(b, oid)
			return FromF64(Float8Oid, f)
		}
		NumericOid => {
			return try ParseNumeric(str(b))
		}
		TextOid, VarcharOid, BpcharOid, NameOid, UuidOid => {
			let text = str(b)
			if oid == UuidOid && !valid_uuid(text) { fail PgFault("22P02", "invalid input syntax for type uuid: \"" + text + "\"") }
			return FromStr(oid, text)
		}
		DateOid, TimeOid, TimetzOid, TimestampOid, TimestamptzOid, IntervalOid => {
			return try ParseDateTime(oid, str(b))
		}
		ByteaOid => {
			let text = str(b)
			let parsed = parse_bytea(text) catch err { fail PgFault("22P02", ErrorMessage(err)) }
			return FromBytes(oid, parsed)
		}
		_ => { fail PgFault("0A000", "unsupported input type OID " + mint.Itoa(i64(oid))) }
	}
}

// ParseBytesInto parses b directly into out.
fn ParseBytesInto(oid Oid, b []u8, out mut Datum) ! {
	let d = try ParseBytes(oid, b)
	set_datum(mut out, d)
}

// ParseStrInto parses text into out.
fn ParseStrInto(oid Oid, text str, out mut Datum) ! {
	let d = try ParseBytes(oid, []u8(text))
	set_datum(mut out, d)
}

fn Parse(oid Oid, text str) !Datum {
	if isArrayOid(oid) { return FromStr(oid, text) }
	return try ParseBytes(oid, []u8(text))
}


fn input_type_name(oid Oid) str {
	if oid == TimeOid { return "time" }
	if oid == TimestampOid { return "timestamp" }
	return sql_type_name(oid)
}

fn sql_type_name(oid Oid) str {
	match oid {
		Int2Oid => { return "smallint" }
		Int4Oid => { return "integer" }
		Int8Oid => { return "bigint" }
		OidOid => { return "oid" }
		BoolOid => { return "boolean" }
		Float4Oid => { return "real" }
		Float8Oid => { return "double precision" }
		NumericOid => { return "numeric" }
		TextOid => { return "text" }
		VarcharOid => { return "character varying" }
		BpcharOid => { return "character" }
		NameOid => { return "name" }
		DateOid => { return "date" }
		TimeOid => { return "time without time zone" }
		TimetzOid => { return "time with time zone" }
		TimestampOid => { return "timestamp without time zone" }
		TimestamptzOid => { return "timestamp with time zone" }
		IntervalOid => { return "interval" }
		UuidOid => { return "uuid" }
		ByteaOid => { return "bytea" }
		_ => { return "unknown" }
	}
}

fn valid_numeric(s str) bool {
	if len(s) == 0 { return false }
	mut i = 0
	if s[0] == '-' || s[0] == '+' { i += 1 }
	mut digits = 0
	mut dot = false
	for i < len(s) {
		let c = s[i]
		if c >= '0' && c <= '9' { digits += 1 } else if c == '.' && !dot { dot = true } else if (c == 'e' || c == 'E') && digits > 0 {
			let e = s[i+1:]
			if len(e) == 0 { return false }
			let n = mint.Atoi(e) catch _ { return false }
			_ = n
			return true
		} else { return false }
		i += 1
	}
	return digits > 0
}

fn valid_uuid(s str) bool {
	if len(s) != 36 { return false }
	for i, c in s {
		if i == 8 || i == 13 || i == 18 || i == 23 { if c != '-' { return false } } else if !((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F')) { return false }
	}
	return true
}

fn Compare(a Datum, b Datum) i64 {
	if isArrayOid(a.oid) || isArrayOid(b.oid) {
		if a.s < b.s { return -1 }
		if a.s > b.s { return 1 }
		return 0
	}
	if a.null {
		if b.null { return 0 }
		return 1
	}
	if b.null { return -1 }
	if a.oid != b.oid {
		if a.oid < b.oid { return -1 }
		return 1
	}
	match a.oid {
		BoolOid => {
			if a.b == b.b { return 0 }
			if !a.b { return -1 }
			return 1
		}
		Int2Oid, Int4Oid, Int8Oid, OidOid => {
			if a.i < b.i { return -1 }
			if a.i > b.i { return 1 }
			return 0
		}
		Float4Oid, Float8Oid => {
			return compare_float(a.f, b.f)
		}
		NumericOid => { return CompareNumeric(a, b) }
		DateOid, TimeOid, TimetzOid, TimestampOid, TimestamptzOid => { return CompareDateTime(a, b) }
		IntervalOid => { return CompareInterval(a, b) }
		ByteaOid => { return compare_bytes(a.bytes, b.bytes) }
		_ => {
			if a.s < b.s { return -1 }
			if a.s > b.s { return 1 }
			return 0
		}
	}
}

fn ParseBytea(s str) !Datum {
	let b = try parse_bytea(s)
	return FromBytes(ByteaOid, b)
}

fn parse_bytea(s str) ![]u8 {
	if len(s) >= 2 && s[:2] == "\\x" {
		if (len(s)-2)%2 != 0 { fail "invalid input syntax for type bytea" }
		mut out = []u8{}
		mut i = 2
		for i < len(s) {
			let h = hexval(s[i])
			let l = hexval(s[i+1])
			if h < 0 || l < 0 { fail "invalid input syntax for type bytea" }
			out = append(out, u8(h*16+l))
			i += 2
		}
		return out
	}
	fail "unsupported bytea escape format"
}

fn hex(b []u8) str {
	let digits = "0123456789abcdef"
	mut out = []u8{}
	for c in b { out = append(out, digits[c >> 4], digits[c & 15]) }
	return str(out)
}

fn hexval(c u8) i64 {
	if c >= '0' && c <= '9' { return i64(c-'0') }
	if c >= 'a' && c <= 'f' { return i64(c-'a')+10 }
	if c >= 'A' && c <= 'F' { return i64(c-'A')+10 }
	return -1
}

fn compare_bytes(a []u8, b []u8) i64 {
	let n = min(len(a), len(b))
	for i in 0..n {
		if a[i] < b[i] { return -1 }
		if a[i] > b[i] { return 1 }
	}
	if len(a) < len(b) { return -1 }
	if len(a) > len(b) { return 1 }
	return 0
}

// EncodeBinary appends PostgreSQL's network binary representation for supported scalar types.
fn EncodeBinary(d Datum, out mut []u8) {
	if d.null { return }
	if isArrayOid(d.oid) {
		out = append(out, d.s...)
		return
	}
	match d.oid {
		BoolOid => { if d.b { out = append(out, 1) } else { out = append(out, 0) } }
		Int2Oid => { put_u16(mut out, u16(d.i)) }
		Int4Oid => { put_u32(mut out, u32(d.i)) }
		Int8Oid => { put_u64(mut out, u64(d.i)) }
		OidOid => { put_u32(mut out, u32(d.i)) }
		Float4Oid => { put_u32(mut out, gauge.F32bits(f32(d.f))) }
		Float8Oid => { put_u64(mut out, gauge.F64bits(d.f)) }
		NumericOid => { EncodeNumericBinary(d, mut out) }
		DateOid => {
			mut value = i32(d.i)
			if d.i == pgInfinity { value = 2147483647 }
			if d.i == 0-pgInfinity { value = -2147483648 }
			put_u32(mut out, u32(value))
		}
		TimeOid => { put_u64(mut out, u64(d.i)) }
		TimetzOid => {
			put_u64(mut out, u64(d.i))
			put_u32(mut out, u32(i32(0-d.offset)))
		}
		TimestampOid, TimestamptzOid => { put_u64(mut out, u64(d.i)) }
		IntervalOid => {
			put_u64(mut out, u64(d.i))
			put_u32(mut out, u32(i32(d.days)))
			put_u32(mut out, u32(i32(d.months)))
		}
		ByteaOid => { out = append(out, d.bytes...) }
		TextOid, VarcharOid, BpcharOid, NameOid => { out = append(out, d.s...) }
		_ => { }
	}
}

// DecodeBinary reads PostgreSQL's network binary representation for supported scalar types.
fn DecodeBinary(oid Oid, b []u8) !Datum {
	if isArrayOid(oid) { return FromStr(oid, str(b)) }
	match oid {
		BoolOid => {
			if len(b) != 1 || b[0] > 1 { fail PgFault("22P03", "invalid binary representation for type boolean") }
			return FromBool(b[0] == 1)
		}
		Int2Oid => {
			if len(b) != 2 { fail PgFault("22P03", "invalid binary representation for type smallint") }
			return FromI64(oid, i64(i16(read_u16(b, 0))))
		}
		Int4Oid => {
			if len(b) != 4 { fail PgFault("22P03", "invalid binary representation for type integer") }
			return FromI64(oid, i64(i32(read_u32(b, 0))))
		}
		Int8Oid => {
			if len(b) != 8 { fail PgFault("22P03", "invalid binary representation for type bigint") }
			return FromI64(oid, i64(read_u64(b, 0)))
		}
		OidOid => {
			if len(b) != 4 { fail PgFault("22P03", "invalid binary representation for type oid") }
			return FromI64(oid, i64(read_u32(b, 0)))
		}
		Float4Oid => {
			if len(b) != 4 { fail PgFault("22P03", "invalid binary representation for type real") }
			return FromF64(oid, f64(gauge.F32frombits(read_u32(b, 0))))
		}
		Float8Oid => {
			if len(b) != 8 { fail PgFault("22P03", "invalid binary representation for type double precision") }
			return FromF64(oid, gauge.F64frombits(read_u64(b, 0)))
		}
		NumericOid => { return try DecodeNumericBinary(b) }
		DateOid => {
			if len(b) != 4 { fail PgFault("22P03", "invalid binary representation for type date") }
			let value = i32(read_u32(b, 0))
			if value == 2147483647 { return FromI64(oid, pgInfinity) }
			if value == -2147483648 { return FromI64(oid, 0-pgInfinity) }
			return FromI64(oid, i64(value))
		}
		TimeOid => {
			if len(b) != 8 { fail PgFault("22P03", "invalid binary representation for type time") }
			let value = i64(read_u64(b, 0))
			if value < 0 || value > microsPerDay { fail PgFault("22P03", "invalid binary representation for type time") }
			return FromI64(oid, value)
		}
		TimetzOid => {
			if len(b) != 12 { fail PgFault("22P03", "invalid binary representation for type time with time zone") }
			let value = i64(read_u64(b, 0))
			if value < 0 || value > microsPerDay { fail PgFault("22P03", "invalid binary representation for type time with time zone") }
			return Datum{oid: oid, null: false, i: value, f: 0.0, b: false, s: "", bytes: []u8{}, months: 0, days: 0, offset: 0-i64(i32(read_u32(b, 8)))}
		}
		TimestampOid, TimestamptzOid => {
			if len(b) != 8 { fail PgFault("22P03", "invalid binary representation for type timestamp") }
			return FromI64(oid, i64(read_u64(b, 0)))
		}
		IntervalOid => {
			if len(b) != 16 { fail PgFault("22P03", "invalid binary representation for type interval") }
			return Datum{oid: oid, null: false, i: i64(read_u64(b, 0)), f: 0.0, b: false, s: "", bytes: []u8{}, months: i64(i32(read_u32(b, 12))), days: i64(i32(read_u32(b, 8))), offset: 0}
		}
		ByteaOid => { return FromBytes(oid, b) }
		TextOid, VarcharOid, BpcharOid, NameOid => { return FromStr(oid, str(b)) }
		_ => { fail PgFault("0A000", "binary receive is not implemented for type OID {oid}") }
	}
}

fn put_u16(out mut []u8, v u16) { out = append(out, u8(v >> 8), u8(v)) }
fn put_u32(out mut []u8, v u32) { out = append(out, u8(v >> 24), u8(v >> 16), u8(v >> 8), u8(v)) }
fn put_u64(out mut []u8, v u64) {
	out = append(out, u8(v >> 56), u8(v >> 48), u8(v >> 40), u8(v >> 32), u8(v >> 24), u8(v >> 16), u8(v >> 8), u8(v))
}
fn read_u16(b []u8, at i64) u16 { return u16(b[at]) << 8 | u16(b[at+1]) }
fn read_u32(b []u8, at i64) u32 { return u32(b[at]) << 24 | u32(b[at+1]) << 16 | u32(b[at+2]) << 8 | u32(b[at+3]) }
fn read_u64(b []u8, at i64) u64 { return u64(read_u32(b, at)) << 32 | u64(read_u32(b, at+4)) }

type Row = []Datum

// EncodeRow appends a stable tuple payload: u16 column count, null bitmap, then u32-length values.
fn EncodeRow(types []Oid, r Row, out mut []u8) {
	put_u16(mut out, u16(len(types)))
	let bitmapAt = len(out)
	let bitmapLen = (len(types)+7)/8
	for i in 0..bitmapLen {
		_ = i
		out = append(out, 0)
	}
	for i, oid in types {
		let d = r[i]
		if d.null {
			out[bitmapAt+i/8] |= u8(1 << (i%8))
			continue
		}
		let value = row_value(oid, d)
		put_u32(mut out, u32(len(value)))
		out = append(out, value...)
	}
}

// DecodeRow reads the tuple payload produced by EncodeRow.
fn DecodeRow(types []Oid, b []u8) !Row {
	if len(b) < 2 { fail "invalid row payload" }
	let n = i64(read_u16(b, 0))
	if n != len(types) { fail "row column count mismatch" }
	let bitmapLen = (n+7)/8
	if len(b) < 2+bitmapLen { fail "truncated row payload" }
	mut at = 2+bitmapLen
	mut row = []Datum{}
	for i, oid in types {
		if (b[2+i/8] & u8(1 << (i%8))) != 0 {
			row = append(row, Null())
			continue
		}
		if at+4 > len(b) { fail "truncated row value length" }
		let size = i64(read_u32(b, at))
		at += 4
		if size < 0 || at+size > len(b) { fail "truncated row value" }
		let d = try row_parse(oid, b[at:at+size])
		row = append(row, d)
		at += size
	}
	if at != len(b) { fail "trailing bytes in row payload" }
	return row
}

fn row_value(oid Oid, d Datum) []u8 {
	mut b = []u8{}
	if oid == d.oid { EncodeBinary(d, mut b) } else { EncodeBinary(try_cast_for_row(d, oid), mut b) }
	return b
}

fn try_cast_for_row(d Datum, oid Oid) Datum { return Cast(d, oid) catch _ { return d } }
fn row_parse(oid Oid, b []u8) !Datum {
	return try DecodeBinary(oid, b)
}

// IndexKey emits a memcmp-ordered key for primitive values.
fn IndexKey(d Datum) []u8 {
	mut out = []u8{}
	if d.null { return []u8{0xff} }
	out = append(out, 0)
	match d.oid {
		BoolOid => { if d.b { out = append(out, 1) } else { out = append(out, 0) } }
		Int2Oid => {
			let v = u16(d.i) ^ 0x8000
			put_u16(mut out, v)
		}
		Int4Oid => {
			let v = u32(d.i) ^ 0x80000000
			put_u32(mut out, v)
		}
		Int8Oid => {
			let v = u64(d.i) ^ 0x8000000000000000
			put_u64(mut out, v)
		}
		OidOid => { put_u32(mut out, u32(d.i)) }
		Float4Oid => {
			mut v = gauge.F32bits(f32(d.f))
			if d.f != d.f { put_u32(mut out, 0xffffffff) } else {
				if d.f == 0.0 { v = 0 }
				if (v & 0x80000000) != 0 { put_u32(mut out, ~v) } else { put_u32(mut out, v ^ 0x80000000) }
			}
		}
		Float8Oid => {
			mut v = gauge.F64bits(d.f)
			if d.f != d.f { put_u64(mut out, 0xffffffffffffffff) } else {
				if d.f == 0.0 { v = 0 }
				if (v & 0x8000000000000000) != 0 { put_u64(mut out, ~v) } else { put_u64(mut out, v ^ 0x8000000000000000) }
			}
		}
		DateOid => {
			mut raw = i32(d.i)
			if d.i == pgInfinity { raw = 2147483647 }
			if d.i == 0-pgInfinity { raw = -2147483648 }
			let v = u32(raw) ^ 0x80000000
			put_u32(mut out, v)
		}
		TimeOid => {
			let v = u64(d.i) ^ 0x8000000000000000
			put_u64(mut out, v)
		}
		TimetzOid => {
			let micros = floor_mod(d.i-d.offset*1000000, microsPerDay)
			let v = u64(micros) ^ 0x8000000000000000
			put_u64(mut out, v)
		}
		TimestampOid, TimestamptzOid => {
			let v = u64(d.i) ^ 0x8000000000000000
			put_u64(mut out, v)
		}
		IntervalOid => { out = append(out, NumericIndexKey(interval_sort_numeric(d))...) }
		NumericOid => { out = append(out, NumericIndexKey(d)...) }
		ByteaOid => { out = append(out, d.bytes...) }
		_ => { out = append(out, d.s...) }
	}
	return out
}

// CompositeIndexKey appends type-independent component keys with an order-preserving terminator.
fn CompositeIndexKey(values []Datum) []u8 {
	mut out = []u8{}
	for value in values {
		let key = IndexKey(value)
		for byte in key {
			if byte == 0 { out = append(out, 0, 0xff) } else { out = append(out, byte) }
		}
		out = append(out, 0, 0)
	}
	return out
}
